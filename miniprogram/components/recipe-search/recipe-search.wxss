.search-section{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #f2e7dc}
.search-caption{display:block;font-size:26rpx;font-weight:400;line-height:1.5;color:#80766d}
.search-touch{display:flex;align-items:center;min-height:88rpx;max-width:100%}
.search-keyword{display:block;box-sizing:border-box;max-width:100%;padding:8rpx 14rpx;border-radius:24rpx;background:#fff5e9;color:#806f60;font-size:23rpx;font-weight:400;line-height:1.5;overflow-wrap:break-word;word-break:break-all}
