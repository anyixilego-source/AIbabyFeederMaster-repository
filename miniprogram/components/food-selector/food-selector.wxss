.mask{position:fixed;inset:0;background:rgba(35,27,23,.35);z-index:1000;display:flex;align-items:flex-end}.sheet{width:100%;height:76vh;background:#fffaf6;border-radius:32rpx 32rpx 0 0;padding:24rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));box-sizing:border-box;display:flex;flex-direction:column}.heading,.query{display:flex;align-items:center;gap:16rpx}.heading>text{font-size:32rpx;font-weight:600;flex:1;color:#2d2623}.heading button{margin:0;padding:0 16rpx;min-height:68rpx;line-height:68rpx;background:transparent;color:#b18136;font-size:26rpx}.query{margin:14rpx 0;background:#fff;border:1rpx solid #f0e3d9;border-radius:18rpx;padding:6rpx 6rpx 6rpx 16rpx}.query input{flex:1;min-width:0;height:88rpx;font-size:28rpx}.query .search-button{display:flex;align-items:center;justify-content:center;flex:none;width:auto;min-width:124rpx;height:88rpx;line-height:88rpx;padding:0 22rpx;border-radius:14rpx;background:#ffefdf;color:#9b593f;font-size:27rpx;margin:0}.message,.foot{color:#8a7d73;font-size:22rpx;line-height:1.5;padding:8rpx 0}.list{flex:1;min-height:0}.row{padding:16rpx 2rpx;border-bottom:1rpx solid #efe5dc}.name,.description,.info{display:block;overflow-wrap:anywhere}.name{font-size:28rpx;color:#2d2623;line-height:1.4}.description,.info{font-size:22rpx;color:#8a7d73;line-height:1.4;margin-top:4rpx}.info{font-size:20rpx}.by-name{display:inline-flex;align-items:center;justify-content:center;flex:none;align-self:center;width:auto;max-width:100%;margin:16rpx 0 6rpx;background:#fff0d9;color:#8c6132;border-radius:18rpx;font-size:26rpx;white-space:nowrap;line-height:88rpx;height:88rpx;padding:0 26rpx}.more{min-height:88rpx;margin:10rpx 0;line-height:88rpx;font-size:25rpx;color:#b18136;background:#fff0e7;border-radius:16rpx}button::after{border:0}

.heading{justify-content:space-between;width:100%}.heading>text{min-width:0}.heading button{flex:none;width:auto;min-width:80rpx;height:76rpx;min-height:76rpx;line-height:76rpx;margin:0 0 0 auto;padding:0 4rpx;display:flex;align-items:center;justify-content:flex-end;box-sizing:border-box}
