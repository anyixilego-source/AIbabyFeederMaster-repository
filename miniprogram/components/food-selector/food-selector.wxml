<view wx:if="{{visible}}" class="mask" catchtap="close"><view class="sheet" catchtap="noop"><view class="heading"><text>选择食品</text><button bindtap="close">关闭</button></view><view class="query"><input value="{{query}}" placeholder="输入食品名称，核对生熟和形态" bindinput="input" bindconfirm="submit"/><button class="search-button" bindtap="submit">搜索</button></view><text wx:if="{{loading || message}}" class="message">{{loading?'正在查询…':message}}</text><view wx:if="{{aiCandidate}}" class="row" style="background:#f2ebfa" bindtap="chooseAi"><text class="name">{{aiCandidate.name}}</text><text class="description" style="color:#7350a1">AI估算参考 · 相容缓存优先</text></view><scroll-view class="list" scroll-y bindscrolltolower="more"><view wx:for="{{items}}" wx:key="foodId" class="row" bindtap="choose" data-id="{{item.foodId}}"><text class="name">{{item.profile.displayName||item.canonicalNameZh}}</text><text wx:if="{{item.description}}" class="description">{{item.description}}</text><text wx:if="{{item.profile.displayName && item.profile.displayName!==item.canonicalNameZh}}" class="description">{{item.canonicalNameZh}}</text><text wx:if="{{item.infoText}}" class="info">{{item.infoText}}</text></view><button wx:if="{{hasMore}}" class="more" bindtap="more" loading="{{loading}}">加载更多</button><button wx:if="{{state==='error'}}" class="more" bindtap="submit">重试查询</button></scroll-view><button class="by-name" bindtap="byName" disabled="{{!query}}">按名称添加</button><text class="foot">未匹配项可在保存整餐时统一选择AI估算；实际吃下重量由保存时确认。</text></view></view>
