:host{display:block}.weight-mask{position:fixed;inset:0;z-index:1500;background:rgba(61,48,42,.38);display:flex;align-items:flex-end}.weight-drawer{width:100%;box-sizing:border-box;padding:32rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:40rpx 40rpx 0 0;background:#fffaf6;color:#3d302a}.weight-heading{display:flex;justify-content:space-between;align-items:center;font-size:36rpx;font-weight:600}.weight-heading button{margin:0;padding:0;width:72rpx;height:72rpx;line-height:72rpx;background:transparent;font-size:44rpx;color:#af8872}.weight-heading button::after,.weight-save::after,.weight-skip::after{border:0}.weight-note{display:block;color:#9a9085;font-size:24rpx;line-height:1.7}.weight-field{margin:28rpx 0;font-size:28rpx}.weight-field input,.weight-date{margin-top:12rpx;border:1rpx solid #eaded2;border-radius:20rpx;padding:22rpx;background:#fff;min-height:44rpx}.weight-date{display:flex;justify-content:space-between}.weight-error{display:block;color:#b05a51;font-size:26rpx;margin-top:16rpx}.weight-save,.weight-skip{margin-top:24rpx;font-size:30rpx;line-height:88rpx;border-radius:24rpx}.weight-save{background:#d49973;color:#fff}.weight-skip{margin-top:8rpx;color:#aa8170;background:transparent}
