<view wx:if="{{visible}}" class="weight-mask" bindtap="close" catchtouchmove="noop"><view class="weight-drawer" catchtap="noop"><view class="weight-heading"><text>补充体重</text><button bindtap="close" disabled="{{saving}}" aria-label="关闭">×</button></view><text class="weight-note">选填，供6～11月龄能量参考使用</text><view class="weight-field"><text>体重（公斤）</text><input value="{{weight}}" type="digit" maxlength="5" placeholder="最多1位小数" disabled="{{loading||saving||retrying}}" bindinput="inputWeight"/></view><view class="weight-field"><text>测量日期</text><picker mode="date" value="{{measuredOn}}" end="{{maxDate}}" disabled="{{loading||saving||retrying}}" bindchange="changeDate"><view class="weight-date">{{measuredOn||'请选择测量日期'}}<text>▾</text></view></picker></view><text class="weight-note">使用报告日前30日内的测量值，仅供了解。</text><text wx:if="{{error}}" class="weight-error">{{error}}</text><button class="weight-save" loading="{{saving}}" disabled="{{loading||saving}}" bindtap="saveWeight">{{retrying?'核对并重试':'保存体重'}}</button><button class="weight-skip" disabled="{{saving}}" bindtap="close">暂不填写</button></view></view>
