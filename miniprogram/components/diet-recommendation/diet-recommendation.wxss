@import "../../styles/ai-menu-tag.wxss";
.card{margin:0 0 25rpx;padding:34rpx;background:#fffefd;border:2rpx solid #f2eae3;border-radius:42rpx;color:#3d302a;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045);box-sizing:border-box}.heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:25rpx;font-size:31rpx;font-weight:600;line-height:1.4}.heading>text{min-width:0;flex:1}.ai-menu-tag{flex:none}.menu-preview{display:flex;align-items:center;gap:22rpx;min-height:150rpx}.menu-photo{flex:none;width:142rpx;height:150rpx;border-radius:32rpx;background:#fff0eb}.menu-copy{min-width:0;flex:1}.recipe-name{display:block;font-size:27rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.recipe-meta{display:block;margin:9rpx 0;color:#92847a;font-size:23rpx;line-height:1.6}.recipe-tags{display:flex;gap:12rpx;flex-wrap:wrap}.recipe-tag{padding:5rpx 12rpx;border-radius:12rpx;background:#f0f6e8;color:#809e61;font-size:19rpx;line-height:1.4;max-width:100%;overflow-wrap:anywhere}.recipe-tag.orange{background:#fff3dd;color:#c69a50}.chevron{flex:none;width:10rpx;height:10rpx;border-right:3rpx solid #c2ac98;border-top:3rpx solid #c2ac98;transform:rotate(45deg);margin-right:4rpx}.actions{border-top:2rpx solid #f1e8e0;margin-top:28rpx;padding-top:28rpx}.actions button{display:flex;align-items:center;justify-content:center;min-height:92rpx;width:100%;margin:0;padding:18rpx 24rpx;border-radius:32rpx;font-size:28rpx;font-weight:600;line-height:1.5;background:#fff0e9;color:#b37c62;box-sizing:border-box}.actions button::after{border:0}.note,.error{display:block;margin:12rpx 0 0;font-size:23rpx;line-height:1.7;color:#92847a;overflow-wrap:anywhere}.error{color:#be7b6d}
