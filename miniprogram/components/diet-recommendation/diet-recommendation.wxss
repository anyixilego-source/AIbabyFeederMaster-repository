@import "../../styles/ai-menu-tag.wxss";
.card{margin:24rpx 0;padding:32rpx;background:#fff;border:1rpx solid #f1ddd3;border-radius:32rpx;color:#332724}.heading{font-size:36rpx;font-weight:700;display:flex;justify-content:space-between;align-items:center}.tag{font-size:22rpx;font-weight:400;color:#a16b4b;background:#fff4e8;padding:6rpx 14rpx;border-radius:12rpx}.range,.note,.risk,.error{display:block;margin-top:16rpx;font-size:26rpx;line-height:1.55}.note{color:#80716b}.risk{font-size:24rpx;color:#8b766d}.error{color:#b64c48}.sample{display:flex;gap:22rpx;margin-top:16rpx;font-size:28rpx}.sample text:first-child{color:#917e71}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1;margin:0;min-height:88rpx;padding:14rpx 12rpx;line-height:1.5;font-size:28rpx;color:#a5663f;background:#fbf2e9;border-radius:18rpx}.actions button::after{border:none}
.heading{gap:16rpx;align-items:flex-start}
