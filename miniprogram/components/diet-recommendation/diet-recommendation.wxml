<view id="diet-recommendation-card" class="card"><view class="heading"><text>{{previewTitle}}</text><view class="ai-menu-tag"><view class="ai-menu-sparkle" aria-hidden="true"/><text>AI精选</text></view></view><view id="weekly-menu-preview" class="menu-preview" bindtap="openFeatured" aria-role="button" aria-label="查看饮食推荐"><image class="menu-photo" src="{{previewImage}}" data-src="{{previewImage}}" binderror="imageFailed" mode="aspectFill"/><view class="menu-copy"><block wx:if="{{featured}}"><text class="recipe-name">{{featured.name}}</text><text class="recipe-meta">{{featured.slotLabel}}{{featured.texture?' · '+featured.texture:''}}</text><view class="recipe-tags"><text wx:if="{{featured.description}}" class="recipe-tag">{{featured.description}}</text><text wx:if="{{featured.minutes}}" class="recipe-tag orange">{{featured.minutes}}分钟</text></view></block><text wx:else class="note">{{running?'菜单正在生成，可进入查看进度':'结合当前近7日已确认记录和宝宝条件，生成接下来7天的搭配参考。'}}</text></view><view class="chevron"></view></view><text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text><text wx:if="{{running && planId}}" class="note">菜单正在生成，可进入查看进度；上次菜单保留。</text><view wx:if="{{planId || !running}}" class="actions"><button id="view-diet-menu" bindtap="open">{{planId ? '查看7天菜单' : '生成7天菜单'}}</button></view></view>
