<view id="diet-recommendation-card" class="card"><view class="heading">饮食推荐<view class="ai-menu-tag"><view class="ai-menu-sparkle" aria-hidden="true"/><text>AI精选</text></view></view><text wx:if="{{range}}" class="range">{{range}} · 7天搭配</text><text class="note">{{planId ? focusText : '结合当前近7日已确认记录和宝宝条件，生成接下来7天的搭配参考。'}}</text><text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text><view wx:for="{{representatives}}" wx:key="date" class="sample"><text>{{item.date}}</text><text>{{item.name}}</text></view><text wx:if="{{running}}" class="note">菜单正在生成，可进入查看进度；上次菜单保留。</text><view wx:if="{{planId || !running}}" class="actions"><button id="view-diet-menu" bindtap="open">{{planId ? '查看7天菜单' : '生成7天菜单'}}</button></view></view>
