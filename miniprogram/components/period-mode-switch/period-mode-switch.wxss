.mode-switch{position:relative;display:flex;align-items:center;width:164rpx;height:58rpx;box-sizing:border-box;overflow:hidden;border:2rpx solid #ffe5c9;border-radius:999rpx;background:linear-gradient(135deg,#fff5e7,#fce8d6);box-shadow:inset 0 1rpx 3rpx #fff8f0}.mode-thumb{position:absolute;top:3rpx;left:3rpx;width:calc(50% - 3rpx);height:calc(100% - 6rpx);border-radius:999rpx;background:linear-gradient(135deg,#dca17a,#cb8965);transform:translateX(0);transition:transform 180ms ease-in-out;pointer-events:none}.mode-thumb.trend{transform:translateX(100%)}.mode-label{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;flex:1;width:50%;min-width:0;height:100%;margin:0;padding:0;line-height:1;font-size:22rpx;font-weight:600;color:#573522;background:transparent;white-space:nowrap;border:0;border-radius:0;transition:color 180ms ease-in-out}.mode-label.selected{color:#fff}.mode-label::after{border:0}.mode-switch.disabled{opacity:.65}

.mode-touch{display:flex;align-items:center;justify-content:center;width:164rpx;min-height:84rpx}.mode-label{pointer-events:none}

.mode-touch.prototype{width:217rpx}.prototype .mode-switch{width:217rpx;height:65rpx;border-color:#f2dac4;background:#fff7eb;box-shadow:inset 0 2rpx 6rpx rgba(225,201,171,.07)}.prototype .mode-thumb{background:#d79a73;box-shadow:0 4rpx 10rpx rgba(207,148,111,.13)}.prototype .mode-label{font-size:19rpx;font-weight:400;color:#3d302a}.prototype .mode-label.selected{color:#fff}
