<view class="mode-touch" catchtap="toggle" aria-role="button" aria-label="{{active==='DAY'?'切换到趋势':'切换到单日'}}"><view class="mode-switch {{disabled?'disabled':''}}"><view class="mode-thumb {{thumbMode==='TREND'?'trend':''}}"></view><text id="mode-day" class="mode-label {{thumbMode==='DAY'?'selected':''}}">单日</text><text id="mode-trend" class="mode-label {{thumbMode==='TREND'?'selected':''}}">趋势</text></view></view>
