<view class="mode-touch {{appearance==='prototype'?'prototype':''}}" catchtap="toggle" aria-role="button" aria-label="{{active==='DAY'?'切换到'+trendLabel:'切换到'+dayLabel}}"><view class="mode-switch {{disabled?'disabled':''}}"><view class="mode-thumb {{thumbMode==='TREND'?'trend':''}}"></view><text id="mode-day" class="mode-label {{thumbMode==='DAY'?'selected':''}}">{{dayLabel}}</text><text id="mode-trend" class="mode-label {{thumbMode==='TREND'?'selected':''}}">{{trendLabel}}</text></view></view>
