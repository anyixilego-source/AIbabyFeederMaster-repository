.ai-error{margin:20rpx 0;padding:24rpx;border:1rpx solid #efd8d1;border-radius:24rpx;background:#fff3ee;color:#82584e;box-sizing:border-box;text-align:left}.ai-error text{display:block;white-space:normal;overflow-wrap:anywhere;word-break:break-all}.ai-error-title{font-size:28rpx;font-weight:600;line-height:1.5;margin-bottom:8rpx}.ai-error-reason{font-size:25rpx;line-height:1.6}.ai-error-help{font-size:24rpx;line-height:1.6;margin-top:6rpx}.ai-error-id{font-size:21rpx;color:#9d7d73;line-height:1.6;margin-top:12rpx}.ai-error-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.ai-error-actions button{width:auto;max-width:100%;margin:0;min-height:44px;height:auto;line-height:1.4;padding:20rpx 22rpx;background:#f8e4db;color:#945f51;border-radius:32rpx;font-size:24rpx;font-weight:400;display:flex;align-items:center;justify-content:center}.ai-error-actions button:after{border:0}