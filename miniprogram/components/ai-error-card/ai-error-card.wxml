<view wx:if="{{failure.diagnosticId}}" id="ai-error-card" class="ai-error" role="alert"><text class="ai-error-title">{{failure.title}}</text><text class="ai-error-reason">{{failure.provider ? failure.provider+'：' : ''}}{{failure.meaning}}（{{failure.codeLabel}}：{{failure.code}}）</text><text class="ai-error-help">{{failure.suggestion}}</text><text wx:if="{{failure.extra}}" class="ai-error-help">{{failure.extra}}</text><text class="ai-error-id">诊断编号：{{failure.diagnosticId}}</text><view class="ai-error-actions"><button wx:if="{{retryLabel}}" bindtap="retry">{{retryLabel}}</button><button wx:if="{{manual}}" bindtap="manualEntry">手动记录</button><button bindtap="copy">复制错误信息</button></view></view>