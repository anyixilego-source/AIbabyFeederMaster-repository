.mask{position:fixed;inset:0;background:rgba(38,25,20,.35);z-index:1100;display:flex;align-items:flex-end}.sheet{box-sizing:border-box;width:100%;padding:30rpx 24rpx calc(26rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#fffcf9;color:#332724}.heading,.month-nav{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.heading{font-size:30rpx;font-weight:600}.heading .close{margin:0;font-size:25rpx;min-height:58rpx;line-height:58rpx;color:#817570;background:transparent}.month-nav{margin:20rpx 0;font-size:30rpx}.month-nav button{margin:0;width:80rpx;height:74rpx;line-height:74rpx;padding:0;background:#fff3ed;color:#be655d;font-size:36rpx}.grid{display:flex;flex-wrap:wrap}.week,.day{box-sizing:border-box;flex:0 0 14.2857%;width:14.2857%;min-width:0;text-align:center}.week{text-align:center;font-size:24rpx;color:#8e817a;padding:10rpx 0}.day{width:14.2857%;margin:0;padding:0;height:76rpx;line-height:76rpx;font-size:28rpx;border-radius:16rpx;background:transparent;color:#332724}.day.disabled{background:transparent;color:#c8bfba}.day.selected{background:#ff777d;color:#fff}.day.today:not(.selected){color:#d55f62;box-shadow:inset 0 0 0 1rpx #efb3aa}.today-button{margin:24rpx 0 0;min-height:58rpx;line-height:58rpx;font-size:25rpx;background:#fff0e8;color:#a6534c}button::after{border:0}
