<view wx:if="{{visible}}" class="mask" catchtap="close" catchtouchmove="noop"><view class="sheet" catchtap="noop"><view class="heading"><text>{{title}}</text><button class="close" bindtap="close">取消</button></view><view class="month-nav"><button bindtap="previous" aria-label="上个月">‹</button><picker mode="date" fields="month" start="1900-01-01" end="{{maxDate}}" value="{{month}}" bindchange="changeMonth"><text>{{monthLabel}} ▾</text></picker><button bindtap="next" disabled="{{nextDisabled}}" aria-label="下个月">›</button></view><view class="grid"><text class="week" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text><button wx:for="{{cells}}" wx:key="key" class="day {{item.selected?'selected':''}} {{item.today?'today':''}} {{item.disabled?'disabled':''}}" disabled="{{item.disabled}}" data-date="{{item.date}}" bindtap="choose">{{item.day}}</button></view><button class="today-button" bindtap="today">回到今天</button></view></view>
