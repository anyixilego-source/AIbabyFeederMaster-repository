page {
  --color-primary: #ff6f70;
  --color-primary-dark: #d95455;
  --color-primary-soft: #fff0ed;
  --color-success: #69bd55;
  --color-success-soft: #eef8e8;
  --color-warning: #f6a623;
  --color-warning-soft: #fff4dc;
  --color-danger: #ff6565;
  --color-text: #2d2623;
  --color-text-secondary: #81736d;
  --color-text-tertiary: #aaa09b;
  --color-surface: #fff;
  --color-background: #fffaf7;
  min-height: 100%;
  color: var(--color-text);
  background: radial-gradient(circle at 92% 3%, #fff0eb 0, #fffaf7 27%, #fffdfb 62%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
}
view, text, image, button, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; line-height: inherit; background: transparent; }
button::after { border: 0; }
.page-shell { min-height: 100vh; padding: 8rpx 32rpx calc(154rpx + env(safe-area-inset-bottom)); }
.page-shell.no-tabs { padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); }
.ui-card { border: 1rpx solid rgba(244,229,220,.72); border-radius: 28rpx; background: rgba(255,255,255,.94); box-shadow: 0 12rpx 32rpx rgba(136,89,65,.08); }
.section-title { font-size: 30rpx; font-weight: 700; }
.muted { color: var(--color-text-secondary); }
.primary-button { height: 88rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 30rpx; font-weight: 600; background: linear-gradient(105deg,#ff8785,#ff6267); box-shadow: 0 12rpx 28rpx rgba(255,102,105,.24); }
.secondary-button { height: 88rpx; border: 2rpx solid #ff8686; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; color: var(--color-primary); font-size: 28rpx; font-weight: 600; background: #fff; }
.chevron { width: 16rpx; height: 16rpx; border-top: 4rpx solid currentColor; border-right: 4rpx solid currentColor; transform: rotate(45deg); }
.back-icon { width: 22rpx; height: 22rpx; border-left: 5rpx solid currentColor; border-bottom: 5rpx solid currentColor; transform: rotate(45deg); }
.camera-icon { position: relative; width: 44rpx; height: 32rpx; border: 6rpx solid currentColor; border-radius: 8rpx; }
.camera-icon::before { content: ''; position: absolute; width: 16rpx; height: 16rpx; left: 8rpx; top: 2rpx; border: 5rpx solid currentColor; border-radius: 50%; }
.camera-icon::after { content: ''; position: absolute; width: 18rpx; height: 8rpx; left: 6rpx; top: -12rpx; border-radius: 5rpx 5rpx 0 0; background: currentColor; }
.check-icon { width: 28rpx; height: 16rpx; border-left: 5rpx solid currentColor; border-bottom: 5rpx solid currentColor; transform: rotate(-45deg); }
.progress-ring { --progress: 80%; --ring-color: var(--color-success); width: 76rpx; height: 76rpx; padding: 9rpx; border-radius: 50%; background: conic-gradient(var(--ring-color) var(--progress), #e9f3e5 0); }
.progress-ring::after { content: ''; display: block; width: 100%; height: 100%; border-radius: 50%; background: #fff; }
.status-pill { min-width: 64rpx; padding: 4rpx 12rpx; border-radius: 999rpx; text-align: center; color: #55a945; background: var(--color-success-soft); font-size: 21rpx; }
.status-pill.warn { color: #e99217; background: var(--color-warning-soft); }
.state-panel { min-height: 300rpx; padding: 48rpx 32rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.state-panel-title { margin-top: 20rpx; font-size: 30rpx; font-weight: 700; }
.state-panel-desc { margin-top: 12rpx; color: var(--color-text-secondary); line-height: 1.6; }
.safe-fixed { padding-bottom: env(safe-area-inset-bottom); }
