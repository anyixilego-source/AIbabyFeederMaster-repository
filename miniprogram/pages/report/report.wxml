<import src="../../templates/nutrient-card.wxml"/>
<navigation-bar back="{{false}}" color="#171722" background="transparent"><view slot="left" class="nav-back" bindtap="goBack">‹</view><view slot="center" class="nav-title-wrap"><text class="nav-title">每日饮食记录解读</text><text class="nav-date">{{dateLabel}}</text></view></navigation-bar>
<view class="page-shell"><view wx:if="{{reviewLabel}}" class="review">{{reviewLabel}}</view>
 <view class="hero-card"><image class="baby-avatar" src="/assets/baby-avatar-v2.jpg" mode="aspectFill"/><view class="baby-copy"><text class="baby-name">{{babyName}}</text><text class="baby-age">{{ageText}}</text></view></view>
 <view wx:if="{{loading}}" class="update-note">{{hasResult ? '报告更新中，暂展示上次结果，尚未包含最新修改' : '正在整理记录，首次报告尚无结果'}}</view>
 <view wx:if="{{errorMessage}}" class="error-card"><text>{{errorMessage}}</text><button wx:if="{{!legacyReport}}" bindtap="refreshReport">重试报告更新</button><button wx:else bindtap="viewRecords">查看已保存记录</button></view>
 <view wx:if="{{currentRecordSummary}}" class="error-card"><text>最新保存记录（尚未纳入报告）</text><text class="scope-note">{{currentRecordSummary}}</text><text class="inline-link" bindtap="viewRecords">查看本餐 ›</text></view>
 <block wx:if="{{hasResult}}"><text wx:if="{{selectedReportId && !fromPeriod}}" class="scope-note">正在查看历史修订及其保存的依据。</text>
 <view class="summary-card"><view class="section-heading"><text>记录概况</text></view><view wx:if="{{snapshotAvailable}}" class="summary-grid"><view class="summary-item"><text class="summary-value">{{mealCount}} 餐</text><text class="summary-label">已记录</text></view><view class="summary-item"><text class="summary-value">{{foodCount}} 种</text><text class="summary-label">食物</text></view><view class="summary-item"><text class="summary-value">{{totalConsumedText}} 克</text><text class="summary-label">食物重量</text></view><view class="summary-item"><text class="summary-value">{{milkLine || '—'}}</text><text class="summary-label">{{milkCount}}次奶量记录</text></view></view><text wx:else>这份旧报告未保存记录统计，不能据此显示当天餐数、食物种类或克重。已保存餐食请在记录页查看。</text><text wx:if="{{!hasRecords && snapshotAvailable && !milkCount}}" class="scope-note">这一天还没有确认记录，可以从记录一餐开始。</text><text wx:elif="{{!hasRecords && snapshotAvailable && milkCount}}" class="scope-note">已记录奶类喂养，可继续记录餐食。</text></view>
 <button class="week-link" bindtap="openOverview">查看截至本日的近7日解读 ›</button><view id="observations-card" class="nutrient-card observation-card"><block wx:if="{{showAll}}"><view class="section-heading"><text>{{allNutrients.length === 13 ? '全部13项营养素' : '营养素明细（历史范围）'}}</text><button id="back-to-observations" class="mode-back" bindtap="returnToObservations">返回营养解读</button></view><view class="nutrient-list"><view class="categories"><text wx:for="{{categories}}" wx:key="key" class="category-pill {{category===item.key?'active':''}}" data-key="{{item.key}}" bindtap="selectCategory">{{item.name}}</text></view><view class="nutrient-entry" wx:for="{{nutrients}}" wx:key="nutrientCode" data-code="{{item.nutrientCode}}" bindtap="openNutrient"><template is="nutrient-card" data="{{item}}"/></view></view><button id="back-to-observations-bottom" class="mode-back-bottom" bindtap="returnToObservations">返回营养解读</button></block><block wx:else><view class="section-heading"><text>营养记录解读</text></view><text wx:if="{{interpretationText || foodRecommendationText}}" id="daily-interpretation-summary" class="scope-note">{{interpretationText}}{{foodRecommendationText}}</text><view class="nutrient-entry" wx:for="{{observationCards}}" wx:key="id" data-code="{{item.nutrientCode}}" bindtap="openNutrient"><template is="nutrient-card" data="{{item}}"/></view><view class="report-actions observation-controls"><button id="toggle-observations" wx:if="{{observationCount > 3}}" bindtap="toggleObservations">{{showObservations ? '收起' : '全部解读'}}</button><button id="show-all-nutrients" bindtap="openAllNutrients">{{allNutrients.length === 13 ? '全部13项营养素' : '营养素明细（历史范围）'}}</button></view></block></view>
 <view wx:if="{{actionCount}}" class="nutrient-card"><view class="section-heading"><text>接下来可以做</text></view><view wx:for="{{actions}}" wx:key="id" class="content-row" bindtap="startMeal">{{item.text}}</view><button wx:if="{{actionCount > 2}}" bindtap="toggleActions">{{showActions ? '收起' : '全部行动'}}</button></view>
 <view wx:if="{{knowledgeCount}}" id="knowledge-card" class="nutrient-card" bindtap="toggleKnowledge" aria-role="button" aria-label="{{knowledge.length>1 ? (showKnowledgeSources ? '收起适龄提示' : showKnowledge ? '查看知识来源' : '展开适龄提示') : (showKnowledgeSources ? '收起知识来源' : '查看知识来源')}}"><view class="section-heading"><text>适龄饮食提示</text></view><text wx:if="{{knowledgeAgeText}}" id="knowledge-age" class="scope-note">适龄：{{knowledgeAgeText}}</text><view wx:for="{{visibleKnowledge}}" wx:key="id" class="knowledge-row"><text class="knowledge-title">{{item.title}}</text><text>{{item.text}}</text><text wx:if="{{showKnowledgeSources}}" class="evidence-note" wx:for="{{item.evidence}}" wx:for-item="evidence" wx:key="id">来源：中国居民膳食指南（2022），书内{{evidence.bookPages}}页</text></view></view>
 <view wx:if="{{hasRecords && limitCount}}" id="nutrient-limitations" class="nutrient-card" bindtap="advanceLimitations" aria-role="button" aria-label="展开或收起营养素说明"><view class="section-heading"><text>{{limitCount}}项营养素有说明或限制</text><text id="toggle-nutrient-limitations" catchtap="toggleLimitations">{{showLimitations ? '收起' : '查看'}}</text></view><text wx:if="{{showLimitations}}" wx:for="{{limitations}}" wx:key="nutrientCode" class="scope-note">{{item.text}}{{showLimitationReasons ? ' ' + item.reasonText : ''}}</text></view>
 <text class="light-update">更新于 {{generatedAt}}</text><view class="version-footer"><view class="section-heading" bindtap="toggleVersion"><text>报告说明</text><text>{{showVersion ? '收起' : '查看'}}</text></view><view wx:if="{{showVersion}}"><text class="scope-note">仅对照已记录量，不代表全天营养充足或医学判断。</text><text class="scope-note">重点范围为蛋白质、钙、铁、锌、维生素C；“均达标”仅说明这5项已记录量的参考比较，不代表整体饮食均衡。缺资料和奶量未计算不按零摄入处理。</text><text id="food-suggestion-scope" class="scope-note">AI搭配参考：食物推荐由AI生成，仅作餐食搭配参考，不提供补量或医学结论。部分项目暂不能比较时，不将缺资料当作零摄入或营养缺乏。</text><text wx:if="{{foodSuggestionNote}}" id="food-suggestion-status" class="scope-note">{{foodSuggestionNote}}</text><text wx:if="{{foodPreparationText}}" class="scope-note">{{foodPreparationText}}</text><text wx:if="{{knowledgeScope}}" class="scope-note report-knowledge-scope">{{knowledgeScope}}</text></view></view>
 </block><view class="bottom-spacer"></view>
</view><app-tabbar id="main-tabbar" active="report" showCamera="{{true}}"></app-tabbar>
