<navigation-bar back="{{false}}" color="#171722" background="transparent">
  <view slot="left" class="nav-back" bindtap="goBack">‹</view>
  <view slot="center" class="nav-title-wrap">
    <text class="nav-title">每日营养报告</text>
    <text class="nav-date">{{dateLabel}}</text>
  </view>
  <view slot="right" class="nav-action" bindtap="refreshReport">更新</view>
</navigation-bar>
<view class="page-shell">

  <view class="hero-card">
    <image class="baby-avatar" src="/assets/baby-avatar-v2.jpg" mode="aspectFill" />
    <view class="baby-copy">
      <text class="baby-name">{{babyName}}</text>
      <text class="baby-age">{{ageText}}</text>
    </view>
    <image class="encouragement-image" src="/assets/report-encouragement-v1.webp" mode="aspectFit" />
    <image class="hero-baby" src="/assets/baby-eating-centered-v3.jpg" mode="aspectFill" />
  </view>

  <view wx:if="{{errorMessage}}" class="error-card">
    <text class="error-title">报告暂不可用</text>
    <text class="error-message">{{errorMessage}}</text>
  </view>

  <view class="summary-card" bindtap="openOverview">
    <view class="section-heading">
      <text>今日记录概览</text>
      <view class="right-arrow"></view>
    </view>
    <view class="summary-grid">
      <view class="summary-item">
        <view class="summary-icon blue"><view class="sprite-icon"><image class="sprite-sheet sprite-meal" src="/assets/report-icon-sprite-v1.webp" mode="scaleToFill" /></view></view>
        <text class="summary-value">{{mealCount}} 餐</text>
        <text class="summary-label">已记录</text>
      </view>
      <view class="summary-item">
        <view class="summary-icon coral"><view class="sprite-icon"><image class="sprite-sheet sprite-food" src="/assets/report-icon-sprite-v1.webp" mode="scaleToFill" /></view></view>
        <text class="summary-value">{{foodCount}} 种</text>
        <text class="summary-label">食物</text>
      </view>
      <view class="summary-item">
        <view class="summary-icon green"><view class="sprite-icon"><image class="sprite-sheet sprite-weight" src="/assets/report-icon-sprite-v1.webp" mode="scaleToFill" /></view></view>
        <text class="summary-value">{{totalConsumedText}} 克</text>
        <text class="summary-label">已确认摄入</text>
      </view>
    </view>
    <view class="summary-note">仅统计已经记录并确认的食物，可能还有未记录的奶量或其他食物。</view>
  </view>

  <view class="nutrient-card">
    <view class="section-heading nutrient-heading">
      <text>营养摄入</text>
      <label class="sort-control">
        <text>需要留意优先</text>
        <switch checked="{{sortByImportance}}" color="#ff6d75" bindchange="toggleSort" />
      </label>
    </view>
    <view class="category-scroll">
      <view class="category-tabs">
        <button wx:for="{{categories}}" wx:key="code"
          class="category-tab {{selectedCategory === item.code ? 'active' : ''}}"
          data-code="{{item.code}}" bindtap="selectCategory">{{item.label}}</button>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-state">正在整理今天的记录…</view>
    <view wx:elif="{{nutrients.length === 0}}" class="empty-state">当前分类暂无可展示的营养数据</view>
    <view wx:else class="nutrient-list">
      <view wx:for="{{nutrients}}" wx:key="nutrientCode" class="nutrient-row"
        data-code="{{item.nutrientCode}}" bindtap="openNutrient">
        <view class="nutrient-badge {{item.statusTone}}"><view class="sprite-icon"><image class="sprite-sheet {{item.iconClass}}" src="/assets/report-icon-sprite-v1.webp" mode="scaleToFill" /></view></view>
        <view class="nutrient-main">
          <view class="nutrient-line">
            <text class="nutrient-name">{{item.name}}</text>
            <view class="nutrient-amount">
              <text class="amount-value">{{item.amountText}}</text>
              <text class="amount-unit">{{item.unitText}}</text>
            </view>
          </view>
          <text class="source-text">主要来源：{{item.sourceText}}</text>
          <view wx:if="{{item.dataNote}}" class="data-note">! {{item.dataNote}}</view>
        </view>
        <text class="row-chevron">›</text>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
<app-tabbar active="report" showCamera="{{true}}"></app-tabbar>
