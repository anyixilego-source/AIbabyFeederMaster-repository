<import src="../../templates/nutrient-special-reference.wxml"/>
<import src="../../templates/record-empty.wxml"/>
<wxs module="dailyVisual">
function progressValue(label) { label = label || ''; var gap = label.lastIndexOf(' '); return gap >= 0 && label.charAt(label.length - 1) === '%' ? label.slice(gap + 1) : ''; }
function progressCaption(label) { label = label || ''; return progressValue(label) ? label.slice(0, label.lastIndexOf(' ')) : label; }
function milkAmount(line) { return line ? line.replace('毫升', '') : '—'; }
function milkUnit(line) { return line && line.indexOf('毫升') >= 0 ? '毫升' : ''; }
function progressColor(item) {
 if (!item || !item.showProgress) return 'neutral';
 if (item.status === 'ABOVE_UPPER_LIMIT') return 'red';
 // Upper limits are not targets to fill. Keep the existing confirmed direction.
 if (item.referenceType === 'UL') return item.status === 'WITHIN_UPPER_LIMIT' ? 'green' : 'neutral';
 var percent = item.progressPercent;
 if (typeof percent !== 'number' || percent - percent !== 0 || percent < 0) return 'neutral';
 return percent < 30 ? 'red' : percent < 70 ? 'yellow' : 'green';
}
module.exports = { progressColor: progressColor, progressValue: progressValue, progressCaption: progressCaption, milkAmount: milkAmount, milkUnit: milkUnit };
</wxs>
<template name="daily-observation">
 <view class="daily-nutrient-top"><image class="daily-nutrient-icon" src="{{item.iconPath}}" mode="aspectFit"/><text class="daily-nutrient-name">{{item.name}}</text><view wx:if="{{item.amountText && !item.hideAmount}}" class="daily-nutrient-amount {{item.showProgress ? 'has-reference' : ''}}"><text>{{item.amountText}}</text><text wx:if="{{item.numericValue !== null && item.numericValue !== undefined && item.unitText}}" class="daily-nutrient-unit">{{item.unitText}}</text></view><text class="daily-nutrient-chevron">›</text></view>
 <view wx:if="{{item.showProgress}}" class="daily-nutrient-progress"><view class="daily-progress-track"><view class="daily-progress-fill {{dailyVisual.progressColor(item)}}" style="width:{{item.progressPercent}}%"></view></view><view class="daily-progress-caption"><text>{{dailyVisual.progressCaption(item.progressLabel)}}</text><text wx:if="{{dailyVisual.progressValue(item.progressLabel)}}" class="daily-progress-value">{{dailyVisual.progressValue(item.progressLabel)}}</text></view></view>
 <template is="nutrient-special-reference" data="{{special:item.specialReferenceView,compact:true}}"/><text wx:if="{{item.sourceText}}" class="daily-nutrient-source">主要来源：{{item.sourceText}}</text><text wx:if="{{item.dataNote}}" class="daily-nutrient-note">{{item.dataNote}}</text>
</template>
<navigation-bar back="{{false}}" color="#171722" background="transparent"><view slot="left" class="nav-back" bindtap="goBack">‹</view><view slot="center" class="nav-title-wrap"><text class="nav-title">每日饮食报告</text><text class="nav-date">{{dateLabel}}</text></view></navigation-bar>
<view class="page-shell"><view wx:if="{{reviewLabel}}" class="review">{{reviewLabel}}</view>
 <view id="report-baby-header" class="report-identity"><image class="report-baby-avatar" src="/assets/baby-avatar-v2.jpg" mode="aspectFill"/><view class="report-baby-copy"><text class="report-baby-name">{{babyName}}</text><text class="report-baby-age">{{ageText}}</text></view><view class="report-switch-slot"><period-mode-switch id="report-period-mode" active="DAY" day-label="每日" trend-label="近7日" disabled="{{loading}}" bindchange="changePeriodMode"/></view></view>
 <view wx:if="{{loading}}" class="update-note">{{hasResult ? '报告更新中，暂展示上次结果，尚未包含最新修改' : '正在整理记录，首次报告尚无结果'}}</view>
 <view wx:if="{{errorMessage}}" class="error-card"><text>{{errorMessage}}</text><button wx:if="{{!legacyReport}}" bindtap="refreshReport">重试报告更新</button><button wx:else bindtap="viewRecords">查看已保存记录</button></view>
 <view wx:if="{{currentRecordSummary}}" class="error-card"><text>最新保存记录（尚未纳入报告）</text><text class="scope-note">{{currentRecordSummary}}</text><text class="inline-link" bindtap="viewRecords">查看本餐 ›</text></view>
 <block wx:if="{{hasResult}}"><text wx:if="{{selectedReportId && !fromPeriod}}" class="scope-note">正在查看历史修订及其保存的依据。</text>
 <view id="daily-record-summary" class="summary-card {{emptyRecordSnapshot && !loading && !errorMessage && !currentRecordSummary ? 'empty-summary-card' : ''}}"><view class="section-heading"><text>记录概况</text><button wx:if="{{reportDate && reportDate!==today}}" id="daily-back-today" class="daily-back-today" bindtap="backToToday" disabled="{{loading}}">回到今天</button></view><view wx:if="{{snapshotAvailable && (!emptyRecordSnapshot || loading || errorMessage || currentRecordSummary)}}" class="summary-grid"><view class="summary-item"><text class="summary-value">{{mealCount}}<text class="summary-unit">餐</text></text><text class="summary-label">已记录</text></view><view class="summary-item"><text class="summary-value">{{foodCount}}<text class="summary-unit">种</text></text><text class="summary-label">食物</text></view><view class="summary-item"><text class="summary-value">{{totalConsumedText}}<text class="summary-unit">克</text></text><text class="summary-label">食物重量</text></view><view class="summary-item"><text class="summary-value">{{dailyVisual.milkAmount(milkLine)}}<text class="summary-unit">{{dailyVisual.milkUnit(milkLine)}}</text></text><text class="summary-label">{{milkCount}}次奶量记录</text></view></view><text wx:elif="{{!snapshotAvailable}}">这份旧报告未保存记录统计，不能据此显示当天餐数、食物种类或克重。已保存餐食请在记录页查看。</text><text wx:if="{{!hasRecords && snapshotAvailable && milkCount}}" class="scope-note">已记录奶类喂养，可继续记录餐食。</text><view wx:if="{{!loading && !errorMessage && emptyRecordSnapshot && !hasRecords && !milkCount && !currentRecordSummary}}" class="daily-empty-guide"><template is="record-empty"/></view></view>
 <block wx:if="{{loading || errorMessage || !emptyRecordSnapshot || hasRecords || milkCount || currentRecordSummary}}">
 <view id="observations-card" class="nutrient-card observation-card {{showAll ? 'daily-all-nutrients' : 'daily-observations'}}"><block wx:if="{{showAll}}"><view class="section-heading"><text>{{allNutrients.length === 13 ? '全部13项营养素' : '营养素明细（历史范围）'}}</text><button id="back-to-observations" class="mode-back" bindtap="returnToObservations">返回记录解读</button></view><view class="nutrient-list"><view class="categories"><text wx:for="{{categories}}" wx:key="key" class="category-pill {{category===item.key?'active':''}}" data-key="{{item.key}}" bindtap="selectCategory">{{item.name}}</text></view><view class="daily-nutrient-entry" wx:for="{{nutrients}}" wx:key="nutrientCode" data-code="{{item.nutrientCode}}" bindtap="openNutrient" aria-role="button" aria-label="{{item.name}}详情"><template is="daily-observation" data="{{item, dailyVisual}}"/></view></view><button id="back-to-observations-bottom" class="mode-back-bottom" bindtap="returnToObservations">返回记录解读</button></block><block wx:else><view class="section-heading"><text>记录解读</text></view><text wx:if="{{interpretationText || foodRecommendationText}}" id="daily-interpretation-summary" class="scope-note">{{interpretationText}}{{foodRecommendationText}}</text><view class="daily-nutrient-entry" wx:for="{{observationCards}}" wx:key="id" data-code="{{item.nutrientCode}}" bindtap="openNutrient" aria-role="button" aria-label="{{item.name}}详情"><template is="daily-observation" data="{{item, dailyVisual}}"/></view><view class="report-actions observation-controls"><button id="toggle-observations" wx:if="{{observationCount > 3}}" bindtap="toggleObservations">{{showObservations ? '收起' : '全部解读'}}</button><button id="show-all-nutrients" bindtap="openAllNutrients">{{allNutrients.length === 13 ? '全部13项营养素' : '营养素明细（历史范围）'}}</button></view></block></view>
 <view wx:if="{{actionCount}}" class="nutrient-card"><view class="section-heading"><text>接下来可以做</text></view><view wx:for="{{actions}}" wx:key="id" class="content-row" bindtap="startMeal">{{item.text}}</view><button wx:if="{{actionCount > 2}}" bindtap="toggleActions">{{showActions ? '收起' : '全部行动'}}</button></view>
 <view wx:if="{{knowledge.length}}" id="knowledge-card" class="nutrient-card daily-knowledge"><view class="section-heading"><view class="daily-knowledge-title"><view class="daily-knowledge-icon" aria-hidden="true"></view><text>适龄饮食提示</text></view><text wx:if="{{knowledgeAgeText}}" id="knowledge-age" class="daily-knowledge-age">适龄：{{knowledgeAgeText}}</text></view><knowledge-carousel id="knowledge-carousel" appearance="daily" items="{{knowledge}}"/></view>
 <view wx:if="{{hasRecords && limitCount}}" id="nutrient-limitations" class="nutrient-card daily-limitations" bindtap="advanceLimitations" aria-role="button" aria-label="展开或收起营养素说明"><view class="section-heading"><text>{{limitCount}}项营养素有说明或限制</text><text id="toggle-nutrient-limitations" catchtap="toggleLimitations">{{showLimitations ? '收起' : '查看'}}</text></view><text wx:if="{{showLimitations}}" wx:for="{{limitations}}" wx:key="nutrientCode" class="scope-note">{{item.text}}{{showLimitationReasons ? ' ' + item.reasonText : ''}}</text></view>
 </block>
 <text class="light-update">更新于 {{generatedAt}}</text><view class="version-footer"><view class="section-heading" bindtap="toggleVersion"><text>报告说明</text><text>{{showVersion ? '收起' : '查看'}}</text></view><view wx:if="{{showVersion}}"><text class="scope-note">仅对照已记录量，不代表全天营养充足或医学判断。</text><text id="daily-progress-color-scope" class="scope-note">进度条颜色按已记录量与一般参考值的比例展示：不足30%为红色，30%至不足70%为黄色，70%及以上为绿色。这是页面显示分段，不代表全天营养状况；上限参考沿用未超过／超过上限的方向，不作为需要达到的目标。</text><text class="scope-note">重点范围为蛋白质、钙、铁、锌、维生素C；“均达标”仅说明这5项已记录量的参考比较，不代表整体饮食均衡。已绑定且基准可核的奶量按资料计算；未知体积、资料缺项和未绑定部分不按零摄入处理。</text><text class="scope-note">碳水EAR为特定来源、适用月龄的背景参考，不作个人达标线。母乳成分采用核验后的参考均值，不代表本次奶液的个体实测值。叶酸DFE的首批食品采用经确认的未强化天然食物范围假设，保留原始值及派生依据；未核口径不混算。</text><text id="food-suggestion-scope" class="scope-note">AI搭配参考：食物推荐由AI生成，仅作餐食搭配参考，不提供补量或医学结论。部分项目暂不能比较时，不将缺资料当作零摄入或营养缺乏。</text><text wx:if="{{foodSuggestionNote}}" id="food-suggestion-status" class="scope-note">{{foodSuggestionNote}}</text><text wx:if="{{foodPreparationText}}" class="scope-note">{{foodPreparationText}}</text><text wx:if="{{knowledgeScope}}" class="scope-note report-knowledge-scope">{{knowledgeScope}}</text></view></view>
 </block><view class="bottom-spacer"></view>
</view><app-tabbar id="main-tabbar" active="report" showCamera="{{true}}"></app-tabbar>
