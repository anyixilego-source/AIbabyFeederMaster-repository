.nav-circle { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.share-button { height: 62rpx; padding: 0 18rpx; border-radius: 31rpx; display: flex; align-items: center; gap: 10rpx; color: #d95f5c; background: #fff; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.share-icon { position: relative; width: 27rpx; height: 25rpx; border: 4rpx solid currentColor; border-top: 0; border-radius: 3rpx; }.share-arrow { position: absolute; left: 8rpx; top: -10rpx; width: 16rpx; height: 16rpx; border-top: 4rpx solid currentColor; border-right: 4rpx solid currentColor; transform: rotate(-45deg); }
.report-scroll { height: calc(100vh - 118rpx - env(safe-area-inset-bottom)); }.report-page { padding-top: 0; }.report-meta { height: 88rpx; padding: 0 14rpx; display: flex; align-items: center; }.report-meta > image { width: 66rpx; height: 66rpx; border-radius: 50%; }.report-meta > view:nth-child(2) { margin-left: 14rpx; display: flex; flex-direction: column; color: #827973; font-size: 19rpx; }.meta-name { color: #2d2623; font-size: 27rpx; font-weight: 700; }.date-pill { min-width: 190rpx; height: 54rpx; margin-left: auto; padding: 0 15rpx; border-radius: 27rpx; display: flex; align-items: center; gap: 8rpx; color: #ff6568; background: #fff; font-size: 20rpx; }.calendar-small { width: 20rpx; height: 20rpx; border: 3rpx solid currentColor; border-radius: 3rpx; }.drop { width: 0; height: 0; border-left: 6rpx solid transparent; border-right: 6rpx solid transparent; border-top: 8rpx solid currentColor; }
.overview-card { height: 246rpx; padding: 22rpx; display: grid; grid-template-columns: 1fr 180rpx 1fr; overflow: hidden; background: linear-gradient(115deg,#fff1ee,#fffaf7); }.overview-score { display: flex; flex-direction: column; gap: 8rpx; color: #673733; font-size: 24rpx; font-weight: 700; }.big-score { margin-right: 8rpx; color: #ff696a; font-size: 62rpx; }.star-line { display: flex; gap: 8rpx; }.star-shape { width: 23rpx; height: 23rpx; background: #ffb81d; clip-path: polygon(50% 0,61% 34%,98% 35%,68% 57%,79% 93%,50% 72%,21% 93%,32% 57%,2% 35%,39% 34%); }.star-shape.off { background: #eadfd8; }.praise-pill { padding: 8rpx 12rpx; border-radius: 20rpx; color: #fff; background: #ff6f70; font-size: 17rpx; white-space: nowrap; }.overview-card > image { width: 180rpx; height: 215rpx; align-self: end; border-radius: 85rpx 85rpx 20rpx 20rpx; }.radar-panel { text-align: center; }.radar-title { display: flex; justify-content: center; align-items: center; gap: 8rpx; color: #6a443d; font-size: 21rpx; font-weight: 700; }.info-icon { width: 23rpx; height: 23rpx; border: 3rpx solid #aaa; border-radius: 50%; color: #999; font-size: 15rpx; line-height: 19rpx; }.radar { position: relative; width: 170rpx; height: 160rpx; margin: 6rpx auto 0; }.radar-grid,.radar-value { position: absolute; left: 50%; top: 50%; background: transparent; clip-path: polygon(50% 0,100% 38%,81% 100%,19% 100%,0 38%); transform: translate(-50%,-50%); }.radar-grid { border: 1rpx solid #efcfc9; background: rgba(255,255,255,.25); }.radar-grid.large { width: 120rpx; height: 105rpx; }.radar-grid.medium { width: 82rpx; height: 72rpx; }.radar-grid.small { width: 44rpx; height: 38rpx; }.radar-value { width: 93rpx; height: 83rpx; background: rgba(255,111,112,.33); }.radar-label { position: absolute; color: #6f544c; font-size: 15rpx; }.radar-label.top { left: 61rpx; top: 0; }.radar-label.right { right: 0; top: 58rpx; }.radar-label.br { right: 19rpx; bottom: 0; }.radar-label.bl { left: 8rpx; bottom: 0; }.radar-label.left { left: -2rpx; top: 57rpx; }
.intake-card { margin-top: 16rpx; padding: 20rpx 20rpx 0; }.intake-heading { display: flex; align-items: center; justify-content: space-between; }.legend { display: flex; gap: 18rpx; color: #77706b; font-size: 16rpx; }.legend text { display: flex; align-items: center; gap: 6rpx; }.dot { width: 10rpx; height: 10rpx; border-radius: 50%; display: inline-block; }.dot.good { background: #73c959; }.dot.warn { background: #f6a623; }.dot.danger { background: #ff6565; }.intake-grid { margin-top: 18rpx; display: grid; grid-template-columns: repeat(6,1fr); }.intake-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }.intake-name { height: 30rpx; font-size: 18rpx; white-space: nowrap; }.nutrient-symbol { height: 26rpx; color: #37b4cc; font-size: 17rpx; font-weight: 700; }.intake-ring { width: 74rpx; height: 74rpx; padding: 9rpx; border-radius: 50%; }.intake-ring view { width: 100%; height: 100%; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; font-size: 18rpx; font-weight: 700; }.intake-tip { min-height: 58rpx; margin: 18rpx -20rpx 0; padding: 10rpx 18rpx; display: flex; align-items: center; gap: 10rpx; color: #725f50; background: #fff8e5; font-size: 18rpx; }.intake-tip .bulb { width: 17rpx; height: 21rpx; border-radius: 50%; background: #ffc12b; }.intake-tip text { flex: 1; }.intake-tip .chevron { color: #d49a55; }
