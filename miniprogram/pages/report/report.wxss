ight: 44rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; color: #ff6f70; background: #fff1ef; font-size: 18rpx; }
.meal-strip { margin-top: 16rpx; padding: 18rpx 20rpx; }.strip-heading { display: flex; align-items: center; gap: 14rpx; }.strip-heading > view { margin-left: auto; display: flex; align-items: center; gap: 8rpx; color: #8c827d; font-size: 18rpx; }.strip-meals { margin-top: 15rpx; display: grid; grid-template-columns: repeat(4,1fr); }.strip-meals > view { display: flex; align-items: center; gap: 8rpx; font-size: 18rpx; }.meal-dot { width: 15rpx; height: 15rpx; border-radius: 50%; background: #ffc12b; }.strip-meals image { width: 55rpx; height: 48rpx; border-radius: 12rpx; }.streak-card { min-height: 92rpx; margin-top: 16rpx; padding: 12rpx 18rpx; border-radius: 26rpx; display: flex; align-items: center; background: linear-gradient(105deg,#fff1ed,#ffe7e3); }.streak-card image { width: 72rpx; height: 72rpx; border-radius: 50%; }.streak-card > view { margin-left: 14rpx; flex: 1; display: flex; flex-direction: column; gap: 5rpx; }.streak-card text:first-child { color: #743833; font-size: 20rpx; font-weight: 700; }.streak-card text:last-child { color: #89736b; font-size: 17rpx; }.streak-card button { width: 116rpx; height: 52rpx; border-radius: 26rpx; color: #fff; background: #ff6f70; font-size: 21rpx; }
