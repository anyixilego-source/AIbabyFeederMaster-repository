.nav-circle { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.album-button { min-width: 118rpx; height: 62rpx; padding: 0 18rpx; border-radius: 31rpx; display: flex; align-items: center; gap: 12rpx; background: #fff; color: #775f53; font-size: 24rpx; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.album-icon { position: relative; width: 30rpx; height: 26rpx; border: 4rpx solid currentColor; border-radius: 5rpx; overflow: hidden; }.album-icon::before { content: ''; position: absolute; right: 4rpx; top: 4rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: currentColor; }.album-mountain { position: absolute; left: 3rpx; bottom: -5rpx; width: 16rpx; height: 16rpx; border-left: 4rpx solid currentColor; border-top: 4rpx solid currentColor; transform: rotate(45deg); }
.camera-page { min-height: calc(100vh - 92rpx); padding: 12rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }.steps { height: 116rpx; display: flex; align-items: flex-start; justify-content: center; }.step { width: 126rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; color: #908983; font-size: 21rpx; white-space: nowrap; }.step.active { color: #ef6568; }.step-node { width: 54rpx; height: 54rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: #f3e8df; }.active .step-node { background: linear-gradient(135deg,#ff8b88,#ff686b); }.step-line { width: 92rpx; margin-top: 26rpx; border-top: 3rpx dashed #d5c7bc; }.step-line.active { border-color: #f4b8b4; }.mini-camera { position: relative; width: 28rpx; height: 21rpx; border-radius: 4rpx; background: currentColor; }.mini-camera::before { content: ''; position: absolute; left: 7rpx; top: -5rpx; width: 12rpx; height: 6rpx; border-radius: 3rpx 3rpx 0 0; background: currentColor; }.mini-lens { position: absolute; left: 8rpx; top: 5rpx; width: 7rpx; height: 7rpx; border: 3rpx solid #ff7474; border-radius: 50%; }.bowl { width: 30rpx; height: 15rpx; border-radius: 0 0 18rpx 18rpx; background: #79c46e; }.bowl::before { content: ''; display: block; width: 34rpx; height: 6rpx; margin-left: -2rpx; border-radius: 50%; background: #a6da94; }.result-node { background: #ffe4d0; }.doc-lines { width: 24rpx; height: 30rpx; border: 4rpx solid #f3a150; border-radius: 3rpx; }.doc-lines::before { content: ''; display: block; width: 12rpx; height: 3rpx; margin: 6rpx 4rpx 0; background: #f3a150; box-shadow: 0 7rpx 0 #f3a150; }
.tip { min-height: 86rpx; margin: 6rpx 0 20rpx; padding: 12rpx 24rpx 12rpx 14rpx; border-radius: 28rpx; display: flex; align-items: center; background: linear-gradient(100deg,#fff0ed,#fff5f1); }.tip image { width: 66rpx; height: 66rpx; border-radius: 50%; }.tip-copy { margin-left: 14rpx; flex: 1; display: flex; flex-direction: column; gap: 5rpx; color: #6f5c53; font-size: 22rpx; }.tip-title { color: #ff6f70; font-size: 26rpx; font-weight: 700; }.tip-close { width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; }.tip-close view,.tip-close view::after { width: 24rpx; height: 4rpx; border-radius: 3rpx; background: #ed7774; transform: rotate(45deg); }.tip-close view::after { content: ''; display: block; transform: rotate(90deg); }
.viewfinder { position: relative; height: min(720rpx, calc(100vh - 410rpx)); min-height: 470rpx; border-radius: 28rpx; overflow: hidden; background: #ead8c5; }.camera,.camera-fallback { width: 100%; height: 100%; }.grid { position: absolute; z-index: 2; background: rgba(255,255,255,.65); }.grid.vertical { top: 0; bottom: 0; width: 2rpx; border-left: 2rpx dashed rgba(255,255,255,.75); background: transparent; }.grid.horizontal { left: 0; right: 0; height: 2rpx; border-top: 2rpx dashed rgba(255,255,255,.75); background: transparent; }.grid.vertical.one { left: 33.33%; }.grid.vertical.two { left: 66.66%; }.grid.horizontal.one { top: 33.33%; }.grid.horizontal.two { top: 66.66%; }.corner { position: absolute; z-index: 3; width: 40rpx; height: 40rpx; border-color: #fff; border-style: solid; }.corner.tl { left: 18rpx; top: 18rpx; border-width: 6rpx 0 0 6rpx; border-radius: 14rpx 0 0; }.corner.tr { right: 18rpx; top: 18rpx; border-width: 6rpx 6rpx 0 0; border-radius: 0 14rpx 0 0; }.corner.bl { left: 18rpx; bottom: 18rpx; border-width: 0 0 6rpx 6rpx; border-radius: 0 0 0 14rpx; }.corner.br { right: 18rpx; bottom: 18rpx; border-width: 0 6rpx 6rpx 0; border-radius: 0 0 14rpx; }.frame-note { position: absolute; z-index: 3; left: 50%; bottom: 20rpx; padding: 10rpx 20rpx; border-radius: 24rpx; color: #fff; background: rgba(54,43,35,.66); font-size: 21rpx; transform: translateX(-50%); white-space: nowrap; }.permission-card { position: absolute; z-index: 4; left: 50%; top: 50%; width: 320rpx; padding: 28rpx; border-radius: 24rpx; display: flex; flex-direction: column; align-items: center; gap: 18rpx; color: #5f514a; background: rgba(255,255,255,.94); transform: translate(-50%,-50%); }.permission-card button { min-width: 150rpx; padding: 14rpx 24rpx; border-radius: 28rpx; color: #fff; background: #ff6f70; }
.camera-controls { height: 154rpx; display: flex; align-items: center; justify-content: space-around; }.side-control,.capture-wrap { width: 170rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #655a55; font-size: 21rpx; }.capture-wrap { margin-top: 18rpx; }.capture-button { width: 98rpx; height: 98rpx; border: 8rpx solid #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#ff8b88,#ff666a); box-shadow: 0 10rpx 24rpx rgba(255,102,105,.28); }.flash-icon { width: 23rpx; height: 44rpx; background: #6a5d57; clip-path: polygon(58% 0,18% 52%,50% 52%,38% 100%,84% 42%,55% 42%); }.switch-icon { position: relative; width: 48rpx; height: 42rpx; }.switch-arrow { position: absolute; width: 30rpx; height: 20rpx; border: 4rpx solid #6a5d57; }.switch-arrow.top { left: 0; top: 0; border-right: 0; border-bottom: 0; border-radius: 18rpx 0 0; }.switch-arrow.bottom { right: 0; bottom: 0; border-left: 0; border-top: 0; border-radius: 0 0 18rpx; }
.viewfinder { height: calc(100vh - 410rpx); max-height: 720rpx; }.camera-fallback { position: relative; overflow: hidden; background: #f6dfcf; }.camera-fallback image { position: absolute; left: -1250rpx; top: 0; width: auto; height: 100%; }
