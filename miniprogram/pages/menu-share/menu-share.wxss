page{background:#fffaf4;color:#3e352f}.nav-back{font-size:52rpx;padding:0 22rpx}.share-shell{padding:24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom))}.share-card{background:#fff;border:1rpx solid #ede6dc;border-radius:30rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 8rpx 28rpx rgba(87,64,41,.025)}.share-title{display:block;font-size:32rpx;font-weight:600;line-height:1.5}.muted{display:block;color:#978d82;font-size:25rpx;line-height:1.65;margin-top:12rpx}.source-note{display:block;font-size:24rpx;line-height:1.6;padding:14rpx 18rpx;margin:20rpx 0;background:#f8eee3;color:#a07654;border-radius:15rpx}.day-heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx;font-size:28rpx;font-weight:600}.day-heading .muted{margin:0;font-weight:400}.share-meal{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #f2eee8}.meal-label{display:block;font-size:24rpx;color:#b18763;margin-bottom:10rpx}.recipe-name{display:block;font-size:28rpx;line-height:1.65}.ingredients,.step{display:block;font-size:25rpx;line-height:1.7;color:#7f756b;margin:12rpx 0}.error{padding:22rpx;border-radius:18rpx;background:#fff0ed;color:#ad655b;font-size:26rpx;margin-bottom:22rpx}.primary,.secondary{margin-top:24rpx;font-size:28rpx;line-height:2.7;border-radius:22rpx}.primary{background:#d19a70;color:#fff}.secondary{background:#faf1e7;color:#9e7659}.link{width:auto;margin:0;color:#a68160;background:transparent;font-size:24rpx}.section{display:block;margin:24rpx 0 16rpx;font-size:27rpx;font-weight:600}.choices{display:flex;gap:12rpx;flex-wrap:wrap}.choices button{flex:1;white-space:nowrap;background:#fcf5ed;color:#9d8270;border-radius:18rpx;font-size:25rpx;padding:0 12rpx;line-height:2.6}.choices .active{background:#f0d6bf;color:#8a593a}textarea{box-sizing:border-box;width:100%;height:145rpx;padding:20rpx;margin-top:18rpx;border:1rpx solid #eee3d8;border-radius:18rpx;font-size:27rpx}button::after{border:none}

.share-meal.compact{display:flex;align-items:baseline;gap:16rpx;padding-top:6rpx;margin-top:12rpx;border:0}.share-meal.compact .meal-label{min-width:105rpx;margin:0}.share-meal.compact>view{flex:1;min-width:0}.share-meal.compact .recipe-name{font-size:27rpx}
