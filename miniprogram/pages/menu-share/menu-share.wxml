<navigation-bar title="分享的7天菜单" back="{{false}}" color="#3d302a" background="transparent"><view slot="left" class="nav-back" bindtap="goBack">‹</view></navigation-bar>
<view class="share-shell"><text wx:if="{{loading}}" class="muted">正在读取分享菜单…</text><view wx:if="{{errorMessage}}" class="error" role="alert">{{errorMessage}}<button wx:if="{{!source}}" bindtap="load">重新读取</button></view>
<block wx:if="{{source}}"><view class="share-card"><text class="share-title">{{source.senderName}}分享的7天菜单</text><text class="source-note">他人分享 · 非根据本宝宝饮食记录生成</text><text class="muted">{{source.startDate}} — {{source.endDate}}</text><text class="muted">保留完整7天，已过日期也可查看。</text></view>
<view wx:if="{{!accepted}}" class="share-card"><view class="day-heading"><text>当前宝宝：{{babyName}}</text><button wx:if="{{canSwitch}}" class="link" bindtap="switchBaby">切换</button></view><text wx:if="{{!canAdopt}}" class="muted">共享宝宝的菜单由管理员维护；你仍可完整查看本分享。</text><button class="secondary" bindtap="viewOnly">仅查看，不覆盖</button><button wx:if="{{canAdopt && !editingConditions}}" class="primary" bindtap="startAdoption">{{hasOwnMenu?'选择覆盖自己的菜单':'使用这份菜单'}}</button></view>
<view wx:if="{{editingConditions && canAdopt && !accepted}}" id="receive-menu-conditions" class="share-card"><text class="share-title">接收前核对</text><text class="muted">核对本宝宝的条件，不调用AI，不扣生成次数。</text><text class="section">需避开的食材</text><view class="choices"><button class="{{avoidance==='NONE'?'active':''}}" data-value="NONE" bindtap="setAvoidance" disabled="{{busy}}">已确认暂无</button><button class="{{avoidance==='KNOWN'?'active':''}}" data-value="KNOWN" bindtap="setAvoidance" disabled="{{busy}}">有需避开食材</button></view><textarea wx:if="{{avoidance==='KNOWN'}}" value="{{avoidText}}" bindinput="onAvoid" placeholder="例如：鸡蛋、牛奶" maxlength="500" disabled="{{busy}}"/><text class="section">能接受的食物形态</text><view class="choices"><button wx:for="{{textureChoices}}" wx:key="value" data-value="{{item.value}}" bindtap="setTexture" class="{{texture===item.value?'active':''}}" disabled="{{busy}}">{{item.label}}</button></view><text wx:if="{{errorMessage}}" class="error" role="alert">{{errorMessage}}</text><button class="primary" bindtap="adopt" loading="{{busy}}" disabled="{{busy}}">确认并接收菜单</button></view>
<view wx:if="{{accepted}}" class="share-card"><text class="share-title">已接收分享菜单</text><text class="muted">原7天日期及分享来源已保留，旧菜单不会被删除。</text><button class="primary" bindtap="openMenu">打开我的菜单</button></view>
<view wx:for="{{days}}" wx:key="date" class="share-card"><view class="day-heading" data-date="{{item.date}}" bindtap="toggleDay"><text>{{item.date}}</text><text class="muted">{{expandedDate===item.date?'收起':'查看做法'}} ›</text></view><view wx:for="{{item.meals}}" wx:for-item="meal" wx:key="slot" class="share-meal {{expandedDate===item.date?'expanded':'compact'}}"><text class="meal-label">{{meal.label}}</text><view wx:for="{{meal.recipes}}" wx:for-item="recipe" wx:key="key"><text class="recipe-name">{{recipe.name}}</text><block wx:if="{{expandedDate===item.date}}"><text class="muted">预计{{recipe.preparationMinutes}}分钟 · {{recipe.textureAdvice}}</text><view class="ingredients"><text wx:for="{{recipe.ingredients}}" wx:for-item="ingredient" wx:key="index">{{ingredient.name}} {{ingredient.quantity}}{{ingredient.unit==='g'?'克':'毫升'}}{{index===recipe.ingredients.length-1?'':'、'}}</text></view><text wx:for="{{recipe.steps}}" wx:for-item="step" wx:key="index" class="step">{{index+1}}. {{step}}</text></block></view></view></view>
</block></view>
