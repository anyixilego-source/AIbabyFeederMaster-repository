<navigation-bar id="feedback-navigation" title="{{showModulePicker?'功能位置':'意见反馈'}}" back="{{false}}" color="#3d302a" background="transparent"><view slot="left" class="my-nav" bindtap="goBack"><view></view></view></navigation-bar><scroll-view class="my-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="my-shell">
 <view wx:if="{{showModulePicker}}" id="feedback-module-picker" class="my-card module-card"><view class="my-handle"></view><view class="my-heading"><text class="my-title">功能位置</text><view id="feedback-module-close" class="module-close" bindtap="closeModulePicker">×</view></view><view class="module-breadcrumb"><text data-index="-1" bindtap="moduleLevel">全部模块</text><text wx:for="{{moduleTrail}}" wx:key="code" data-index="{{index}}" bindtap="moduleLevel"> › {{item.name}}</text></view><view class="module-options"><view wx:for="{{moduleOptions}}" wx:key="code" id="feedback-module-option-{{index}}" class="my-row" data-code="{{item.code}}" bindtap="chooseModule"><view class="my-icon-box"><view class="my-icon report"></view></view><text class="my-label">{{item.name}}</text><text class="my-chevron">›</text></view></view><button wx:if="{{moduleTrail.length}}" id="feedback-module-commit" class="my-secondary" bindtap="commitModule">选择“{{moduleTrail[moduleTrail.length-1].name}}”</button><text wx:if="{{!moduleOptions.length}}" class="my-small">此位置下暂无更多模块。</text></view>
 <block wx:elif="{{receipt}}"><view class="my-card success" id="feedback-success"><image class="success-picture" src="/assets/baby-eating-centered-v3.jpg" mode="aspectFill"/><text class="success-title">谢谢你，让它变得更好</text><text class="success-copy">反馈已收到。
你的每个建议，我们都会认真看。</text><button class="my-primary" bindtap="goBack">返回我的</button></view><view class="my-contact">开发者微信：yuzhukui</view><view class="my-disclosure"><view id="feedback-receipt-toggle" class="my-disclosure-toggle" bindtap="toggleSuccessInfo"><text>提交信息</text><text>{{showSuccessInfo?'−':'+'}}</text></view><view wx:if="{{showSuccessInfo}}" class="my-disclosure-body"><text class="my-small" selectable>反馈编号：{{receipt}}</text><text class="my-small">联系方式仅用于必要跟进。需要删除已提交反馈时，可提供编号联系开发者。</text></view></view></block>
 <block wx:else><view class="my-card feedback-form"><view class="my-field first-field"><text class="my-field-label">反馈内容</text><textarea id="feedback-description" class="feedback-textarea" value="{{description}}" maxlength="2000" disabled="{{saving || uncertain}}" placeholder="希望怎么改，或遇到了什么情况？" bindinput="onDescription" auto-height/><text class="feedback-counter">{{count}} / 2000</text></view><view id="feedback-module-card" class="my-field"><text class="my-field-label">功能位置 <text class="field-optional">选填</text></text><button id="feedback-module-open" class="my-secondary location-button" bindtap="openModulePicker" disabled="{{saving || uncertain}}">{{moduleLabel || '选择反馈的模块'}} ›</button><text wx:if="{{moduleError}}" class="my-small">{{moduleError}}</text><view wx:if="{{moduleCode}}" id="feedback-module-clear" class="module-clear" bindtap="clearModule">清除选择</view></view><view class="my-field"><text class="my-field-label">补充图片 <text class="field-optional">选填</text></text><view class="pictures"><view class="picture" wx:for="{{pictures}}" wx:key="key"><image src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="preview"/><text class="image-state">{{item.state}}</text><text wx:if="{{item.error}}" class="image-error">{{item.error}}</text><view class="image-actions"><button class="small" data-key="{{item.key}}" disabled="{{saving || uncertain}}" bindtap="removePicture">删除</button><button wx:if="{{item.error}}" class="small" data-key="{{item.key}}" disabled="{{saving || uncertain}}" bindtap="retryPicture">重试</button></view></view><button id="feedback-add-images" class="upload-box" wx:if="{{pictures.length < 6}}" disabled="{{saving || uncertain || selecting}}" loading="{{selecting}}" bindtap="choosePictures">＋</button></view></view><view class="my-field"><text class="my-field-label">联系方式（选填）</text><input id="feedback-contact" class="my-input" value="{{contact}}" maxlength="100" disabled="{{saving || uncertain}}" placeholder="微信号、手机号或邮箱" bindinput="onContact"/></view></view><view wx:if="{{errorMessage}}" class="my-error" id="feedback-error">{{errorMessage}}</view><button id="feedback-submit" class="my-primary" disabled="{{saving || selecting}}" loading="{{saving}}" bindtap="submit">{{uncertain ? '核对提交结果' : '提交反馈'}}</button><view id="feedback-developer-contact" class="my-contact"><text selectable>也可以联系开发者：微信 yuzhukui</text></view><view class="my-disclosure"><view id="feedback-privacy-toggle" class="my-disclosure-toggle" bindtap="togglePrivacyInfo"><text>提交说明</text><text>{{showPrivacyInfo?'−':'+'}}</text></view><view wx:if="{{showPrivacyInfo}}" class="my-disclosure-body"><text class="my-small">文字、图片和联系方式仅用于反馈处理，不发送给AI。反馈保留180天，未提交图片最多保留1小时。最多6张图片，单张不超过5MiB。</text><text class="my-small">请勿上传与反馈无关的隐私资料；需要删除已提交反馈时，可提供编号提出删除请求。</text></view></view></block>
</view></scroll-view>