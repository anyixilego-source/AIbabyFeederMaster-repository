<navigation-bar title="意见反馈" back="{{false}}" color="#2d2623" background="transparent"><view slot="left" class="back" bindtap="goBack">‹</view></navigation-bar>
<scroll-view class="feedback-scroll" scroll-y><view class="feedback-page">
  <view wx:if="{{receipt}}" class="card success" id="feedback-success"><text class="title">反馈已收到</text><text>感谢反馈，联系方式仅用于必要跟进。</text><text class="receipt">编号：{{receipt}}</text><button class="primary" bindtap="goBack">返回我的</button><button class="secondary" bindtap="again">再写一条</button></view>
  <block wx:else>
    <view class="intro">欢迎分享使用感受、建议或遇到的情况。</view>
    <view class="card"><view class="title">反馈内容 <text class="required">必填</text></view><textarea id="feedback-description" value="{{description}}" maxlength="2000" disabled="{{saving || uncertain}}" placeholder="请输入意见、建议或使用体验，也可以描述遇到的情况。" bindinput="onDescription" auto-height></textarea><text class="counter">{{count}} / 2000</text></view>
    <view id="feedback-module-card" class="card"><view class="title">功能位置 <text class="optional">选填</text></view><view id="feedback-module-open" class="module-selection" bindtap="openModulePicker">{{moduleLabel || '选择反馈的模块'}}</view><text wx:if="{{moduleError}}" class="hint">{{moduleError}}</text><text wx:if="{{moduleCode}}" id="feedback-module-clear" class="module-clear" bindtap="clearModule">清除选择</text></view>
    <view class="card"><view class="title">图片 <text class="optional">选填 · {{pictures.length}}/6</text></view><text class="hint">单张不超过5MiB，可上传截图或补充图片。</text><view class="pictures"><view class="picture" wx:for="{{pictures}}" wx:key="key"><image src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="preview"></image><text class="state">{{item.state}}</text><text wx:if="{{item.error}}" class="image-error">{{item.error}}</text><view class="image-actions"><button class="small" data-key="{{item.key}}" disabled="{{saving || uncertain}}" bindtap="removePicture">删除</button><button wx:if="{{item.error}}" class="small" data-key="{{item.key}}" disabled="{{saving || uncertain}}" bindtap="retryPicture">重试</button></view></view></view><button id="feedback-add-images" class="secondary" wx:if="{{pictures.length < 6}}" disabled="{{saving || uncertain || selecting}}" loading="{{selecting}}" bindtap="choosePictures">添加图片</button></view>
    <view class="card"><view class="title">联系方式 <text class="optional">选填</text></view><input id="feedback-contact" value="{{contact}}" maxlength="100" disabled="{{saving || uncertain}}" placeholder="微信号、手机号或邮箱" bindinput="onContact"></input></view>
    <view wx:if="{{errorMessage}}" class="error" id="feedback-error">{{errorMessage}}</view>
    <button id="feedback-submit" class="primary" disabled="{{saving || selecting}}" loading="{{saving}}" bindtap="submit">{{uncertain ? '核对提交结果' : '提交反馈'}}</button>
    <text class="privacy">文字、图片和联系方式仅用于反馈处理，不发送给AI。反馈保留180天，未提交图片最多保留1小时。请勿上传与反馈无关的隐私资料；需要删除已提交反馈时，可提供编号提出删除请求。</text>
  </block>
  <view id="feedback-developer-contact" class="developer-contact"><text selectable="{{true}}">开发者微信：yuzhukui</text></view>
</view></scroll-view>
<view wx:if="{{showModulePicker}}" id="feedback-module-picker" class="module-mask" bindtap="closeModulePicker"><view class="module-sheet" catchtap="stopModuleTap"><view class="module-heading"><text class="title">功能位置</text><text id="feedback-module-close" class="module-clear" bindtap="closeModulePicker">关闭 ×</text></view><view class="module-breadcrumb"><text data-index="-1" bindtap="moduleLevel">全部模块</text><text wx:for="{{moduleTrail}}" wx:key="code" data-index="{{index}}" bindtap="moduleLevel"> › {{item.name}}</text></view><scroll-view class="module-options" scroll-y><view class="module-grid"><button wx:for="{{moduleOptions}}" wx:key="code" id="feedback-module-option-{{index}}" class="secondary" data-code="{{item.code}}" bindtap="chooseModule">{{item.name}}</button></view></scroll-view><button wx:if="{{moduleTrail.length}}" id="feedback-module-commit" class="primary" bindtap="commitModule">就选这里</button><text class="hint">可选到任意一级，也可不选位置直接提交。</text></view></view>
