page{height:100%;background:#fff9f5;color:#302823}.feedback-scroll{height:calc(100vh - 180rpx)}.feedback-page{padding:28rpx 28rpx 80rpx}.back{width:80rpx;height:80rpx;line-height:70rpx;text-align:center;font-size:64rpx}.intro{font-size:27rpx;color:#746962;line-height:1.6;margin-bottom:22rpx}.card{background:#fff;border:1rpx solid #f2ded2;border-radius:28rpx;padding:28rpx;margin-bottom:24rpx}.title{font-size:32rpx;font-weight:600;margin-bottom:22rpx}.required,.optional{font-size:23rpx;font-weight:400;margin-left:12rpx}.required{color:#d45c55}.optional,.hint,.counter,.privacy{color:#847970}.hint{font-size:24rpx;display:block;margin-bottom:20rpx}textarea{width:100%;min-height:190rpx;font-size:28rpx;line-height:1.7}input{height:68rpx;font-size:28rpx}.counter{display:block;text-align:right;font-size:22rpx}.primary,.secondary,.small{min-height:72rpx;line-height:1.35;display:flex;align-items:center;justify-content:center;border-radius:18rpx;font-size:27rpx;padding:18rpx 22rpx}.primary,.secondary{box-sizing:border-box;height:80rpx;min-height:80rpx;padding:0 22rpx}.primary{background:#ff7474;color:#fff;margin:20rpx 0}.secondary,.small{background:#fff7ef;color:#8b654e;border:1rpx solid #edd9c7}.primary::after,.secondary::after,.small::after{border:0}.pictures{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}.picture image{width:100%;height:150rpx;border-radius:16rpx}.state{display:block;font-size:22rpx;margin:8rpx 0}.image-actions{display:flex;gap:6rpx;margin-bottom:18rpx}.small{font-size:23rpx;padding:12rpx 8rpx;min-height:64rpx;flex:1}.image-error{display:block;color:#af4a38;font-size:22rpx;overflow-wrap:anywhere}.error{padding:22rpx;border-radius:18rpx;background:#fff0e2;color:#af4a38;font-size:26rpx;line-height:1.6;margin-bottom:18rpx}.privacy{display:block;font-size:23rpx;line-height:1.65;margin-top:18rpx}.success text{display:block;margin-bottom:20rpx}.receipt{font-size:23rpx;word-break:break-all}
.module-selection{background:#fbf2e9;color:#a5663f;border-radius:18rpx;min-height:80rpx;box-sizing:border-box;padding:20rpx 24rpx;font-size:27rpx;line-height:1.5}.module-clear{display:inline-block;color:#c57952;font-size:25rpx;padding:14rpx 0}.module-mask{position:fixed;inset:0;background:#0006;z-index:1000;display:flex;align-items:flex-end}.module-sheet{width:100%;max-height:80vh;box-sizing:border-box;background:#fff9f5;border-radius:30rpx 30rpx 0 0;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom))}.module-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.module-heading .title{margin:0}.module-breadcrumb{font-size:25rpx;color:#a5663f;line-height:1.8;margin:16rpx 0;overflow-wrap:anywhere}.module-options{max-height:40vh}.module-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}.module-grid button{margin:0;width:100%;font-size:25rpx;min-height:80rpx;height:auto;white-space:normal}

.developer-contact{margin-top:28rpx;padding:12rpx 0;text-align:center;color:#a5663f;font-size:25rpx;line-height:1.6}
