@import "../../styles/my-module.wxss";
.first-field{margin-top:0}.feedback-form .my-field+.my-field{margin-top:30rpx}.field-optional{font-weight:400;color:#b1a08d;font-size:19rpx}.feedback-textarea{width:100%;min-height:150rpx;box-sizing:border-box;padding:23rpx;border:2rpx solid #eee0d4;border-radius:23rpx;background:#fffdfa;color:#3d302a;font-size:25rpx;line-height:1.8}.feedback-counter{display:block;color:#b6a798;text-align:right;font-size:18rpx;margin-top:6rpx}.location-button{margin:14rpx 0;font-size:27rpx;min-height:92rpx;height:auto}.module-clear{font-size:21rpx;color:#bd9167;padding:12rpx 0;line-height:1.6}.pictures{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15rpx}.upload-box{margin:0;display:flex;align-items:center;justify-content:center;width:126rpx;height:126rpx;background:#fcf7f0;border:2rpx dashed #dec7af;border-radius:26rpx;color:#b79c7f;font-size:42rpx;padding:0;line-height:1}.picture{min-width:0}.picture>image{width:100%;height:126rpx;border-radius:23rpx}.image-state{display:block;color:#b19d88;font-size:18rpx;line-height:1.5;margin-top:7rpx}.image-error{display:block;font-size:18rpx;color:#bd7463;line-height:1.6;overflow-wrap:anywhere}.image-actions{display:flex;gap:8rpx;margin-top:6rpx}.small{flex:1;min-width:0;margin:0;min-height:54rpx;padding:8rpx 4rpx;background:#fff0e9;color:#bd805c;font-size:19rpx;border-radius:14rpx;line-height:1.5}.module-close{font-size:35rpx;color:#b19b85;min-width:68rpx;min-height:68rpx;display:flex;align-items:center;justify-content:flex-end}.module-breadcrumb{font-size:20rpx;color:#b19b85;line-height:1.8;margin:18rpx 0 27rpx;overflow-wrap:anywhere}.module-breadcrumb text{padding:8rpx 0}.module-card .my-secondary{margin-bottom:0}.success{text-align:center;padding:85rpx 54rpx}.success-picture{display:block;width:240rpx;height:250rpx;border-radius:50%;margin:0 auto 35rpx}.success-title{display:block;font-size:31rpx;font-weight:600;line-height:1.6}.success-copy{display:block;white-space:pre-wrap;color:#b19b85;font-size:25rpx;line-height:1.8;margin:20rpx 0 38rpx}.success .my-primary{margin-bottom:0}

.my-shell .pictures button.upload-box{width:126rpx;min-width:126rpx;max-width:126rpx;height:126rpx;margin:0}
