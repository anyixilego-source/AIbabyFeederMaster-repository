.nav-circle { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.retry-button { height: 62rpx; padding: 0 18rpx; border-radius: 31rpx; display: flex; align-items: center; gap: 10rpx; color: #ff6f70; background: #fff; font-size: 22rpx; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.retry-icon { width: 25rpx; height: 25rpx; border: 4rpx solid currentColor; border-left-color: transparent; border-radius: 50%; }.retry-icon::after { content: ''; position: absolute; width: 8rpx; height: 8rpx; border-left: 4rpx solid currentColor; border-bottom: 4rpx solid currentColor; transform: translate(-4rpx,14rpx) rotate(20deg); }
.result-scroll { height: calc(100vh - 102rpx); }.result-page { padding-top: 10rpx; }.food-card { min-height: 326rpx; display: flex; overflow: hidden; }.meal-photo { width: 44%; min-height: 326rpx; }.food-list { width: 56%; padding: 22rpx 22rpx 12rpx; }.food-heading { display: block; margin-bottom: 8rpx; font-size: 27rpx; font-weight: 700; }.food-row { height: 47rpx; border-bottom: 1rpx solid #f4ebe6; display: flex; align-items: center; }.food-dot { width: 35rpx; height: 35rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 17rpx; font-weight: 700; }.food-dot.protein { color: #e86b63; background: #fff0ed; }.food-dot.grain,.food-dot.egg { color: #d99a34; background: #fff7e8; }.food-dot.vegetable { color: #61ac49; background: #eff8e8; }.food-dot.carrot { color: #ed7d44; background: #fff0e5; }.food-name { margin-left: 13rpx; flex: 1; font-size: 24rpx; }.food-amount { color: #817873; font-size: 22rpx; }.reference-note { min-height: 42rpx; display: flex; align-items: center; gap: 7rpx; color: #9b9591; font-size: 17rpx; white-space: nowrap; }.info-icon { width: 25rpx; height: 25rpx; border: 3rpx solid #aaa; border-radius: 50%; font-size: 17rpx; line-height: 21rpx; text-align: center; }.edit-icon { width: 25rpx; height: 8rpx; margin-left: auto; border-radius: 4rpx; background: #a86f53; transform: rotate(-45deg); }.edit-icon::after { content: ''; position: absolute; width: 4rpx; height: 8rpx; background: #fff; transform: translateX(5rpx); }
.estimate-card { margin-top: 20rpx; padding: 22rpx 22rpx 0; }.estimate-title { display: flex; align-items: center; gap: 12rpx; }.nutrition-grid { margin-top: 18rpx; display: grid; grid-template-columns: repeat(6,1fr); }.nutrition-cell { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 9rpx; }.nutrition-name { height: 32rpx; color: #756d68; font-size: 18rpx; white-space: nowrap; }.nutrition-badge { width: 47rpx; height: 47rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 17rpx; font-weight: 700; }.nutrition-badge.heat,.nutrition-badge.protein { color: #ef7066; background: #fff0ed; }.nutrition-badge.fat,.nutrition-badge.grain { color: #e7a439; background: #fff5e4; }.nutrition-badge.mineral { color: #38b6cf; background: #e9f9fc; }.nutrition-value { font-size: 20rpx; white-space: nowrap; }.estimate-foot { min-height: 67rpx; margin-top: 20rpx; border-top: 1rpx solid #f2ebe7; display: flex; align-items: center; justify-content: space-between; color: #9b9591; font-size: 17rpx; }.detail-inline { display: flex; align-items: center; gap: 8rpx; }
.evaluation-card { margin-top: 20rpx; padding: 22rpx; background: linear-gradient(110deg,#effbe9,#f8fff4); }.evaluation-heading { color: #3f9b3d; font-size: 24rpx; font-weight: 700; }.evaluation-body { margin-top: 12rpx; display: flex; }.evaluation-body image { width: 170rpx; height: 160rpx; border-radius: 75rpx 75rpx 24rpx 24rpx; }.evaluation-panel { min-width: 0; margin-left: 12rpx; padding: 18rpx; border-radius: 22rpx; display: grid; flex: 1; grid-template-columns: 1fr 1.15fr; gap: 20rpx; background: rgba(255,255,255,.94); }.evaluation-panel > view { display: flex; flex-direction: column; gap: 8rpx; font-size: 19rpx; }.good-title { color: #42a644; font-size: 23rpx; font-weight: 700; }.suggestion { border-left: 1rpx solid #e7f1e3; padding-left: 18rpx; }.suggestion-title { color: #f28b22; font-size: 23rpx; font-weight: 700; }.suggestion text:last-child { line-height: 1.55; }
.result-actions { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; min-height: 116rpx; padding: 14rpx 32rpx; display: grid; grid-template-columns: 1fr 1.15fr; gap: 20rpx; background: rgba(255,255,255,.97); box-shadow: 0 -8rpx 24rpx rgba(111,75,56,.06); }.result-actions button { height: 80rpx; }.result-actions .primary-button { gap: 12rpx; }.check-circle { width: 34rpx; height: 34rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ff6f70; background: #fff; }.check-circle .check-icon { width: 16rpx; height: 9rpx; border-width: 0 0 4rpx 4rpx; }
@media (max-width: 360px) { .result-page { padding-left: 24rpx; padding-right: 24rpx; }.nutrition-name { font-size: 16rpx; }.nutrition-value { font-size: 17rpx; }.evaluation-panel { gap: 10rpx; padding: 14rpx; }.evaluation-body image { width: 140rpx; } }
.meal-photo-wrap { position: relative; width: 44%; min-height: 326rpx; overflow: hidden; flex-shrink: 0; background: #f6dfcf; }.meal-photo-wrap .meal-photo { width: 100%; height: 100%; min-height: 0; }.meal-photo-wrap.sample .meal-photo { position: absolute; left: -560rpx; top: 0; width: auto; height: 100%; }
.consent-card { padding-bottom: 24rpx; }.consent-copy { display: block; margin: 18rpx 0; color: #756d68; font-size: 21rpx; line-height: 1.7; }.picker-value,.selected-food { margin: 14rpx 0; padding: 18rpx; border-radius: 16rpx; background: #fff8f3; color: #6c5d55; font-size: 22rpx; }.consent-check { display: flex; align-items: center; gap: 12rpx; margin: 18rpx 0; font-size: 21rpx; }.manual-search,.amount-row { display: flex; gap: 14rpx; margin-top: 18rpx; }.manual-search input,.amount-row input { min-width: 0; flex: 1; height: 72rpx; padding: 0 18rpx; border-radius: 16rpx; background: #f8f5f2; font-size: 22rpx; }.manual-search button { width: 130rpx; height: 72rpx; color: #fff; background: #ff7b7c; font-size: 22rpx; }.evaluation-panel { display: block; margin-left: 0; }.evaluation-panel > view { line-height: 1.65; }
