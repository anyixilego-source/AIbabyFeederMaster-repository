<navigation-bar title="修改饮食记录" back="{{false}}" color="#2d2623" background="transparent"><view slot="left" class="back" bindtap="goBack">‹</view></navigation-bar>
<scroll-view class="edit-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="edit-page">
<view wx:if="{{reviewLabel}}" class="review">{{reviewLabel}} · 请只录入合成测试数据</view>
<view wx:if="{{loading}}" class="card">正在读取原记录…</view><view wx:elif="{{errorMessage}}" class="card warn">{{errorMessage}}<button id="return-records" class="return-records" bindtap="goBack">返回记录页</button></view>
<block wx:else><view class="intro">核对这餐实际吃下的食品和重量</view><view class="sub">修改不会重新分配各项占比，统一保存后才更新记录。</view>
<view wx:if="{{message}}" class="message" role="alert">{{message}}</view>
<block wx:if="{{!invalidated || unresolved}}">
<view class="card"><view class="section-title">餐食时间</view><view class="date-time"><button id="edit-date" bindtap="openCalendar" disabled="{{busy || invalidated || unresolved}}">{{date}} ▾</button><picker mode="time" value="{{time}}" bindchange="changeTime" disabled="{{busy || invalidated || unresolved}}"><view class="time-button">{{time}} ▾</view></picker></view><view class="meal-types"><button wx:for="{{mealTypes}}" wx:key="key" class="type-button {{mealType === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="changeType" disabled="{{busy || invalidated || unresolved}}">{{item.label}}</button></view></view>
<view class="section-title">本餐食品</view>
<view class="card food-card {{item.removed ? 'removed' : ''}}" wx:for="{{items}}" wx:key="key">
<view class="food-heading"><text class="food-name">{{item.name}}</text><button class="text-button remove-button" data-key="{{item.key}}" bindtap="removeItem" disabled="{{busy || invalidated || unresolved}}">{{item.removed ? '恢复' : '移除'}}</button></view>
<view wx:if="{{item.removed}}" class="sub">已移除，保存前可恢复；暂不计入本餐合计。</view>
<block wx:else><view class="weight-row"><view><text class="label">实际吃下</text><text class="nature">{{item.origin === 'USER_ACCEPTED_ESTIMATE' ? '约 · 用户接受的估算' : item.origin === 'MEASURED' ? '原记录实测' : '原记录来源未知'}}</text></view><view class="weight-input"><input class="gram-input" type="number" value="{{item.input}}" data-key="{{item.key}}" bindinput="weightInput" disabled="{{busy || invalidated || unresolved}}" adjust-position cursor-spacing="140" maxlength="18"/><text>克</text></view></view>
<view wx:if="{{item.highPrecision && !item.weightChanged}}" class="precision">历史重量以整数显示；未调整时保留原始记录。</view>
<view class="food-actions"><button class="text-button slider-toggle" data-key="{{item.key}}" bindtap="toggleSlider" disabled="{{busy || invalidated || unresolved}}">{{openSlider === item.key ? '收起调重' : '拖动调重'}}</button><button class="text-button replace-button" data-key="{{item.key}}" bindtap="openSearch" disabled="{{busy || invalidated || unresolved}}">更换食品</button></view>
<view wx:if="{{openSlider === item.key}}" class="slider-wrap"><view class="slider-note">{{item.raw > 500 ? '当前超过500克，可手输；拖动后按滑条新值调整' : item.raw === '0' ? '0克不能保存，请调重或移除此项' : item.snap !== null ? '将吸附至'+item.snap+'克' : '拖动估重，输入框可填写小数'}}</view><slider class="food-slider" min="0" max="500" step="1" value="{{item.slider}}" activeColor="#ff7478" backgroundColor="#efdfd8" block-color="#ff7478" block-size="24" disabled="{{busy || invalidated || unresolved}}" data-key="{{item.key}}" bindchanging="slideChanging" bindchange="slideChanged"/><view class="ticks"><view wx:for="{{ticks}}" wx:for-item="tick" wx:key="value" class="tick {{item.snap === tick.value ? 'active' : ''}}" style="left:{{tick.left}}%"></view></view><view class="tick-labels"><text>0</text><text>250</text><text>500 克</text></view></view>
<view wx:if="{{item.served}}" class="sub original-served">原记录提供量 {{item.served}} 克 · 口径未确认，仅保留</view></block></view>
<button id="add-food" bindtap="openSearch" disabled="{{busy || invalidated || unresolved}}">＋ 添加食品</button><view class="total-card"><text>本餐实际吃下合计</text><text>{{total}} 克</text></view><view wx:if="{{validation}}" class="warn">{{validation}}</view><view wx:elif="{{weightWarning}}" id="weight-warning" class="warn">{{weightWarning}}</view><view class="impact">{{impact}}</view><button id="delete-meal" class="delete-button" bindtap="deleteMeal" disabled="{{busy || invalidated || unresolved}}">删除原记录这餐</button><view class="sub original-label">{{originalLabel}}</view>
</block></block></view></scroll-view>
<view wx:if="{{!loading && !errorMessage}}" class="edit-footer"><text wx:if="{{(validation || weightWarning) && !invalidated && !unresolved}}" id="save-weight-warning" class="footer-warning" role="alert">{{validation || weightWarning}}</text><text>{{busy ? '正在处理，请稍候' : unresolved ? '结果待核对，请重试或返回记录查看' : invalidated ? '请返回记录页重新打开这餐' : changed ? '修改尚未保存，退出将放弃' : '尚无修改'}}</text><button wx:if="{{!invalidated || unresolved}}" id="save-meal" class="primary" bindtap="save" disabled="{{busy || (!changed && !unresolved) || (!!validation && !unresolved) || (invalidated && !unresolved)}}" loading="{{busy}}">{{unresolvedDelete ? '重试删除' : unresolved ? '重试保存' : '保存修改'}}</button><button wx:if="{{invalidated || unresolved}}" id="return-records" class="return-records" bindtap="goBack" disabled="{{busy}}">返回记录页</button></view>
<date-calendar id="edit-calendar" visible="{{showCalendar}}" selected="{{date}}" max-date="{{today}}" title="选择餐食日期" bindchange="changeDate" bindclose="closeCalendar"/>
<food-selector id="food-selector" visible="{{showSearch}}" initial-query="{{query}}" bindclose="closeSearch" bindselect="onFoodSelection"/>
