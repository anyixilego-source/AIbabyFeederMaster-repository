<wxs module="visual">
function dateLabel(d){d=d||'';if(d.length!==10||d.charAt(4)!=='-'||d.charAt(7)!=='-')return d;return d.slice(0,4)+'年'+(+d.slice(5,7))+'月'+(+d.slice(8,10))+'日';}
module.exports={dateLabel:dateLabel};
</wxs>
<navigation-bar back="{{false}}" color="#3d302a" background="transparent"><view slot="left" class="detail-nav-back" bindtap="goBack"><view></view></view><text slot="center" class="detail-nav-title">单日营养素详情</text></navigation-bar>
<view class="page-shell"><view wx:if="{{reviewLabel}}" class="review">{{reviewLabel}}</view><view class="detail-mode-row"><text class="detail-date">{{visual.dateLabel(dateLabel)}}</text><period-mode-switch id="period-mode" appearance="prototype" active="DAY" disabled="{{loading}}" bindchange="changePeriodMode"/></view>
 <view wx:if="{{errorMessage}}" class="error-card">{{errorMessage}}</view><view wx:elif="{{loading}}" class="loading-card">正在整理营养素详情…</view>
 <block wx:else>
  <view class="tabs"><view wx:for="{{categories}}" wx:key="key" id="nutrient-category-{{item.key}}" class="tab {{(showNutrientOptions?optionCategory:category)===item.key?'active':''}}" data-key="{{item.key}}" bindtap="selectCategory">{{item.name}}</view></view>
  <scroll-view wx:if="{{showNutrientOptions}}" id="nutrient-options" class="nutrient-options" scroll-x enhanced show-scrollbar="{{false}}"><view class="nutrient-options-row"><view wx:for="{{visibleOptions}}" wx:key="code" id="nutrient-choice-{{item.code}}" class="nutrient-option {{nutrientCode===item.code?'active':''}}" data-code="{{item.code}}" bindtap="selectNutrient">{{item.name}}</view></view></scroll-view>
  <view id="nutrient-summary-card" class="card summary-card"><view class="section-title"><view class="detail-leaf-icon"></view><text>{{name}}</text></view><view class="summary-main">
   <view id="nutrient-comparison-ring" class="comparison-ring {{comparisonColor}}" style="background:conic-gradient({{comparisonStroke}} {{comparisonPercent * 3.6}}deg,#f4efe5 0deg)"><view class="comparison-ring-inner"><view class="comparison-ring-number {{comparisonText.length>5?'very-long':comparisonText.length>3?'long':''}}"><text>{{comparisonText}}</text><text wx:if="{{comparisonAvailable}}" class="comparison-ring-unit">%</text></view><text class="comparison-ring-caption">{{comparisonCaption}}</text></view></view>
   <view class="summary-copy"><view class="amount-line"><text class="amount-value {{comparisonAvailable?'with-reference':''}}">{{amountText}}</text><text wx:if="{{hasValue}}" class="amount-unit">{{unitText}}</text></view><text class="amount-caption">已记录量</text><text id="detail-reference-value" class="reference-text">{{referenceText}}</text><text wx:if="{{referenceSource}}" id="detail-reference-source" class="reference-source">参考来源：{{referenceSource}}</text><text wx:if="{{dataNote}}" class="summary-data-note">{{dataNote}}</text></view>
  </view>
        <view wx:if="{{referenceAvailable && hasRange}}" class="ruler-wrap">
        <text wx:if="{{showCurrentMarker}}" class="marker-value {{markerPercent<12?'at-start':markerPercent>88?'at-end':''}}" style="left: {{markerPercent}}%">{{currentMarkerText}} {{unitText}}</text>
        <view class="ruler">
          <view wx:if="{{hasRange}}" class="ruler-fill" style="left: {{rangeStartPercent}}%; width: {{rangeWidthPercent}}%; right: auto"></view>
          <view wx:if="{{hasRange}}" class="range-boundary" style="left: {{rangeStartPercent}}%"></view>
          <view wx:if="{{hasRange}}" class="range-boundary" style="left: {{rangeStartPercent + rangeWidthPercent}}%"></view>
          <view wx:if="{{showCurrentMarker}}" class="marker {{informationalMarker?'informational':''}}" style="left: {{markerPercent}}%"></view>
        </view>
        <view class="ruler-labels"><text class="ruler-end first">0</text><view wx:if="{{hasRange}}" class="range-tick lower" style="left: {{rangeStartPercent}}%"><text class="range-tick-value">{{rangeLowerText}}</text></view><view wx:if="{{hasRange}}" class="range-tick upper" style="left: {{rangeStartPercent + rangeWidthPercent}}%"><text class="range-tick-value">{{rangeUpperText}}</text></view><text class="ruler-end last">{{scaleMaxText}}</text></view>
      </view>
<text wx:if="{{hasRange}}" class="reference-range-note">{{referenceSubText}}</text>
  </view>
  <view id="food-contribution-card" class="card"><view class="section-title">食物贡献清单</view><view wx:if="{{foodCards.length}}" id="food-contribution-list" class="source-table"><view class="source-table-row source-table-head"><text>食物名称</text><text>食物克重</text><text>贡献占比</text></view><view wx:for="{{foodCards}}" wx:key="key" class="source-table-row {{item.calculable?'':'unavailable'}}"><view class="source-table-name"><text>{{item.name}}</text><text wx:if="{{item.calculable && item.hasMissing}}" class="food-note">部分可计算</text></view><text class="source-table-weight">{{item.recordWeightText}}</text><text class="source-table-percent {{item.percent===null?'unavailable':''}}">{{item.percentText}}</text></view></view><view wx:else class="source-empty">当前记录中暂无可展示的食物明细</view></view>
  <view class="detail-disclosure"><view id="detail-source-toggle" class="disclosure-heading" bindtap="toggleAbout"><text>查看来源与依据</text><text>{{aboutExpanded?'−':'+'}}</text></view><view wx:if="{{aboutExpanded}}" id="detail-source-body" class="disclosure-body"><text wx:if="{{sourceSnapshotAvailable}}" class="scope-note">记录包含 {{foodCards.length}} 种食物 · {{sourceCount}} 种可计算</text><text wx:else class="scope-note">旧报告未保存来源明细</text><text wx:if="{{sources.length}}" class="scope-note">以下占比仅表示各食物在本项已知量中的贡献。</text><text class="scope-note">本页数值是已记录食物中可计算的{{name}}合计。</text><view wx:for="{{sources}}" wx:key="foodId"><text class="scope-note">{{item.name}}：记录重量{{item.recordWeightText}}；本项贡献{{item.valueText}} {{unitText}}；营养数据版本{{item.sourceVersionText}}</text><text class="scope-note" wx:for="{{item.evidenceIds}}" wx:for-item="evidenceId" wx:key="*this">依据编号 {{evidenceId}}</text></view><text wx:if="{{dataNote}}" class="scope-note">{{dataNote}}，当前结果仅代表已知部分。</text></view></view>
  <view class="detail-disclosure"><view id="detail-report-toggle" class="disclosure-heading" bindtap="toggleConclusion"><text>报告说明</text><text>{{conclusionExpanded?'−':'+'}}</text></view><view wx:if="{{conclusionExpanded}}" id="detail-report-body" class="disclosure-body"><text class="explanation-title">{{referenceMainText}}</text><text class="scope-note">{{referenceSubText}}</text><text class="conclusion {{conclusionTone}}">{{conclusion}}</text><text class="explanation-title">这份记录能说明什么</text><text wx:for="{{reasons}}" wx:key="*this" class="scope-note">{{item}}</text><text class="explanation-title">解释范围</text><text wx:for="{{suggestions}}" wx:key="*this" class="scope-note">{{item}}</text><text class="scope-note">如果仍有未记录的奶量或食物，实际摄入可能不同。</text></view></view>
 </block><view class="bottom-space"></view>
</view>
