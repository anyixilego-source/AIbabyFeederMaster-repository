@import "../../styles/report-page-header.wxss";
page{background:linear-gradient(160deg,#fff8f2 0,#fffcf9 58%,#fffaf6 100%);color:#3d302a}.page-shell{min-height:100vh;padding:18rpx 33rpx 0;box-sizing:border-box}.detail-nav-title{font-size:34rpx;font-weight:600;white-space:nowrap}.detail-nav-back{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:50%;background:#fff;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045)}.detail-nav-back>view{width:20rpx;height:20rpx;border-left:4rpx solid #3d302a;border-bottom:4rpx solid #3d302a;transform:rotate(45deg);margin-left:7rpx}.detail-mode-row{min-height:84rpx;gap:18rpx;margin-bottom:22rpx}.detail-date{color:#92847a;font-size:23rpx;line-height:1.6;flex:1;min-width:0}.detail-mode-row period-mode-switch{flex:none}
.card,.error-card,.loading-card{margin-bottom:25rpx;padding:34rpx;border:2rpx solid #f2eae3;border-radius:42rpx;background:#fffefd;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045);box-sizing:border-box}.error-card{color:#be7b6d;background:#fff0ec;font-size:23rpx;line-height:1.7}.loading-card{color:#92847a;text-align:center;font-size:23rpx}.review{padding:15rpx;background:#fff0cc;color:#82600f;font-size:23rpx;border-radius:15rpx;margin-bottom:18rpx}.section-title{display:flex;align-items:center;gap:15rpx;font-size:31rpx;font-weight:600;line-height:1.5;margin-bottom:25rpx}.detail-leaf-icon{width:35rpx;height:35rpx;flex:none;background:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjYmM5ODc3IiBzdHJva2Utd2lkdGg9IjEuNyIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNMjAgM0MzIDEgMiAxMiA3IDE3czE1LTEgMTMtMTR6IE00IDIyIDE3IDciLz48L3N2Zz4=") center/contain no-repeat}
.summary-main{display:flex;align-items:center;gap:46rpx;padding:15rpx 0 12rpx}.comparison-ring{position:relative;flex:none;width:192rpx;height:192rpx;border-radius:50%;background:#f4efe5;display:flex;align-items:center;justify-content:center}.comparison-ring-inner{width:157rpx;height:157rpx;border-radius:50%;background:#fffefd;display:flex;align-items:center;justify-content:center;flex-direction:column;padding:12rpx;box-sizing:border-box;text-align:center}.comparison-ring-number{display:flex;align-items:baseline;justify-content:center;gap:1rpx;font:600 49rpx/1.2 Arial,sans-serif;color:#7daa63;max-width:100%}.comparison-ring-unit{font-size:18rpx;color:#92847a;font-weight:400}.comparison-ring-caption{font-size:19rpx;color:#92847a;line-height:1.4;margin-top:10rpx}.comparison-ring.red .comparison-ring-number{color:#ca7974}.comparison-ring.yellow .comparison-ring-number{color:#bc934e}.comparison-ring.neutral .comparison-ring-number{font-weight:400;color:#a59787}.summary-copy{flex:1;min-width:0}.amount-line{display:flex;align-items:baseline;flex-wrap:wrap;gap:5rpx}.amount-value{font:400 39rpx/1.25 Arial,sans-serif;overflow-wrap:anywhere}.amount-value.with-reference{font-size:69rpx;font-weight:600;letter-spacing:-1.5rpx}.amount-unit{font-size:20rpx;line-height:1.6}.amount-caption{display:block;margin-top:13rpx;color:#92847a;font-size:23rpx;line-height:1.6}.reference-text{display:block;color:#92847a;font-size:20rpx;line-height:1.65;overflow-wrap:anywhere}.reference-source{display:block;color:#b19c88;font-size:18rpx;line-height:1.65;margin-top:9rpx;overflow-wrap:anywhere}.summary-data-note,.reference-range-note{display:block;color:#9f8973;font-size:20rpx;line-height:1.7;margin-top:14rpx;overflow-wrap:anywhere}
.source-table{margin-top:20rpx}.source-table-row{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.9fr) minmax(0,.85fr);gap:14rpx;align-items:center;padding:23rpx 0;border-bottom:2rpx solid #f1e8e0;font-size:21rpx;line-height:1.6}.source-table-head{color:#b09b88;font-size:21rpx;font-weight:400;padding:17rpx 0;border-color:#eaddd0}.source-table-name{display:flex;flex-direction:column;min-width:0;overflow-wrap:anywhere}.source-table-weight{color:#3d302a;overflow-wrap:anywhere}.source-table-percent{text-align:right;overflow-wrap:anywhere}.source-table-head>text:last-child{text-align:right}.food-note{display:block;color:#a09385;font-size:18rpx;margin-top:5rpx}.source-table-percent.unavailable{color:#a09385;font-size:20rpx}.source-empty{padding:30rpx 0 10rpx;font-size:23rpx;color:#92847a;text-align:center;line-height:1.7}
.detail-disclosure{padding:0 4rpx}.disclosure-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:91rpx;border-bottom:2rpx solid #f1e8e0;color:#bb8d56;font-size:23rpx;line-height:1.6}.disclosure-body{padding:16rpx 0 20rpx}.scope-note{display:block;margin:12rpx 0;font-size:22rpx;line-height:1.75;color:#92847a;overflow-wrap:anywhere}.explanation-title{display:block;margin-top:18rpx;font-size:23rpx;font-weight:600;line-height:1.6}.conclusion{display:block;font-size:23rpx;line-height:1.7;color:#92847a;padding:15rpx 0}.conclusion.danger{color:#be7b6d}.bottom-space{height:70rpx}
.ruler-wrap{margin:58rpx 10rpx 22rpx;position:relative}.marker-value{position:absolute;top:-42rpx;transform:translateX(-50%);font-size:20rpx;white-space:nowrap}.ruler{height:18rpx;position:relative;border-radius:9rpx;background:#f3ebe7}.ruler-fill{position:absolute;top:0;bottom:0;background:#ffe3a6}.range-boundary{position:absolute;top:-7rpx;width:3rpx;height:32rpx;transform:translateX(-50%);background:#c49a6b;border-radius:2rpx}.marker{position:absolute;top:-7rpx;width:14rpx;height:32rpx;transform:translateX(-50%);border-radius:7rpx;background:#c98b64}.ruler-labels{margin-top:12rpx;position:relative;height:34rpx;line-height:34rpx;color:#92847a;font-size:21rpx}.range-tick{position:absolute;top:0;transform:translateX(-50%);text-align:center;white-space:nowrap}.range-tick-value{display:block;font-size:21rpx;font-weight:400}.ruler-end{position:absolute;top:0}.ruler-end.first{left:0}.ruler-end.last{right:0}.marker.informational{width:8rpx;border-radius:4rpx;background:#958574;box-shadow:none}.marker-value.at-start{transform:none}.marker-value.at-end{transform:translateX(-100%)}
@media(max-width:360px){.summary-main{gap:26rpx}.comparison-ring{width:176rpx;height:176rpx}.comparison-ring-inner{width:143rpx;height:143rpx}.amount-value.with-reference{font-size:62rpx}}

.comparison-ring-number.long{font-size:34rpx}.comparison-ring-number.very-long{font-size:26rpx}.comparison-ring-number>text:first-child{min-width:0;overflow-wrap:anywhere}.comparison-ring-unit{flex:none}

.tabs{display:flex;gap:12rpx;margin:0 0 19rpx}.tab{flex:1;min-width:0;text-align:center;font-size:20rpx;white-space:nowrap;border:2rpx solid #f0e6de;border-radius:20rpx;padding:17rpx 3rpx;line-height:1.5;box-sizing:border-box;background:#fffcf9}.tab.active{background:#fff0e6;border-color:#f5d3bc;color:#b77d55}.nutrient-options{width:100%;margin-bottom:21rpx;white-space:nowrap}.nutrient-options-row{display:inline-flex;gap:12rpx;padding:3rpx 0}.nutrient-option{display:inline-flex;align-items:center;min-height:54rpx;padding:0 22rpx;border-radius:40rpx;color:#92847a;background:#f6f2ec;font-size:21rpx;box-sizing:border-box}.nutrient-option.active{background:#f7e1cc;color:#ad7448}
