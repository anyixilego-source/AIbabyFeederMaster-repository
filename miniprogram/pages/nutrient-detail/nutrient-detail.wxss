page { background: #fff9f3; color: #2f1f1d; }
.page-shell { min-height: 100vh; padding: 12rpx 28rpx 0; box-sizing: border-box; background: linear-gradient(180deg, #fff9f3 0%, #fffdfb 60%, #fff 100%); }
.summary-card, .reference-card, .about-card, .error-card, .loading-card { margin-top: 18rpx; padding: 28rpx; border: 1rpx solid #f3e2d9; border-radius: 30rpx; background: rgba(255,255,255,.97); box-shadow: 0 12rpx 30rpx rgba(128,79,54,.055); }
.error-card { color: #b3454a; background: #fff2f2; }
.loading-card { color: #858a99; text-align: center; }
.summary-top { position: relative; min-height: 164rpx; display: flex; align-items: center; overflow: hidden; }
.nutrient-badge { flex: 0 0 auto; width: 112rpx; height: 112rpx; border: 14rpx solid #ffe8e4; border-radius: 70rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#ff7479,#ff5665); font-size: 48rpx; font-weight: 800; }
.summary-copy { margin-left: 24rpx; z-index: 2; display: flex; flex-direction: column; }
.nutrient-name { font-size: 35rpx; font-weight: 800; }
.amount-line { display: flex; align-items: baseline; gap: 9rpx; }
.amount-value { font-size: 46rpx; font-weight: 900; }
.amount-unit { font-size: 26rpx; font-weight: 700; }
.source-count { margin-top: 7rpx; color: #a45e5b; font-size: 23rpx; }
.baby-image { position: absolute; right: -22rpx; bottom: -15rpx; width: 175rpx; height: 175rpx; border-radius: 88rpx; opacity: .94; }
.source-progress { margin: 20rpx 8rpx 18rpx; height: 26rpx; display: flex; overflow: hidden; background: #f5ebe6; border-radius: 13rpx; }
.source-progress-part:nth-child(1) { background: #ff6470; }
.source-progress-part:nth-child(2) { background: #ff9a84; }
.source-progress-part:nth-child(3) { background: #ffc0a8; }
.source-progress-part:nth-child(n+4) { background: #ffe1d3; }
.source-grid { display: flex; overflow-x: auto; padding: 3rpx 0; }
.source-item { flex: 0 0 30%; min-width: 158rpx; padding: 5rpx 12rpx; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
.source-item + .source-item { border-left: 1rpx solid #f1e3dc; }
.food-badge { width: 80rpx; height: 80rpx; border-radius: 40rpx; display: flex; align-items: center; justify-content: center; color: #ff5d68; background: #fff0ed; font-size: 31rpx; font-weight: 800; }
.food-name { margin-top: 8rpx; font-size: 26rpx; font-weight: 800; }
.food-value { margin-top: 4rpx; color: #a05d5a; font-size: 20rpx; white-space: nowrap; }
.food-percent { margin-top: 6rpx; padding: 4rpx 18rpx; border-radius: 18rpx; color: #ff5966; background: #fff0ed; font-size: 23rpx; font-weight: 700; }
.source-empty { padding: 28rpx 0 10rpx; color: #858a99; text-align: center; font-size: 24rpx; }
.section-title, .about-heading { font-size: 32rpx; font-weight: 800; }
.reference-note { margin-top: 20rpx; padding: 20rpx; display: flex; align-items: center; gap: 18rpx; background: linear-gradient(90deg,#fff3ec,#fff7f1); border-radius: 22rpx; }
.reference-icon { width: 70rpx; height: 70rpx; border-radius: 35rpx; display: flex; align-items: center; justify-content: center; color: #ff5c68; background: #ffe6e1; font-size: 34rpx; }
.reference-main, .reference-sub { display: block; }
.reference-main { font-size: 24rpx; font-weight: 700; }
.reference-sub { margin-top: 5rpx; color: #8e7773; font-size: 20rpx; }
.reference-text { display: block; margin-top: 22rpx; font-size: 25rpx; font-weight: 700; }
.ruler-wrap { margin: 48rpx 10rpx 22rpx; position: relative; }
.marker-value { position: absolute; top: -42rpx; transform: translateX(-50%); font-size: 20rpx; font-weight: 800; white-space: nowrap; }
.ruler { height: 22rpx; position: relative; border-radius: 11rpx; background: #f3ebe7; }
.ruler-fill { position: absolute; left: 25%; right: 25%; top: 0; bottom: 0; background: linear-gradient(90deg,#ffe1d8,#ffb7aa); }
.range-boundary { position: absolute; top: -8rpx; width: 3rpx; height: 38rpx; transform: translateX(-50%); background: #f77b61; border-radius: 2rpx; }
.marker { position: absolute; top: -8rpx; width: 18rpx; height: 38rpx; transform: translateX(-50%); border-radius: 9rpx; background: #ff656b; box-shadow: 0 4rpx 10rpx rgba(255,101,107,.3); }
.ruler-labels { margin-top: 12rpx; position:relative; height:34rpx; line-height:34rpx; color: #8a7774; font-size: 23rpx; }
.conclusion { margin-top: 25rpx; min-height: 78rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 20rpx; background: #fff8f4; font-size: 25rpx; font-weight: 800; }
.conclusion.warn { color: #8b3b35; background: #fff2ec; }
.conclusion.danger { color: #b94b50; background: #fff0f1; }
.conclusion.good { color: #15835a; background: #eaf8f1; }
.conclusion-left { display: flex; align-items: center; gap: 14rpx; }
.alert-icon { width: 44rpx; height: 44rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #ff666d; }
.expand-arrow { flex: 0 0 auto; width: 15rpx; height: 15rpx; margin-right: 7rpx; border-top: 4rpx solid #626a79; border-right: 4rpx solid #626a79; transform: rotate(45deg); }
.expand-arrow.expanded { margin-top: 8rpx; transform: rotate(-45deg); }
.explanation { padding: 22rpx 10rpx 5rpx; display: flex; flex-direction: column; gap: 9rpx; }
.explanation-title { font-size: 24rpx; font-weight: 800; }
.suggestion-title { margin-top: 12rpx; }
.explanation-item { color: #6f7586; font-size: 22rpx; line-height: 1.55; }
.about-heading { display: flex; justify-content: space-between; align-items: center; }
.about-body { margin-top: 18rpx; padding: 20rpx; display: flex; flex-direction: column; gap: 12rpx; color: #6f5b55; background: #fff8e7; border-radius: 20rpx; font-size: 22rpx; line-height: 1.55; }
.bottom-space { height: 70rpx; }

.scope-note{display:block;font-size:24rpx;line-height:1.65;color:#6d6661;margin:18rpx 6rpx;overflow-wrap:anywhere}

.summary-card,.reference-card,.about-card{border-radius:24rpx;box-shadow:0 8rpx 25rpx #795b3610}.summary-top{min-height:140rpx}.review{padding:15rpx;background:#fff0cc;color:#82600f;font-size:23rpx;border-radius:15rpx}.missing-source{font-size:24rpx;color:#887d73;padding:18rpx 0;border-top:1rpx dashed #e9dfd5}.source-grid{grid-template-columns:repeat(2,1fr)}

.source-grid{display:flex;flex-wrap:wrap;overflow:visible}.source-item{flex:0 0 50%;min-width:0;padding:16rpx 14rpx;border-left:0!important}.source-item:nth-child(2n){border-left:1rpx solid #f1e3dc!important}.source-item:nth-child(n+3){margin-top:12rpx}.food-name{line-height:1.45;text-align:center;overflow-wrap:anywhere}.unavailable .food-badge{background:#f1eeea;color:#8b8078}.food-percent.unavailable{background:#f1eeea;color:#776c65}.recorded-weight{font-size:24rpx;color:#796b60}.food-note{font-size:22rpx;color:#796b60;margin-top:6rpx}.range-tick{position:absolute;top:0;transform:translateX(-50%);text-align:center;white-space:nowrap}.range-tick-value{display:block;font-weight:400;font-size:23rpx;color:#8a7774}

.ruler-end{position:absolute;top:0}.ruler-end.first{left:0}.ruler-end.last{right:0}.marker.informational{width:9rpx;border-radius:4rpx;background:#796b60;box-shadow:none}.marker-value.at-start{transform:none}.marker-value.at-end{transform:translateX(-100%)}
.source-table{margin-top:22rpx}.source-table-row{display:grid;grid-template-columns:minmax(0,1fr) 158rpx 134rpx;gap:14rpx;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #f2e9e2;font-size:25rpx;line-height:1.5}.source-table-row:last-child{border-bottom:0}.source-table-head{font-size:22rpx;color:#968478;padding:16rpx 0}.source-table-head text:nth-child(n+2),.source-table-weight,.source-table-percent{text-align:right}.source-table-name{min-width:0;overflow-wrap:break-word;display:flex;flex-direction:column}.source-table-name .food-note{margin-top:4rpx;font-size:21rpx}.source-table-weight{color:#817369;overflow-wrap:break-word}.source-table-percent{color:#a97752;font-weight:600}.source-table-percent.unavailable{color:#9b9189;font-weight:400;font-size:23rpx}@media(max-width:360px){.source-table-row{grid-template-columns:minmax(0,1fr) 134rpx 126rpx;gap:10rpx;font-size:24rpx}}
