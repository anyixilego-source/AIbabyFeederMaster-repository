page { background: #fffaf7; color: #171722; }
.page-shell { min-height: 100vh; padding: 12rpx 28rpx 0; box-sizing: border-box; background: linear-gradient(180deg, #fffaf7 0%, #fff 60%); }
.summary-card, .reference-card, .about-card, .error-card, .loading-card { margin-top: 18rpx; padding: 28rpx; border: 1rpx solid #f1e8e3; border-radius: 30rpx; background: rgba(255,255,255,.97); box-shadow: 0 12rpx 30rpx rgba(90,65,51,.05); }
.error-card { color: #b3454a; background: #fff2f2; }
.loading-card { color: #858a99; text-align: center; }
.summary-top { position: relative; min-height: 164rpx; display: flex; align-items: center; overflow: hidden; }
.nutrient-badge { flex: 0 0 auto; width: 112rpx; height: 112rpx; border: 14rpx solid #e6f8fc; border-radius: 70rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#28c9da,#17a8d7); font-size: 48rpx; font-weight: 800; }
.summary-copy { margin-left: 24rpx; z-index: 2; display: flex; flex-direction: column; }
.nutrient-name { font-size: 35rpx; font-weight: 800; }
.amount-line { display: flex; align-items: baseline; gap: 9rpx; }
.amount-value { font-size: 46rpx; font-weight: 900; }
.amount-unit { font-size: 26rpx; font-weight: 700; }
.source-count { margin-top: 7rpx; color: #7c8293; font-size: 23rpx; }
.baby-image { position: absolute; right: -22rpx; bottom: -15rpx; width: 175rpx; height: 175rpx; border-radius: 88rpx; opacity: .94; }
.source-progress { margin: 20rpx 8rpx 18rpx; height: 26rpx; display: flex; overflow: hidden; background: #eff0f2; border-radius: 13rpx; }
.source-progress-part:nth-child(1) { background: #20bfd7; }
.source-progress-part:nth-child(2) { background: #56c9eb; }
.source-progress-part:nth-child(3) { background: #9bdff1; }
.source-progress-part:nth-child(n+4) { background: #cceff6; }
.source-grid { display: flex; overflow-x: auto; padding: 3rpx 0; }
.source-item { flex: 0 0 30%; min-width: 158rpx; padding: 5rpx 12rpx; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
.source-item + .source-item { border-left: 1rpx solid #eeeeef; }
.food-badge { width: 80rpx; height: 80rpx; border-radius: 40rpx; display: flex; align-items: center; justify-content: center; color: #1c8fc7; background: #eaf8ff; font-size: 31rpx; font-weight: 800; }
.food-name { margin-top: 8rpx; font-size: 26rpx; font-weight: 800; }
.food-value { margin-top: 4rpx; color: #7c8293; font-size: 20rpx; white-space: nowrap; }
.food-percent { margin-top: 6rpx; padding: 4rpx 18rpx; border-radius: 18rpx; color: #167dcb; background: #eaf6ff; font-size: 23rpx; font-weight: 700; }
.source-empty { padding: 28rpx 0 10rpx; color: #858a99; text-align: center; font-size: 24rpx; }
.section-title, .about-heading { font-size: 32rpx; font-weight: 800; }
.reference-note { margin-top: 20rpx; padding: 20rpx; display: flex; align-items: center; gap: 18rpx; background: linear-gradient(90deg,#eef9ff,#f4fbff); border-radius: 22rpx; }
.reference-icon { width: 70rpx; height: 70rpx; border-radius: 35rpx; display: flex; align-items: center; justify-content: center; color: #269bdc; background: #ddf3ff; font-size: 34rpx; }
.reference-main, .reference-sub { display: block; }
.reference-main { font-size: 24rpx; font-weight: 700; }
.reference-sub { margin-top: 5rpx; color: #7b8294; font-size: 20rpx; }
.reference-text { display: block; margin-top: 22rpx; font-size: 25rpx; font-weight: 700; }
.ruler-wrap { margin: 48rpx 10rpx 22rpx; position: relative; }
.marker-value { position: absolute; top: -42rpx; transform: translateX(-50%); font-size: 20rpx; font-weight: 800; white-space: nowrap; }
.ruler { height: 22rpx; position: relative; border-radius: 11rpx; background: #eceef1; }
.ruler-fill { position: absolute; left: 25%; right: 25%; top: 0; bottom: 0; background: linear-gradient(90deg,#c8efff,#7cccf0); }
.marker { position: absolute; top: -8rpx; width: 18rpx; height: 38rpx; transform: translateX(-50%); border-radius: 9rpx; background: #ff656b; box-shadow: 0 4rpx 10rpx rgba(255,101,107,.3); }
.ruler-labels { margin-top: 8rpx; display: flex; justify-content: space-between; color: #7d8293; font-size: 20rpx; }
.conclusion { margin-top: 25rpx; min-height: 78rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 20rpx; background: #faf8f7; font-size: 25rpx; font-weight: 800; }
.conclusion.warn { color: #a65c16; background: #fff5e7; }
.conclusion.danger { color: #b94b50; background: #fff0f1; }
.conclusion.good { color: #15835a; background: #eaf8f1; }
.conclusion-left { display: flex; align-items: center; gap: 14rpx; }
.alert-icon { width: 44rpx; height: 44rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #ff666d; }
.expand-icon { color: #858b9a; font-size: 40rpx; font-weight: 400; }
.explanation { padding: 22rpx 10rpx 5rpx; display: flex; flex-direction: column; gap: 9rpx; }
.explanation-title { font-size: 24rpx; font-weight: 800; }
.suggestion-title { margin-top: 12rpx; }
.explanation-item { color: #6f7586; font-size: 22rpx; line-height: 1.55; }
.about-heading { display: flex; justify-content: space-between; }
.about-body { margin-top: 18rpx; padding: 20rpx; display: flex; flex-direction: column; gap: 12rpx; color: #647086; background: #eff9ff; border-radius: 20rpx; font-size: 22rpx; line-height: 1.55; }
.bottom-space { height: 70rpx; }
