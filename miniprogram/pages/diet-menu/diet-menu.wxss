@import "../../styles/diet-recipe.wxss";
.condition-error{display:block;color:#b64e43;font-size:26rpx;line-height:1.6;margin-top:16rpx;overflow-wrap:break-word}
/* Waiting animation, not a measured completion percentage. Removed with the running card. */
.menu-progress-track{height:12rpx;margin:20rpx 0 18rpx;border-radius:12rpx;background:#f5e5da;overflow:hidden}.menu-progress-fill{height:100%;width:6%;border-radius:inherit;background:linear-gradient(90deg,#e7b184,#ce7569);position:relative;overflow:hidden;animation:menu-wait-fill 8s linear forwards}.menu-progress-shimmer{position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);animation:menu-wait-shimmer 1.8s ease-in-out infinite}@keyframes menu-wait-fill{0%{width:6%}50%{width:55%}100%{width:96%}}@keyframes menu-wait-shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}

/* DAY only: the date selector and other menu modes keep their original styles. */
.back.day-nav-back{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;padding:0;border-radius:50%;background:#fff;font-size:0;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045)}.back.day-nav-back::after{content:"";width:20rpx;height:20rpx;border-left:4rpx solid #3d302a;border-bottom:4rpx solid #3d302a;transform:rotate(45deg);margin-left:7rpx}
.day-menu-card{margin:24rpx 5rpx;padding:34rpx;border:2rpx solid #f2eae3;border-radius:42rpx;background:#fffefd;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045);box-sizing:border-box}.day-meal-heading{display:flex;align-items:center;gap:14rpx;font-size:27rpx;font-weight:600;color:#3d302a;line-height:1.5;margin-bottom:23rpx}.day-meal-icon{width:36rpx;height:36rpx;flex:none;background:center/contain no-repeat}.day-meal-icon.sun{background-image:url("data:image/svg+xml;base64,")}.day-meal-icon.moon{background-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjM2QzMDJhIiBzdHJva2Utd2lkdGg9IjEuNyIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNMjAgMTVBOSA5IDAgMCAxIDkgM2E5IDkgMCAxIDAgMTEgMTJ6Ii8+PC9zdmc+")}
.day-dish-row{display:flex;align-items:center;gap:22rpx;min-width:0}.day-dish-row+.day-dish-row{margin-top:25rpx;padding-top:25rpx;border-top:2rpx solid #f1e8e0}.day-dish-image{width:129rpx;height:129rpx;border-radius:30rpx;flex:none;background:#fff0e7}.day-dish-copy{flex:1;min-width:0}.day-dish-name{display:block;font-size:27rpx;font-weight:600;line-height:1.5;color:#3d302a;overflow-wrap:anywhere}.day-dish-description{display:block;font-size:23rpx;line-height:1.65;color:#92847a;margin-top:7rpx;overflow-wrap:anywhere}.day-dish-time{display:inline-block;font-size:19rpx;line-height:1.5;color:#c59b57;background:#fff4dc;border-radius:14rpx;padding:5rpx 12rpx;margin-top:10rpx;max-width:100%;box-sizing:border-box}.day-dish-arrow{flex:none;font-size:34rpx;color:#bd9e86;line-height:1.4}
button.day-menu-return{display:flex;align-items:center;justify-content:center;width:calc(100% - 10rpx);min-height:92rpx;box-sizing:border-box;margin:25rpx 5rpx 0;padding:20rpx 22rpx;border-radius:33rpx;font-size:29rpx;font-weight:600;line-height:1.5;background:#fff0e9;color:#bd805c}.recipe-function-info.day-menu-info{margin:15rpx 5rpx 0;padding:0 4rpx}.day-menu-info .recipe-function-info-toggle{justify-content:space-between;min-height:91rpx;color:#bb956b;font-size:23rpx;border-bottom:2rpx solid #f1e8e0;gap:16rpx}.day-menu-info .risk{font-size:21rpx;line-height:1.75;color:#92847a;margin-top:18rpx}

.back.recipe-nav-back{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;padding:0;border-radius:50%;background:#fff;font-size:0;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045)}.back.recipe-nav-back::after{content:"";width:20rpx;height:20rpx;border-left:4rpx solid #3d302a;border-bottom:4rpx solid #3d302a;transform:rotate(45deg);margin-left:7rpx}

/* Profile dietary conditions only. Other menu modes retain their styles. */
.my-settings-shell{padding:18rpx 33rpx 55rpx;color:#3d302a}.my-settings-shell .conditions{margin-top:0;padding:34rpx;border:2rpx solid #f1e8e0;border-radius:42rpx;background:#fffefd;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045)}.my-settings-shell .title{font-size:31rpx;font-weight:600;line-height:1.5}.my-settings-shell .conditions-heading{margin-bottom:28rpx}.my-settings-shell .conditions-cancel{color:#bc956b;font-size:21rpx;padding:10rpx 0 10rpx 16rpx}.my-settings-shell .section{font-size:23rpx;color:#7b6a5b;line-height:1.6;margin:26rpx 0 15rpx}.my-settings-shell .choices{gap:16rpx}.my-settings-shell .choices button{border:2rpx solid #eee0d4;border-radius:23rpx;background:#faf4ee;color:#3d302a;font-size:23rpx;line-height:1.5;padding:19rpx 8rpx;min-height:78rpx}.my-settings-shell .choices button.active{background:#ffede3!important;border-color:#f3c6b1;color:#be805c!important}.my-settings-shell textarea{font-size:25rpx;line-height:1.8;padding:23rpx;border:2rpx solid #eee0d4;border-radius:23rpx;background:#fffdfa;height:160rpx}.my-settings-shell button.primary{font-size:29rpx;font-weight:600;background:linear-gradient(110deg,#ff8a7e,#ff7577);color:#fff;border-radius:33rpx;min-height:92rpx}.my-settings-shell #cancel-menu-generation{font-size:25rpx;color:#bd805c;background:#fff0e9;border-radius:33rpx}.my-settings-shell .recipe-function-info-toggle{justify-content:space-between;border-bottom:2rpx solid #f1e8e0;min-height:91rpx;color:#bc956b;font-size:23rpx}.my-settings-shell .risk{font-size:21rpx;line-height:1.8;color:#92847a}

.menu-source-label{display:block;margin:14rpx 0 24rpx;padding:18rpx 22rpx;border-radius:18rpx;background:#f8eee3;color:#946b4b;font-size:24rpx;line-height:1.6}.staple-choices{flex-wrap:wrap}.staple-choices button{flex:none;min-width:130rpx}.menu-sharing-entry{margin:20rpx 32rpx 40rpx}.menu-sharing-entry button{background:#f8eee3;color:#946b4b;font-size:28rpx;border-radius:24rpx}.menu-share-overlay{position:fixed;inset:0;background:rgba(55,40,31,.35);display:flex;align-items:flex-end;z-index:120}.menu-share-panel{box-sizing:border-box;width:100%;max-height:80vh;overflow:auto;padding:36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));background:#fffcf8;border-radius:36rpx 36rpx 0 0}.menu-share-heading{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:600}.menu-share-heading button,.menu-share-existing button{margin:0;width:auto;font-size:25rpx;color:#aa7c5d;background:transparent}.menu-share-existing{display:flex;align-items:center;justify-content:space-between;color:#8c8177;font-size:24rpx;margin-top:18rpx}

.conditions .staple-choices{display:flex;flex-direction:row;flex-wrap:wrap;gap:12rpx}.conditions .staple-choices button{box-sizing:border-box;flex:0 0 calc(50% - 6rpx);width:calc(50% - 6rpx);margin:0;min-width:0;font-size:25rpx;line-height:1.5;padding:20rpx 10rpx;min-height:76rpx}
