@import "../../styles/diet-recipe.wxss";
.condition-error{display:block;color:#b64e43;font-size:26rpx;line-height:1.6;margin-top:16rpx;overflow-wrap:break-word}
/* Waiting animation, not a measured completion percentage. Removed with the running card. */
.menu-progress-track{height:12rpx;margin:20rpx 0 18rpx;border-radius:12rpx;background:#f5e5da;overflow:hidden}.menu-progress-fill{height:100%;width:6%;border-radius:inherit;background:linear-gradient(90deg,#e7b184,#ce7569);position:relative;overflow:hidden;animation:menu-wait-fill 8s linear forwards}.menu-progress-shimmer{position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);animation:menu-wait-shimmer 1.8s ease-in-out infinite}@keyframes menu-wait-fill{0%{width:6%}50%{width:55%}100%{width:96%}}@keyframes menu-wait-shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
