<navigation-bar title="{{settingsOnly?'饮食推荐条件':'饮食推荐'}}" back="{{false}}" color="#332724" background="transparent"><view slot="left" class="back" bindtap="goBack">‹</view></navigation-bar>
<view class="shell {{mode==='RECIPE'?'recipe-shell':''}}"><text wx:if="{{reviewLabel}}" class="note">{{reviewLabel}} · 非实际喂养验收</text><view wx:if="{{mode==='RECIPE'}}" class="recipe-heading"><view class="recipe-heading-copy"><text class="recipe-plan-title">{{babyName}}的7天搭配</text><text class="recipe-range">{{range || '按生成时明日起连续7天安排'}}</text></view><view class="ai-menu-tag"><view class="ai-menu-sparkle" aria-hidden="true"/><text>AI精选</text></view></view><block wx:else><view class="heading">{{settingsOnly?'饮食推荐条件':babyName+'的7天搭配'}}<view wx:if="{{!settingsOnly}}" class="ai-menu-tag"><view class="ai-menu-sparkle" aria-hidden="true"/><text>AI精选</text></view></view><text wx:if="{{!settingsOnly}}" class="note">{{range || '按生成时明日起连续7天安排'}}</text></block><text wx:if="{{loading}}" class="note">正在加载…</text><view wx:if="{{errorMessage}}" id="menu-error" class="error">{{errorMessage}}<button bindtap="reloadState">更新状态</button></view><view wx:if="{{running}}" id="menu-running" class="card"><text class="title">菜单正在生成</text><text class="note">可以返回报告，任务继续进行；已有菜单保留。派发后失败也计入今日次数。</text></view>
<block wx:if="{{mode==='WEEK'}}"><view wx:if="{{hasMenu}}" class="card"><text class="note">{{focusText}}</text><view wx:for="{{days}}" wx:key="date" id="menu-day-{{index}}" class="day-row" data-index="{{index}}" bindtap="openDay"><text class="date">{{item.label}}</text><view class="day-copy"><text>{{item.firstLine}}</text><text wx:if="{{item.secondLine}}">{{item.secondLine}}</text></view><text class="menu-row-arrow">›</text></view></view><view wx:else class="card"><text class="title">下一步怎么搭配</text><text class="note">先核对能接受的形态和需避开食材，再结合当前近7日记录生成候选菜单。</text></view><button wx:if="{{!showPreferences}}" id="menu-conditions" bindtap="menuAction" disabled="{{running || loading || savingPreferences}}">{{hasMenu?'更换菜单':'生成菜单'}}</button></block>
<block wx:elif="{{mode==='DAY' && currentDay}}"><scroll-view scroll-x class="day-tabs"><view wx:for="{{days}}" wx:key="date" class="day-tab {{dayIndex===index?'active':''}}" data-index="{{index}}" bindtap="selectDay">{{item.label}}</view></scroll-view><view class="card"><text class="title">{{currentDay.date}} · 当日菜单</text><view wx:for="{{currentDay.meals}}" wx:key="slot" class="meal-row"><text class="meal-label">{{item.label}}</text><view class="meal-copy"><view wx:for="{{item.recipes}}" wx:for-item="dish" wx:key="key" class="recipe-link" data-key="{{dish.key}}" bindtap="openRecipe"><text class="recipe-name">{{dish.name}}</text><text class="menu-row-arrow">›</text></view></view></view></view><button id="back-week" bindtap="backWeek">返回7日总览</button></block>
<block wx:elif="{{mode==='RECIPE' && recipe}}">
  <include src="../../templates/diet-recipe.wxml"/>
  <button id="back-day" class="recipe-return" style="width:100%" bindtap="backDay"><text class="recipe-return-arrow">←</text>返回当日菜单</button>
</block>
<view wx:if="{{showPreferences}}" id="menu-preferences" class="card conditions"><view class="conditions-heading"><text class="title">{{settingsOnly?'推荐条件':'生成前核对'}}</text><text id="close-menu-preferences" class="conditions-cancel" bindtap="closePreferences">{{settingsOnly?'关闭 ×':'暂不生成 ×'}}</text></view><text wx:if="{{settingsSaved}}" id="settings-saved-status" class="note">{{conditionsConfirmed?'信息已确认':'条件已保存，可继续修改'}}</text><text class="section">需避开的食材</text><view class="choices"><button class="{{avoidance==='NONE'?'active':''}}" data-value="NONE" bindtap="setAvoidance">已确认暂无</button><button class="{{avoidance==='KNOWN'?'active':''}}" data-value="KNOWN" bindtap="setAvoidance">有需避开食材</button></view><textarea wx:if="{{avoidance==='KNOWN'}}" id="avoid-ingredients" maxlength="500" value="{{avoidText}}" bindinput="onAvoid" placeholder="例如：蛋、奶。用顿号或逗号分隔"/><text class="note">不清楚适用性时请先核对，不按“暂无”处理；家庭已有回避条件仍会加入校验。</text><text class="section">目前能接受的食物形态</text><view class="choices"><button class="{{texture==='PUREE'?'active':''}}" data-value="PUREE" bindtap="setTexture">细泥</button><button class="{{texture==='MASHED'?'active':''}}" data-value="MASHED" bindtap="setTexture">压碎</button><button class="{{texture==='SOFT'?'active':''}}" data-value="SOFT" bindtap="setTexture">软小块</button></view><view class="check" bindtap="toggleMedical"><text>{{medicalDiet?'☑':'□'}}</text>存在特殊医学饮食或严重喂养困难</view><view wx:if="{{!settingsOnly}}" id="menu-consent" class="check" bindtap="toggleConsent"><text>{{consented?'☑':'□'}}</text>我同意向现有DeepSeek服务发送计划日期对应月龄、记录汇总及回避／形态条件，用于生成候选菜单。</view><text class="note">{{settingsOnly?'点击保存条件只保存本账号当前宝宝的设置，不调用AI或扣次数。':'点击确认信息保存以上条件，并表示同意本次菜单资料处理，系统会勾选同意；不会生成菜单或扣次。'}}不发送宝宝姓名、出生日期、照片或反馈资料。派发失败计次，30秒内不重复发起。</text><button id="generate-menu" class="primary" loading="{{savingPreferences}}" bindtap="menuAction" disabled="{{running || loading || savingPreferences}}">{{settingsOnly?'保存条件':conditionsConfirmed?(hasMenu?'更换菜单':'生成菜单'):'确认信息'}}</button><button id="cancel-menu-generation" bindtap="closePreferences" disabled="{{running || loading || savingPreferences}}">{{settingsOnly?'返回我的':'暂不生成'}}</button></view><view wx:if="{{mode==='RECIPE'}}" class="recipe-function-info"><view id="recipe-function-info-toggle" class="recipe-function-info-toggle" bindtap="toggleRecipeInfo" role="button" aria-label="功能说明" aria-expanded="{{showRecipeInfo}}"><text>功能说明</text></view><view wx:if="{{showRecipeInfo}}" id="recipe-function-info-details"><text id="recipe-image-disclosure" class="risk">进入食谱详情即自动加载或生成AI示意图，新图仅向{{imageProviderLabel}}发送菜名、原料名称与熟制形态描述，不发送宝宝资料或克数；AI图仅作示意，非实物照片。新图每日100次，自动重试的每次派发也计次；失败按3、5、10秒最多自动重试3次，仍受服务限流约束。生成成功的图片会保存到共享库，相同菜品最多保留3张，默认优先展示累计赞数较高的图片。“重新生成”前两次优先切换未看过的缓存图，第3次起生成新图；缓存不足时才提前生成。缓存查看和换图不扣次，点赞只评价当前图片，收藏单独保存当前宝宝的菜品兴趣。</text><text id="recipe-menu-risk" class="risk">{{risk}}</text></view></view><text wx:elif="{{!settingsOnly}}" class="risk">{{risk}}</text></view>

<view wx:if="{{showImageViewer && imagePath}}" id="recipe-image-viewer" class="image-viewer" style="padding-top:{{viewerTopInset}}px"><view class="viewer-heading"><text id="image-viewer-recipe-name" class="viewer-recipe-name">{{recipe.name}}</text><view id="close-image-viewer" class="viewer-close" bindtap="closeImageViewer" role="button" aria-label="关闭图片"><image id="close-image-viewer-icon" class="viewer-close-icon" src="/assets/menu-close-image-v1.png" mode="aspectFit" aria-hidden="true"/></view></view><view class="viewer-body"><view id="fullscreen-image-transform" class="viewer-movable" bindtouchstart="onViewerTouchStart" catchtouchmove="onViewerTouchMove" bindtouchend="onViewerTouchEnd" bindtouchcancel="onViewerTouchCancel"><image id="fullscreen-recipe-image" class="viewer-image" catchtap="onViewerImageTap" style="transform:translate({{viewerX}}px, {{viewerY}}px) scale({{viewerScale}})" src="{{imagePath}}" mode="aspectFit"/></view></view><text wx:if="{{imageGenerating || imageStatus==='FAILED'}}" class="viewer-message">{{imageMessage}}</text><text class="viewer-disclosure">AI生成，仅供参考，不代表实际食材、份量或营养。</text><view class="viewer-actions"><view id="save-recipe-image" class="viewer-action {{imageActionBusy?'unavailable':''}}" bindtap="saveRecipeImage" role="button" aria-label="保存图片"><view class="viewer-action-icon-slot"><image id="save-recipe-image-icon" class="viewer-action-image" src="/assets/menu-save-image-v1.png" mode="aspectFit" aria-hidden="true"/></view><text id="save-recipe-image-label" class="viewer-action-label">保存图片</text></view><view id="regenerate-recipe-image" class="viewer-action {{imageGenerating || imageActionBusy?'unavailable':''}}" bindtap="retryImage" role="button" aria-label="重新生成图片"><view class="viewer-action-icon-slot"><image id="regenerate-recipe-image-icon" class="viewer-action-image viewer-regenerate-image" src="/assets/menu-regenerate-image-v1.png" mode="aspectFit" aria-hidden="true"/></view><text id="regenerate-recipe-image-label" class="viewer-action-label">{{imageGenerating?'生成中':'重新生成'}}</text></view><view id="collect-recipe" class="viewer-action {{imageActionBusy?'unavailable':''}}" bindtap="collectRecipe" role="button" aria-label="{{recipeCollected?'取消收藏菜品':'收藏菜品'}}"><view class="viewer-action-icon-slot"><image id="collect-recipe-icon" class="viewer-collection-image" src="{{recipeCollected?'/assets/menu-collection-yellow-v1.png':'/assets/menu-collection-white-v1.png'}}" mode="aspectFit"/></view><text class="viewer-action-label">{{recipeCollected?'已收藏':'收藏'}}</text></view><view id="like-recipe-image" class="viewer-action {{imageLiked?'liked':''}} {{imageActionBusy?'unavailable':''}}" bindtap="likeRecipeImage" role="button" aria-label="{{imageLiked?'取消点赞':'点赞图片'}}"><view class="viewer-action-icon-slot viewer-like-slot"><image id="like-recipe-image-icon" class="viewer-action-image" src="{{imageLiked?'/assets/menu-liked-image-v2.png':'/assets/menu-like-image-v2.png'}}" mode="aspectFit" aria-hidden="true"/></view><text id="viewer-image-like-count" class="viewer-action-label viewer-like-count">{{imageLikeCount}}</text></view></view></view>
