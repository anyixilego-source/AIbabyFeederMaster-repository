<navigation-bar title="饮食记录" back="{{false}}" color="#2d2623" background="transparent"><view slot="left" class="nav-circle" bindtap="goBack"><view class="back-icon"></view></view><view slot="right" class="report-shortcut" bindtap="openReport"><view class="mini-report"><view></view></view></view></navigation-bar>
<scroll-view class="records-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="page-shell records-page">
  <view wx:if="{{saved}}" class="saved-banner"><view class="saved-check"><view class="check-icon"></view></view><text>本餐已保存到今日记录</text><view class="saved-close" bindtap="closeSaved"><view></view></view></view>
  <view class="date-header"><picker mode="date" value="{{selectedDate}}" end="{{todayDate}}" bindchange="changeDate"><view class="month-row"><text>{{selectedDateLabel}}</text><view class="month-drop"></view></view></picker><view class="date-grid"><view class="date-cell {{item.active ? 'active' : ''}}" wx:for="{{dates}}" wx:key="date" bindtap="chooseDate" data-date="{{item.date}}"><text>{{item.week}}</text><view class="day-number">{{item.day}}</view></view></view></view>
  <view wx:if="{{loading}}" class="records-state ui-card"><view class="state-spinner"></view><text class="state-title">正在读取饮食记录</text><text class="state-desc">请稍候</text></view>
  <view wx:elif="{{errorMessage}}" class="records-state ui-card"><view class="state-symbol error">!</view><text class="state-title">记录暂时无法加载</text><text class="state-desc">{{errorMessage}}</text><button bindtap="retryLoad">重新加载</button></view>
  <view class="meal-list"><view class="meal-card ui-card" wx:for="{{meals}}" wx:key="mealId" bindtap="openMeal" data-meal-id="{{item.mealId}}"><view class="meal-time"><view class="time-icon {{item.tone}}"></view><text class="meal-type">{{item.type}}</text><text>{{item.time}}</text></view><image src="/assets/meal-banner-v2.jpg" mode="aspectFill" style="object-position: {{item.position}}"></image><view class="meal-copy"><text class="meal-name">{{item.name}}</text><text class="meal-ingredients">{{item.ingredients}}</text><view class="tag-row"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="meal-tag">{{tag}}</text></view></view><view class="chevron"></view></view></view>
  <view wx:if="{{!loading && !errorMessage && !meals.length}}" class="records-state empty ui-card"><view class="empty-bowl"></view><text class="state-title">这一天还没有饮食记录</text><text class="state-desc">上传一张食物图片，或进入后使用手工搜索添加食物。</text><button bindtap="addMeal">记录一餐</button></view>
  <view wx:if="{{!loading && !errorMessage && meals.length}}" class="summary-card ui-card"><view class="score-summary"><text>当日已确认记录</text><view><text class="summary-score">{{confirmedCount}}</text><text>餐</text></view></view><view class="category-summary"><text class="category-title">已确认实际摄入</text><view class="category-grid"><view><text class="category-number">{{consumedTotal}}</text><text>克</text></view></view></view><view class="summary-tip"><view class="bulb"></view><text>统计仅来自照护者确认的实际摄入，不是健康评分或医学判断。</text></view></view>
</view></scroll-view>
<view wx:if="{{!loading && !errorMessage && meals.length}}" class="floating-add" bindtap="addMeal" aria-role="button" aria-label="新增饮食记录"><view></view></view>
<app-tabbar active="records" showCamera="{{true}}"></app-tabbar>
<view wx:if="{{selectedMeal}}" class="detail-mask" bindtap="closeMeal"><view class="detail-sheet" catchtap="noop"><view class="detail-header"><view><text class="detail-title">{{selectedMeal.type}}详情</text><text class="detail-subtitle">{{selectedMeal.time}} · {{selectedMeal.name}}</text></view><text class="detail-close" bindtap="closeMeal">关闭</text></view><view class="detail-items"><view class="detail-item" wx:for="{{selectedMeal.items}}" wx:key="mealItemId"><view class="detail-item-heading"><text>{{item.name}}</text><text>{{item.status}}</text></view><view class="detail-amounts"><text>端上桌：{{item.served}}</text><text>实际吃下：{{item.consumed}}</text></view></view><text wx:if="{{!selectedMeal.items.length}}" class="detail-empty">本餐暂无食材记录</text></view></view></view>
