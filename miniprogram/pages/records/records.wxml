<navigation-bar title="饮食记录" back="{{false}}" color="#2d2623" background="transparent"><view slot="left" class="nav-circle" bindtap="goBack"><view class="back-icon"></view></view></navigation-bar>
<scroll-view class="records-scroll" scroll-top="{{recordsScrollTop}}" bindscroll="onRecordsScroll" scroll-y enhanced show-scrollbar="{{false}}"><view wx:if="{{reviewLabel}}" style="margin:20rpx;padding:18rpx;background:#fff0cc;color:#82600f;border-radius:15rpx;font-size:23rpx">{{reviewLabel}} · 请只录入合成测试数据</view><view class="page-shell records-page"><view wx:if="{{pendingMealScope}}" class="saved-banner"><text>上次餐食保存结果待确认</text><button bindtap="resolvePendingMeal" loading="{{pendingMealBusy}}" disabled="{{pendingMealBusy}}">核对保存结果</button></view>
  <view wx:if="{{saved}}" class="saved-banner"><view class="saved-check"><view class="check-icon"></view></view><text>{{savedAction}}。{{reportUpdateState === 'UPDATED' ? '报告已更新' : reportUpdateState === 'FAILED' ? '报告暂未更新，记录已保留' : reportUpdateState === 'PENDING' ? '报告更新中，记录已保留' : '报告更新状态暂不可用，记录已保留'}}</text><view class="saved-close" bindtap="closeSaved"><view></view></view></view>
  <view class="date-header"><view bindtap="openCalendar"><view class="month-row"><text>{{selectedDateLabel}}</text><view class="month-drop"></view></view></view><view class="date-grid"><view class="date-cell {{item.active ? 'active' : ''}}" wx:for="{{dates}}" wx:key="date" bindtap="chooseDate" data-date="{{item.date}}"><text>{{item.week}}</text><view class="day-number">{{item.day}}</view></view></view></view>
  <view wx:if="{{!loading && !errorMessage}}" class="milk-card ui-card"><view class="milk-main"><text class="milk-title">{{milkTitle}}</text><button class="milk-add" bindtap="openMilkCreate" aria-label="记录奶量">+ 记录奶量</button></view><view class="milk-value-row"><text class="milk-value">{{milkMain}}</text><text wx:if="{{milkSub}}" class="milk-sub">{{milkSub}}</text></view><view wx:if="{{milkItems.length}}" class="milk-expand" bindtap="toggleMilkExpand"><text>{{milkExpanded ? '收起明细' : '查看明细'}}</text><text wx:if="{{milkExpanded}}" class="milk-collapse-x" aria-label="收起奶量明细">X</text></view><view wx:if="{{milkExpanded}}" class="milk-list"><view class="milk-row" wx:for="{{milkItems}}" wx:key="milkRecordId" bindtap="openMilkEdit" data-id="{{item.milkRecordId}}"><text class="milk-row-time">{{item.time}}</text><text class="milk-row-type">{{item.typeLabel}}</text><text class="milk-row-volume">{{item.volumeLabel}}</text><view class="chevron"></view></view><button wx:if="{{milkExpanded && milkHasMore}}" bindtap="loadMoreMilk" loading="{{milkLoadingMore}}">更多奶量记录</button><button class="milk-collapse-bottom" bindtap="collapseMilk">收起明细</button></view></view>
  <view wx:if="{{loading}}" class="records-state ui-card"><view class="state-spinner"></view><text class="state-title">正在读取饮食记录</text><text class="state-desc">请稍候</text></view>
  <view wx:elif="{{errorMessage}}" class="records-state ui-card"><view class="state-symbol error">!</view><text class="state-title">记录暂时无法加载</text><text class="state-desc">{{errorMessage}}</text><button wx:if="{{errorMessage === '请先建立宝宝档案'}}" bindtap="goCreateProfile">去创建宝宝档案</button><button bindtap="retryLoad">重新加载</button></view>
  <view class="meal-list"><view class="meal-card ui-card" wx:for="{{meals}}" wx:key="mealId" bindtap="openMeal" data-meal-id="{{item.mealId}}"><view class="meal-marker {{item.tone}}"></view><view class="meal-copy"><view class="meal-card-heading"><text class="meal-name">{{item.title}}</text><text class="meal-total">{{item.consumedTotal}} 克</text></view><text class="meal-ingredients">{{item.ingredients}}</text><text class="meal-meta">{{item.foodCount}} 种食材 · 已保存</text></view><view class="chevron"></view></view></view>
  <view wx:if="{{!loading && !errorMessage && !meals.length}}" class="records-state empty ui-card"><view class="empty-bowl"></view><text class="state-title">{{milkHasRecords?'已记录奶类喂养，尚无餐食记录':'这一天还没有已保存的饮食记录'}}</text><text class="state-desc">{{milkHasRecords?'奶量暂未计入营养计算，可继续记录辅食。':'上传一张食物图片，或进入后使用手工搜索添加食物。'}}</text><button bindtap="addMeal">记录一餐</button></view>
  <view wx:if="{{!loading && !errorMessage && (meals.length || milkHasRecords)}}" id="daily-record-summary" class="summary-card ui-card" bindtap="openReport" aria-role="button" aria-label="查看所选日期的每日饮食记录解读"><view class="score-summary"><text class="summary-title">当日已确认餐食</text><view class="summary-amount"><text class="summary-score">{{confirmedCount}}</text><text class="summary-unit">餐</text></view></view><view class="category-summary"><text class="summary-title">已确认食物克重</text><view class="summary-amount weight-inline"><text class="summary-score">{{consumedTotal}}</text><text class="summary-unit">克</text></view></view><view class="summary-tip"><view class="bulb"></view><text>{{milkHasRecords?'另有'+milkCount+'次奶类喂养，奶量暂未计入营养计算。':'统计仅来自照护者确认的实际摄入，不是健康评分或医学判断。'}}</text></view></view>
</view></scroll-view>
<view wx:if="{{!loading && !errorMessage && (meals.length || milkHasRecords)}}" class="floating-add" bindtap="addMeal" aria-role="button" aria-label="新增饮食记录"><view></view></view>
<app-tabbar id="main-tabbar" active="records" showCamera="{{true}}"></app-tabbar>
<view wx:if="{{selectedMeal}}" class="detail-mask" bindtap="closeMeal"><view class="detail-sheet" catchtap="noop"><view class="detail-grabber"></view><view class="detail-header"><view><text class="detail-title">{{selectedMeal.title}}</text><text class="detail-subtitle">{{selectedMeal.dateLabel}}</text></view><text class="detail-close" bindtap="closeMeal">关闭</text></view><view class="detail-overview"><view><text class="detail-overview-label">已确认食物克重</text><view class="detail-overview-value"><text>{{selectedMeal.consumedTotal}}</text><text>克</text></view></view><text class="detail-overview-count">共 {{selectedMeal.foodCount}} 种食材</text></view><text class="detail-section-title">这餐吃了什么</text><scroll-view class="detail-items" scroll-y enhanced show-scrollbar="{{false}}"><view class="detail-item" wx:for="{{selectedMeal.items}}" wx:key="mealItemId"><view class="detail-item-heading"><text>{{item.name}}</text><text>{{item.consumed}} {{item.unit}}</text></view><text wx:if="{{item.served}}" class="detail-served">原记录提供量（口径未确认）：{{item.served}} {{item.unit}}</text></view><text wx:if="{{!selectedMeal.items.length}}" class="detail-empty">本餐暂无已确认食材</text></scroll-view><view class="detail-note">仅汇总已确认的食物克重，其他单位逐项展示</view><view class="detail-actions"><button id="edit-selected-meal" bindtap="editSelectedMeal" loading="{{editing}}" disabled="{{deleting || editing}}">{{editing ? '正在打开' : '修改记录'}}</button><button id="delete-selected-meal" bindtap="deleteSelectedMeal" disabled="{{deleting || editing}}" loading="{{deleting}}">删除这餐</button></view></view></view>

<view wx:if="{{milkPanel.visible}}" class="detail-mask" bindtap="closeMilkPanel"><view class="detail-sheet" catchtap="noop"><view class="detail-grabber"></view><view class="detail-header"><text class="detail-title">{{milkPanel.mode === 'create' ? '记录奶量' : '修改奶量'}}</text><text class="detail-close" bindtap="closeMilkPanel">关闭</text></view><view class="milk-form"><view class="milk-field"><text class="milk-label">日期</text><text class="milk-static">{{milkPanel.recordDate}}</text></view><view class="milk-field"><text class="milk-label">时间</text><picker mode="time" value="{{milkPanel.time}}" bindchange="milkTimeChange"><view class="milk-picker">{{milkPanel.time}}</view></picker></view><view class="milk-field"><text class="milk-label">奶类</text><view class="milk-types"><view wx:for="{{milkTypes}}" wx:key="key" class="milk-type {{index === milkPanel.milkTypeIndex ? 'active' : ''}}" bindtap="setMilkType" data-index="{{index}}"><text>{{item.label}}</text></view></view></view><view class="milk-field"><text class="milk-label">实际喝下（毫升）</text><input class="milk-input" type="digit" value="{{milkPanel.volume}}" bindinput="milkVolumeInput" placeholder="亲喂母乳可不填" /></view><text class="milk-hint">填写实际喝下的奶液，不是奶粉重量或冲调用量。亲喂母乳可仅记录事件。</text></view><view class="detail-actions"><button bindtap="saveMilkRecord" loading="{{milkPanel.saving}}" disabled="{{milkPanel.deleting}}">保存</button><button wx:if="{{milkPanel.mode === 'edit'}}" bindtap="deleteMilkRecord" loading="{{milkPanel.deleting}}" disabled="{{milkPanel.saving}}">删除</button></view></view></view>

<date-calendar id="date-selector" visible="{{showCalendar}}" selected="{{selectedDate}}" max-date="{{todayDate}}" title="选择记录日期" bindchange="changeDate" bindclose="closeCalendar"/>
