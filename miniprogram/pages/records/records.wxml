<import src="../../templates/record-empty.wxml"/>
<navigation-bar title="饮食记录" back="{{false}}" color="#2d2623" background="transparent"><view slot="left" class="nav-circle" bindtap="goBack"><view class="back-icon"></view></view></navigation-bar>
<scroll-view class="records-scroll" scroll-top="{{recordsScrollTop}}" bindscroll="onRecordsScroll" scroll-y enhanced show-scrollbar="{{false}}"><view wx:if="{{reviewLabel}}" style="margin:20rpx;padding:18rpx;background:#fff0cc;color:#82600f;border-radius:15rpx;font-size:23rpx">{{reviewLabel}} · 请只录入合成测试数据</view><view class="page-shell records-page {{!loading && !errorMessage && !meals.length ? 'records-empty-page' : ''}}"><view wx:if="{{pendingMealScope}}" class="saved-banner"><text>上次餐食保存结果待确认</text><button bindtap="resolvePendingMeal" loading="{{pendingMealBusy}}" disabled="{{pendingMealBusy}}">核对保存结果</button></view>
  <view wx:if="{{saved}}" class="saved-banner"><view class="saved-check"><view class="check-icon"></view></view><text>{{savedAction}}。{{reportUpdateState === 'UPDATED' ? '报告已更新' : reportUpdateState === 'FAILED' ? '报告暂未更新，记录已保留' : reportUpdateState === 'PENDING' ? '报告更新中，记录已保留' : '报告更新状态暂不可用，记录已保留'}}</text><view class="saved-close" bindtap="closeSaved"><view></view></view></view>
  <view class="date-header"><view bindtap="openCalendar"><view class="month-row"><text>{{selectedDateLabel}}</text><view class="month-drop"></view></view></view><view class="date-grid"><view class="date-cell {{item.active ? 'active' : ''}}" wx:for="{{dates}}" wx:key="date" bindtap="chooseDate" data-date="{{item.date}}"><text>{{item.week}}</text><view class="day-number">{{item.day}}</view><view wx:if="{{item.recorded===true}}" class="meal-dot" aria-label="有已确认餐食记录"></view></view></view></view>
  <view wx:if="{{!loading && !errorMessage}}" class="milk-card ui-card {{milkExpanded ? 'is-expanded' : 'is-collapsed'}}">
    <view class="milk-main"><view class="milk-summary"><view class="milk-bottle-icon"></view><view class="milk-summary-copy"><text class="milk-title">{{milkTitle}}</text><view class="milk-value-row"><block wx:if="{{milkHasKnownVolume}}"><text class="milk-number">{{milkAmount}}</text><text class="milk-volume-unit">ml · {{milkCount}}次</text></block><text wx:else class="milk-unknown">{{milkMain}}</text></view></view></view><button class="milk-add" wx:if="{{canRecord}}" bindtap="openMilkCreate" aria-label="记录奶量">记录奶量</button></view>
    <text wx:if="{{milkSub}}" class="milk-sub">{{milkSub}}</text>
    <view wx:if="{{milkPreview || milkItems.length}}" class="milk-footer"><text class="milk-preview">{{milkPreview}}</text><view wx:if="{{milkItems.length}}" class="milk-expand" bindtap="toggleMilkExpand" aria-role="button"><text>{{milkExpanded ? '收起明细' : '查看明细'}}</text><text wx:if="{{milkExpanded}}" class="milk-collapse-x" aria-label="收起奶量明细">X</text><view wx:else class="chevron"></view></view></view>
    <view wx:if="{{milkExpanded}}" class="milk-list"><view class="milk-row" wx:for="{{milkItems}}" wx:key="milkRecordId" bindtap="openMilkEdit" data-id="{{item.milkRecordId}}"><text class="milk-row-time">{{item.time}}</text><view class="milk-row-copy"><text class="milk-row-type">{{item.typeLabel}}</text><text wx:if="{{item.recordedBy}}" class="milk-row-author">{{item.recordedBy}}记录{{item.modifiedBy && item.modifiedBy!==item.recordedBy?' · '+item.modifiedBy+'修改':''}}</text></view><text class="milk-row-volume">{{item.volumeLabel}}</text><view class="chevron"></view></view><button wx:if="{{milkExpanded && milkHasMore}}" bindtap="loadMoreMilk" loading="{{milkLoadingMore}}">更多奶量记录</button><button class="milk-collapse-bottom" bindtap="collapseMilk">收起明细</button></view>
  </view>
  <view wx:if="{{loading}}" class="records-state ui-card"><view class="state-spinner"></view><text class="state-title">正在读取饮食记录</text><text class="state-desc">请稍候</text></view>
  <view wx:elif="{{errorMessage}}" class="records-state ui-card"><view class="state-symbol error">!</view><text class="state-title">记录暂时无法加载</text><text class="state-desc">{{errorMessage}}</text><button wx:if="{{errorMessage === '请先建立宝宝档案'}}" bindtap="goCreateProfile">去创建宝宝档案</button><button bindtap="retryLoad">重新加载</button></view>
  <view class="meal-list"><view class="meal-card ui-card" wx:for="{{meals}}" wx:key="mealId" bindtap="openMeal" data-meal-id="{{item.mealId}}"><view class="meal-slot"><view class="meal-slot-icon {{item.tone}}"></view><text class="meal-slot-label">{{item.type}}</text><text class="meal-slot-time">{{item.time}}</text></view><image class="meal-photo" src="{{item.photoPath || '/assets/camera-food-guide-v5.jpg'}}" mode="aspectFill" data-meal-id="{{item.mealId}}" binderror="hideMealPhoto"/><view class="meal-copy"><text class="meal-name">{{item.name}}</text><text class="meal-ingredients">{{item.ingredients}}</text><view class="meal-tags"><text class="meal-status-tag">已确认</text><text wx:if="{{item.recordLabel}}" class="meal-source-tag">{{item.recordLabel}}</text></view></view><view class="chevron"></view></view></view>
  <view wx:if="{{!loading && !errorMessage && !meals.length}}" class="records-empty-guide"><template is="record-empty"/></view>
  <view wx:if="{{!loading && !errorMessage && meals.length}}" id="daily-record-summary" class="summary-card ui-card" bindtap="openReport" aria-role="button" aria-label="查看所选日期的每日饮食记录解读"><view class="score-summary"><text class="summary-title">当日已确认餐食</text><view class="summary-amount"><text class="summary-score">{{confirmedCount}}</text><text class="summary-unit">餐</text></view></view><view class="category-summary"><text class="summary-title">已确认食物克重</text><view class="summary-amount weight-inline"><text class="summary-score">{{consumedTotal}}</text><text class="summary-unit">克</text></view></view><view class="summary-tip"><view class="bulb"></view><text>{{milkHasRecords?'另有'+milkCount+'次奶类喂养，奶量暂未计入营养计算。':'统计仅来自照护者确认的实际摄入，不是健康评分或医学判断。'}}</text></view></view>
</view></scroll-view>
<view wx:if="{{canRecord && !loading && !errorMessage && meals.length}}" class="floating-add" bindtap="addMeal" aria-role="button" aria-label="新增饮食记录"><view></view></view>
<app-tabbar id="main-tabbar" active="records" showCamera="{{true}}"></app-tabbar>
<view wx:if="{{selectedMeal}}" class="detail-mask" bindtap="closeMeal"><view class="detail-sheet" catchtap="noop"><view class="detail-grabber"></view><view class="detail-header"><view><text class="detail-title">{{selectedMeal.title}}</text><text class="detail-subtitle">{{selectedMeal.dateLabel}}</text></view><text class="detail-close" bindtap="closeMeal">关闭</text></view><view class="detail-overview"><view><text class="detail-overview-label">已确认食物克重</text><view class="detail-overview-value"><text>{{selectedMeal.consumedTotal}}</text><text>克</text></view></view><text class="detail-overview-count">共 {{selectedMeal.foodCount}} 种食材</text></view><text wx:if="{{selectedMeal.recordedBy}}" class="detail-authorship">记录：{{selectedMeal.recordedBy}} · 最近修改：{{selectedMeal.modifiedBy}}</text><text class="detail-section-title">这餐吃了什么</text><scroll-view class="detail-items" scroll-y enhanced show-scrollbar="{{false}}"><view class="detail-item" wx:for="{{selectedMeal.items}}" wx:key="mealItemId"><view class="detail-item-heading"><text>{{item.name}}</text><text>{{item.consumed}} {{item.unit}}</text></view><text wx:if="{{item.served}}" class="detail-served">原记录提供量（口径未确认）：{{item.served}} {{item.unit}}</text></view><text wx:if="{{!selectedMeal.items.length}}" class="detail-empty">本餐暂无已确认食材</text></scroll-view><view class="detail-note">仅汇总已确认的食物克重，其他单位逐项展示</view><view wx:if="{{canRecord}}" class="detail-actions"><button id="edit-selected-meal" bindtap="editSelectedMeal" loading="{{editing}}" disabled="{{deleting || editing}}">{{editing ? '正在打开' : '修改记录'}}</button><button id="delete-selected-meal" bindtap="deleteSelectedMeal" disabled="{{deleting || editing}}" loading="{{deleting}}">删除这餐</button></view></view></view>

<view wx:if="{{milkPanel.visible}}" id="milk-editor-mask" class="milk-editor-mask" bindtap="closeMilkPanel"><view id="milk-editor" class="milk-editor" catchtap="noop">
  <view class="milk-editor-handle"/><view class="milk-editor-header"><text class="milk-editor-title">{{milkPanel.mode==='edit'?'修改奶量':milkPanel.unknownVolume?'记录一次喂养':'记录奶量'}}</text><button id="milk-editor-close" class="milk-editor-close" bindtap="closeMilkPanel" disabled="{{milkPanel.saving || milkPanel.deleting}}" aria-label="关闭奶量编辑"><view class="milk-editor-close-icon"/></button></view>
  <view class="milk-editor-field"><text class="milk-editor-label">奶类</text><view class="milk-editor-types"><button wx:for="{{milkTypes}}" wx:key="key" class="milk-editor-type {{index===milkPanel.milkTypeIndex?'active':''}}" data-index="{{index}}" bindtap="setMilkType" disabled="{{milkPanel.retrying || milkPanel.saving || milkPanel.deleting}}">{{item.label}}</button></view></view>
  <view class="milk-editor-field"><text class="milk-editor-label">记录日期</text><picker id="milk-editor-date" mode="date" value="{{milkPanel.recordDate}}" end="{{todayDate}}" bindchange="milkDateChange" disabled="{{milkPanel.retrying || milkPanel.saving || milkPanel.deleting}}"><view class="milk-editor-picker"><text>{{milkPanel.recordDate}}</text><view class="milk-editor-date-icon"/></view></picker></view>
  <view class="milk-editor-field"><text class="milk-editor-label">喂养时间</text><picker id="milk-editor-time" mode="time" value="{{milkPanel.time}}" bindchange="milkTimeChange" disabled="{{milkPanel.retrying || milkPanel.saving || milkPanel.deleting}}"><view class="milk-editor-picker"><text>{{milkPanel.time}}</text><view class="milk-editor-time-icon"/></view></picker></view>
  <view class="milk-editor-field"><text class="milk-editor-label">实际喝下量</text><view class="milk-editor-volume {{milkPanel.unknownVolume?'event-only':''}}"><input id="milk-editor-volume" type="number" value="{{milkPanel.unknownVolume?'':milkPanel.volume}}" placeholder="{{milkPanel.unknownVolume?'不知道奶量可以不填':'请输入实际喝下量'}}" disabled="{{milkPanel.unknownVolume || milkPanel.retrying || milkPanel.saving || milkPanel.deleting}}" bindinput="milkVolumeInput" cursor-spacing="70"/><text>ml</text></view></view>
  <view id="milk-editor-unknown" class="milk-editor-unknown" bindtap="toggleMilkUnknown" role="checkbox" aria-checked="{{milkPanel.unknownVolume}}"><view class="milk-editor-check {{milkPanel.unknownVolume?'checked':''}}"><view wx:if="{{milkPanel.unknownVolume}}"/></view><text>不知道奶量，仅记录这次喂养</text></view>
  <view class="milk-editor-divider"/><text wx:if="{{milkPanel.errorMessage}}" class="milk-editor-error">{{milkPanel.errorMessage}}</text><button id="milk-editor-save" class="milk-editor-save" bindtap="saveMilkRecord" loading="{{milkPanel.saving}}" disabled="{{milkPanel.saving || milkPanel.deleting}}">{{milkPanel.unknownVolume?'保存喂养记录':'保存奶量'}}</button><button wx:if="{{milkPanel.mode==='edit'}}" class="milk-editor-delete" bindtap="deleteMilkRecord" loading="{{milkPanel.deleting}}" disabled="{{milkPanel.saving || milkPanel.deleting}}">删除这条记录</button>
</view></view><date-calendar id="date-selector" visible="{{showCalendar}}" selected="{{selectedDate}}" max-date="{{todayDate}}" title="选择记录日期" bindchange="changeDate" bindclose="closeCalendar"/>
