.nav-circle { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.report-shortcut { width: 64rpx; height: 64rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; background: #fff; }.mini-report { width: 28rpx; height: 32rpx; border: 4rpx solid #5c504b; border-radius: 4rpx; }.mini-report view { width: 14rpx; height: 10rpx; margin: 10rpx 3rpx 0; border-left: 4rpx solid #5c504b; border-bottom: 4rpx solid #5c504b; transform: rotate(-45deg); }
.records-scroll { height: calc(100vh - 118rpx - env(safe-area-inset-bottom)); }.records-page { padding-top: 0; }.saved-banner { min-height: 64rpx; margin-bottom: 12rpx; padding: 10rpx 18rpx; border-radius: 22rpx; display: flex; align-items: center; gap: 12rpx; color: #4c9b42; background: #eff9e9; }.saved-check { width: 32rpx; height: 32rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: #65ba54; }.saved-check .check-icon { width: 16rpx; height: 9rpx; border-width: 0 0 4rpx 4rpx; }.saved-close { width: 44rpx; height: 44rpx; margin-left: auto; display: flex; align-items: center; justify-content: center; }.saved-close view,.saved-close view::after { width: 21rpx; height: 3rpx; background: #6aa361; transform: rotate(45deg); }.saved-close view::after { content: ''; display: block; transform: rotate(90deg); }
.date-header { margin: 0 -4rpx 20rpx; }.month-row { height: 67rpx; display: flex; align-items: center; justify-content: center; color: #ff6f70; font-size: 27rpx; font-weight: 700; }.month-arrow { position: absolute; width: 18rpx; height: 18rpx; border-top: 4rpx solid #9a6b50; border-right: 4rpx solid #9a6b50; }.month-arrow.prev { left: 48rpx; transform: rotate(-135deg); }.month-arrow.next { right: 48rpx; transform: rotate(45deg); }.month-drop { width: 0; height: 0; margin-left: 12rpx; border-left: 8rpx solid transparent; border-right: 8rpx solid transparent; border-top: 10rpx solid #ff7777; }.date-grid { display: grid; grid-template-columns: repeat(7,1fr); }.date-cell { height: 94rpx; position: relative; display: flex; flex-direction: column; align-items: center; gap: 16rpx; color: #8c8581; font-size: 20rpx; }.day-number { width: 58rpx; height: 48rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; color: #37302d; font-size: 23rpx; }.date-cell.active .day-number { color: #fff; background: linear-gradient(135deg,#ff8582,#ff6568); }.meal-dot { position: absolute; bottom: 2rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #c8c4c1; }
.meal-list { display: flex; flex-direction: column; gap: 14rpx; }.meal-card { min-height: 122rpx; padding: 12rpx 18rpx; display: flex; align-items: center; }.meal-time { width: 108rpx; display: grid; grid-template-columns: 32rpx 1fr; align-items: center; color: #89817d; font-size: 19rpx; }.meal-type { color: #2d2825; font-size: 25rpx; font-weight: 700; }.meal-time > text:last-child { grid-column: 2; margin-top: 7rpx; }.time-icon { width: 24rpx; height: 24rpx; border-radius: 50%; background: #ffc12a; box-shadow: 0 0 0 5rpx #fff7d7; }.time-icon.night { background: #6dcbe9; box-shadow: inset 8rpx 0 0 #fff,0 0 0 5rpx #eefaff; }.time-icon.snack { background: #9c6dea; box-shadow: 0 0 0 5rpx #f3ecff; }.meal-card image { width: 96rpx; height: 96rpx; border-radius: 20rpx; }.meal-copy { min-width: 0; margin-left: 20rpx; flex: 1; display: flex; flex-direction: column; gap: 7rpx; }.meal-name { font-size: 26rpx; font-weight: 700; }.meal-ingredients { overflow: hidden; color: #8d8580; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }.tag-row { display: flex; gap: 10rpx; }.meal-tag { padding: 4rpx 10rpx; border-radius: 8rpx; color: #5ba64e; background: #eff8e9; font-size: 16rpx; }.meal-card:nth-child(2) .meal-tag { color: #e85f60; background: #fff0ee; }.meal-card:nth-child(4) .meal-tag { color: #dc941b; background: #fff5dc; }.meal-card .chevron { color: #b28f7a; }
.summary-card { margin-top: 18rpx; padding: 22rpx 22rpx 0; display: grid; grid-template-columns: 1fr 1.45fr; overflow: hidden; background: linear-gradient(115deg,#f2fbe9,#fffef9); }.score-summary { border-right: 1rpx solid #e7efdf; display: flex; flex-direction: column; gap: 9rpx; color: #3a9c3e; font-size: 23rpx; font-weight: 700; }.summary-score { margin-right: 6rpx; font-size: 54rpx; }.stars { display: flex; gap: 10rpx; }.star-css { width: 22rpx; height: 22rpx; background: #ffb81d; clip-path: polygon(50% 0,61% 34%,98% 35%,68% 57%,79% 93%,50% 72%,21% 93%,32% 57%,2% 35%,39% 34%); }.star-css.off { background: #eadfd5; }.category-summary { padding-left: 24rpx; }.category-title { color: #3a9c3e; font-size: 23rpx; font-weight: 700; }.category-grid { margin-top: 20rpx; display: grid; grid-template-columns: repeat(4,1fr); gap: 9rpx; color: #77716d; font-size: 17rpx; }.category-grid view { display: flex; flex-direction: column; align-items: center; }.category-number { color: #3e3936; font-size: 28rpx; font-weight: 700; }.summary-tip { grid-column: 1/-1; min-height: 62rpx; margin: 20rpx -22rpx 0; padding: 12rpx 20rpx; display: flex; align-items: center; gap: 12rpx; color: #796654; background: #fff7dd; font-size: 19rpx; }.bulb { width: 18rpx; height: 22rpx; border-radius: 50%; background: #ffc12b; }
.floating-add { position: fixed; z-index: 45; right: 34rpx; bottom: calc(136rpx + env(safe-area-inset-bottom)); width: 86rpx; height: 86rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg,#ff8582,#ff6367); box-shadow: 0 12rpx 26rpx rgba(255,98,103,.28); }.floating-add view,.floating-add view::after { width: 40rpx; height: 6rpx; border-radius: 3rpx; background: #fff; }.floating-add view::after { content: ''; display: block; transform: rotate(90deg); }
.detail-mask { position: fixed; z-index: 80; inset: 0; display: flex; align-items: flex-end; background: rgba(45,38,35,.42); }
.detail-sheet { width: 100%; max-height: 72vh; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; overflow-y: auto; background: #fffdfb; box-sizing: border-box; }
.detail-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.detail-header > view { display: flex; flex-direction: column; gap: 7rpx; }
.detail-title { font-size: 31rpx; font-weight: 700; }
.detail-subtitle { color: #8b827d; font-size: 20rpx; }
.detail-close { padding: 8rpx; color: #e86869; font-size: 22rpx; }
.detail-items { margin-top: 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.detail-item { padding: 20rpx; border-radius: 20rpx; background: #fff6ef; }
.detail-item-heading { display: flex; justify-content: space-between; gap: 12rpx; font-size: 24rpx; font-weight: 700; }
.detail-item-heading text:last-child { color: #55a34d; font-size: 18rpx; font-weight: 400; }
.detail-amounts { margin-top: 14rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; color: #756d68; font-size: 20rpx; }
.detail-empty { padding: 30rpx 0; color: #958d88; text-align: center; font-size: 21rpx; }
