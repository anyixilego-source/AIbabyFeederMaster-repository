@import "../../styles/my-module.wxss";
.brand-card{text-align:center;padding:75rpx 34rpx}.brand-mark{width:104rpx;height:104rpx;border-radius:29rpx;display:block;margin:0 auto 30rpx}.brand-name{display:block;font-size:34rpx;font-weight:600;line-height:1.5;margin-bottom:24rpx}.brand-card .my-small{font-size:23rpx}.about-copy{margin-top:24rpx}.filing-line{display:flex;justify-content:space-between;gap:20rpx;padding:25rpx 0;border-bottom:2rpx solid #f1e8e0;font-size:23rpx;line-height:1.8}.filing-line>text:first-child{color:#92847a;flex:none}.filing-line>text:last-child{min-width:0;text-align:right;overflow-wrap:anywhere}.filing-line:last-of-type{margin-bottom:20rpx}
