@import "../nutrient-trend/nutrient-trend.wxss";
.milk-stat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin:22rpx 0}.milk-stat-grid>view{background:#fff5e9;border-radius:18rpx;padding:14rpx 18rpx}.stat{display:block;font-size:34rpx;font-weight:600;color:#765839}.unit{font-size:24rpx;color:#8a7774}.grid-line{position:absolute;left:0;right:0;border-top:1rpx solid #efe5dc;pointer-events:none}.grid-line:before{content:"";position:absolute;left:-8rpx;width:8rpx;border-top:1rpx solid #c8b7a6}.bar.estimated{background:repeating-linear-gradient(135deg,#daa57b,#daa57b 7rpx,#f8dfca 7rpx,#f8dfca 14rpx)}.bar.selected{box-shadow:0 0 0 2rpx #b47e54}.active-date{color:#b47742;font-weight:600}.feed-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 18rpx;margin-top:14rpx;border:1rpx solid #f1e2d5;border-radius:20rpx;background:#fffaf5}.feed-copy{min-width:0}.feed-type{font-size:28rpx;font-weight:600}.feed-time{color:#b47e54;font-size:26rpx;flex:none}.chart-legend{margin-bottom:16rpx}

.page-shell{padding-bottom:calc(36rpx + env(safe-area-inset-bottom))}
