<navigation-bar id="profile-navigation" title="{{(editing || editorView)?(subjectId?'编辑宝宝信息':'创建宝宝档案'):healthView?'健康与饮食条件':'宝宝档案'}}" back="{{false}}" color="#3d302a" background="transparent"><view slot="left" class="my-nav" bindtap="goBack"><view></view></view></navigation-bar>
<scroll-view class="my-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="my-shell {{!editing && !editorView && !healthView?'has-tabs':''}}">
 <view wx:if="{{reviewLabel}}" class="my-error">{{reviewLabel}} · 请只录入合成数据</view><view wx:if="{{errorMessage}}" class="my-error">{{errorMessage}}<button wx:if="{{errorMessage==='请选择当前宝宝'}}" class="my-secondary" bindtap="openFamily">选择宝宝</button><button wx:else class="my-secondary" bindtap="load">重新加载</button></view><view wx:if="{{loading}}" class="my-state">正在读取宝宝资料…</view>
 <block wx:elif="{{editing}}"><view class="my-card editor-card"><image class="editor-avatar" src="/assets/baby-avatar-v2.jpg" mode="aspectFill"/><view class="my-field"><text class="my-field-label">宝宝昵称</text><input id="profile-name" class="my-input" maxlength="50" value="{{draftName}}" disabled="{{saving}}" bindinput="onNameInput" placeholder="填写昵称"/></view><view class="my-field"><text class="my-field-label">出生日期</text><picker mode="date" end="{{todayDate}}" value="{{draftBirthDate}}" disabled="{{saving}}" bindchange="onBirthDateChange"><view id="profile-birth-date" class="my-picker picker-date"><text>{{draftBirthDate || '请选择出生日期'}}</text><view class="my-icon calendar"></view></view></picker></view><view class="my-field"><text class="my-field-label">性别</text><view class="my-choices"><button id="profile-sex-male" class="my-choice {{draftSexIndex===1?'active':''}}" data-index="1" disabled="{{saving}}" bindtap="selectSex">男宝宝</button><button id="profile-sex-female" class="my-choice {{draftSexIndex===0?'active':''}}" data-index="0" disabled="{{saving}}" bindtap="selectSex">女宝宝</button></view><view id="profile-sex-unspecified" class="sex-unspecified" data-index="2" bindtap="selectSex">{{draftSexIndex===2?'已选：暂不设置':'暂不设置'}}</view></view></view><button id="profile-save" class="my-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存信息</button></block>
 <block wx:elif="{{healthView && subjectId}}"><view class="my-card"><view class="my-heading"><text class="my-title">已保存的饮食条件</text><view id="health-edit" class="my-link" bindtap="openConditions">修改 <text>›</text></view></view><view wx:if="{{preferenceError}}" class="my-sub">{{preferenceError}}</view><view wx:else><view class="condition-row"><text>需避开的食材</text><text>{{savedAvoidanceText}}</text></view><view class="condition-row"><text>能接受的食物形态</text><text>{{savedTextureText}}</text></view></view></view><view class="my-card"><text class="my-title">家庭避免食材</text><view class="my-chip-row health-chips"><text wx:for="{{familyAvoidances}}" wx:key="foodId" class="my-chip">{{item.foodName}}</text><text wx:if="{{!familyAvoidances.length}}" class="my-muted">当前未设置</text></view><text class="my-small">菜单会同时考虑已保存的家庭条件</text></view><view class="my-disclosure"><view id="health-info-toggle" class="my-disclosure-toggle" bindtap="toggleHealthInfo"><text>功能说明</text><text>{{showHealthInfo?'−':'+'}}</text></view><view wx:if="{{showHealthInfo}}" class="my-disclosure-body"><text class="my-sub">保存的饮食条件用于菜单生成前核对。收藏不表示食物已验证适用；实际回避条件仍由用户明确确认。</text><text class="my-sub">家庭避免食材为家庭主动选择，非医学禁忌。此处只读，修改饮食推荐条件可点击上方“修改”。</text></view></view></block>
 <block wx:elif="{{!errorMessage}}"><view id="profile-edit-cover" class="profile-cover" bindtap="toggleEdit"><image src="/assets/baby-avatar-v2.jpg" mode="aspectFill"/><view class="profile-cover-copy"><view class="profile-name"><text>{{name}}</text><text class="profile-sex">{{sexText==='女宝宝'?'♀':sexText==='男宝宝'?'♂':''}}</text></view><text class="my-sub">{{ageText}}</text><text class="profile-birth">{{birthDate?birthDate+' 出生':'填写宝宝资料'}} ›</text></view></view><view wx:if="{{!subjectId}}" class="my-card"><text class="my-sub">还没有宝宝档案，先创建一个吧。</text><button class="my-primary" bindtap="openCreateProfile">创建宝宝档案</button></view><view wx:else class="my-card"><text class="my-title">宝宝信息</text><view id="profile-edit-name" class="my-row" bindtap="toggleEdit"><view class="my-icon-box "><view class="my-icon baby"></view></view><text class="my-label">昵称</text><text class="my-value">{{name}}</text><text class="my-chevron">›</text></view><view id="profile-edit-birth" class="my-row" bindtap="toggleEdit"><view class="my-icon-box green"><view class="my-icon calendar"></view></view><text class="my-label">出生日期</text><text class="my-value">{{birthDate}}</text><text class="my-chevron">›</text></view><view id="profile-edit-sex" class="my-row" bindtap="toggleEdit"><view class="my-icon-box yellow"><view class="my-icon baby"></view></view><text class="my-label">性别</text><text class="my-value">{{sexText}}</text><text class="my-chevron">›</text></view></view><view class="my-card"><text class="my-title">饮食与健康</text><view id="profile-health" class="my-row" bindtap="openHealth"><view class="my-icon-box "><view class="my-icon shield"></view></view><text class="my-label">健康信息</text><text class="my-value">查看</text><text class="my-chevron">›</text></view><view id="diet-collections-entry" class="my-row" bindtap="openCollections"><view class="my-icon-box green"><view class="my-icon heart"></view></view><text class="my-label">饮食偏好</text><text class="my-value">查看收藏</text><text class="my-chevron">›</text></view><view id="profile-recipes" class="my-row" bindtap="openMenu"><view class="my-icon-box yellow"><view class="my-icon chef"></view></view><text class="my-label">家庭食谱</text><text class="my-value">查看</text><text class="my-chevron">›</text></view></view><view class="my-card"><view id="family-entry" class="my-row" bindtap="openFamily"><view class="my-icon-box green"><view class="my-icon shield"/></view><text class="my-label">家庭与照护</text><text class="my-value">成员与权限</text><text class="my-chevron">›</text></view><view id="opinion-feedback-entry" class="my-row" bindtap="openFeedback"><view class="my-icon-box "><view class="my-icon message"></view></view><text class="my-label">意见反馈</text><text class="my-chevron">›</text></view><view wx:if="{{canReadFeedback}}" id="feedback-management-entry" class="my-row" bindtap="openFeedbackManagement"><view class="my-icon-box yellow"><view class="my-icon report"></view></view><text class="my-label">反馈管理</text><text class="my-chevron">›</text></view><view id="profile-about" class="my-row" bindtap="openAbout"><view class="my-icon-box yellow"><view class="my-icon info"></view></view><text class="my-label">关于与隐私</text><text class="my-chevron">›</text></view></view><view class="profile-kind-note"><view class="my-icon heart"></view><text>认真记录，就是温柔照顾的一部分</text></view></block>
</view></scroll-view><app-tabbar wx:if="{{!editing && !editorView && !healthView}}" id="main-tabbar" active="profile" showCamera="{{true}}"/>
