<navigation-bar title="宝宝档案" back="{{false}}" color="#2d2623" background="transparent"><view slot="left" class="nav-circle" bindtap="goBack"><view class="back-icon"></view></view><view slot="right" class="edit-button" bindtap="toggleEdit"><view class="pencil-icon"></view><text>编辑</text></view></navigation-bar>
<scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="page-shell profile-page">
  <view class="profile-hero ui-card"><view class="avatar-wrap"><image src="/assets/baby-avatar-v2.jpg" mode="aspectFill"></image></view><view class="profile-main"><view class="name-line"><text>{{name}}</text><text class="girl-tag">{{sexText}}</text></view><view class="birth-line"><text>{{ageText}}</text><text>{{birthDate}}出生</text></view></view></view>
  <view class="profile-tip"><view class="bulb"></view><text class="tip-lead">档案说明：</text><text class="tip-body">当前支持昵称、出生日期和性别；尚未接入的健康资料不会伪装为已保存。</text></view>
  <view class="info-card ui-card"><text class="section-title">宝宝信息</text><view class="info-row {{item.editable ? 'editable' : ''}}" wx:for="{{basic}}" wx:key="label" bindtap="editItem" data-label="{{item.label}}" data-editable="{{item.editable}}"><view class="row-badge {{item.tone}}">{{item.badge}}</view><text class="row-label">{{item.label}}</text><text class="row-value">{{item.value}}</text><view wx:if="{{item.editable}}" class="chevron"></view></view></view>
  <view class="info-card ui-card"><text class="section-title">健康信息</text><view class="info-row {{item.editable ? 'editable' : ''}}" wx:for="{{health}}" wx:key="label" bindtap="editItem" data-label="{{item.label}}" data-editable="{{item.editable}}"><view class="row-badge {{item.tone}}">{{item.badge}}</view><text class="row-label">{{item.label}}</text><text class="row-value {{item.good ? 'good' : ''}}">{{item.value}}</text><view wx:if="{{item.editable}}" class="chevron"></view></view></view>
  <view class="info-card ui-card menu-entry" bindtap="openMenu"><text class="section-title">家庭食谱</text><view class="info-row"><view class="row-badge purple">谱</view><text class="row-label">食谱与菜单候选</text><text class="row-value">查看</text><view class="chevron"></view></view></view>
  <view class="info-card ui-card about-entry" bindtap="openAbout"><text class="section-title">关于与合规</text><view class="info-row"><view class="row-badge blue">备</view><text class="row-label">备案与隐私说明</text><text class="row-value">查看</text><view class="chevron"></view></view></view>
  <view class="love-card ui-card"><view><text>爱与营养，陪伴成长每一步</text><text>持续记录，以已确认摄入生成可追溯的营养参考</text></view><image src="/assets/baby-eating-focus-v3.jpg" mode="aspectFill"></image></view>
</view></scroll-view>
<app-tabbar active="profile" showCamera="{{true}}"></app-tabbar>
<view wx:if="{{editing}}" class="edit-mask" bindtap="closeEdit"><view class="edit-sheet" catchtap="stopPropagation">
  <view class="edit-title"><text>编辑宝宝档案</text><text bindtap="closeEdit">取消</text></view>
  <view class="edit-field"><text>宝宝昵称</text><input maxlength="50" value="{{draftName}}" bindinput="onNameInput" placeholder="请输入昵称"></input></view>
  <picker mode="date" end="{{todayDate}}" value="{{draftBirthDate}}" bindchange="onBirthDateChange"><view class="edit-field"><text>出生日期</text><text class="field-value">{{draftBirthDate || '请选择'}}</text></view></picker>
  <picker range="{{sexOptions}}" range-key="label" value="{{draftSexIndex}}" bindchange="onSexChange"><view class="edit-field"><text>性别</text><text class="field-value">{{sexOptions[draftSexIndex].label}}</text></view></picker>
  <button class="save-profile" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存档案</button>
</view></view>
