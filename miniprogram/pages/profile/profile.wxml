<navigation-bar title="宝宝档案" back="{{false}}" color="#2d2623" background="transparent"><view slot="left" class="nav-circle" bindtap="goBack"><view class="back-icon"></view></view><view slot="right" class="edit-button" bindtap="toggleEdit"><view class="pencil-icon"></view><text>{{editing ? '保存' : '编辑'}}</text></view></navigation-bar>
<scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="page-shell profile-page">
  <view class="profile-hero ui-card"><view class="avatar-wrap"><image src="/assets/baby-avatar-v2.jpg" mode="aspectFill"></image><view class="avatar-camera" bindtap="changeAvatar"><view class="camera-icon"></view></view></view><view class="profile-main"><view class="name-line"><text>小米</text><text class="girl-tag">女</text></view><view class="birth-line"><text>10个月23天</text><text>2023-09-03出生</text></view><view class="measurements"><view><view class="measure-icon weight">重</view><text>体重</text><text class="measure-value">9.2 kg</text><text class="measure-date">07-20</text></view><view><view class="measure-icon height">高</view><text>身高</text><text class="measure-value">74.5 cm</text><text class="measure-date">07-20</text></view><view><view class="measure-icon head">围</view><text>头围</text><text class="measure-value">44.0 cm</text><text class="measure-date">07-20</text></view></view></view></view>
  <view class="profile-tip"><view class="bulb"></view><text class="tip-lead">小贴士：</text><text class="tip-body">定期记录体重和身高，帮助我们更好地分析宝宝营养状况哦~</text><view class="chevron"></view></view>
  <view class="info-card ui-card"><text class="section-title">宝宝信息</text><view class="info-row" wx:for="{{basic}}" wx:key="label" bindtap="editItem" data-label="{{item.label}}"><view class="row-badge {{item.tone}}">{{item.badge}}</view><text class="row-label">{{item.label}}</text><text class="row-value">{{item.value}}</text><view class="chevron"></view></view></view>
  <view class="info-card ui-card"><text class="section-title">健康信息</text><view class="info-row" wx:for="{{health}}" wx:key="label" bindtap="editItem" data-label="{{item.label}}"><view class="row-badge {{item.tone}}">{{item.badge}}</view><text class="row-label">{{item.label}}</text><text class="row-value {{item.good ? 'good' : ''}}">{{item.value}}</text><view class="chevron"></view></view></view>
  <view class="love-card ui-card"><view><text>爱与营养，陪伴成长每一步</text><text>持续记录，AI为宝宝制定更科学的营养建议~</text></view><image src="/assets/baby-eating-focus-v3.jpg" mode="aspectFill"></image></view>
</view></scroll-view>
<app-tabbar active="profile" showCamera="{{true}}"></app-tabbar>
