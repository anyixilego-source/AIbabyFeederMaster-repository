@import "../../styles/my-module.wxss";
.profile-cover{display:flex;align-items:center;gap:29rpx;padding:18rpx 3rpx 38rpx}.profile-cover>image{width:154rpx;height:154rpx;border-radius:50%;border:9rpx solid #ffe9de;flex:none;box-sizing:border-box}.profile-cover-copy{flex:1;min-width:0}.profile-name{display:flex;align-items:center;gap:15rpx;font-size:43rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.profile-sex{font-size:25rpx;color:#f19399;font-weight:400;flex:none}.profile-birth{display:block;font-size:21rpx;color:#92847a;line-height:1.7;margin-top:4rpx;overflow-wrap:anywhere}.profile-cover .my-sub{font-size:25rpx;margin-top:8rpx}.profile-kind-note{display:flex;align-items:center;gap:18rpx;background:#fff6e3;border-radius:25rpx;color:#bb935e;padding:21rpx 24rpx;font-size:21rpx;line-height:1.7}.profile-kind-note .my-icon{width:29rpx;height:29rpx}.editor-card{padding:34rpx}.editor-avatar{display:block;width:150rpx;height:150rpx;margin:0 auto 38rpx;border:6rpx solid white;border-radius:50%;box-shadow:0 10rpx 30rpx #cc986119}.editor-card .my-field{margin-top:30rpx}.picker-date{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.picker-date .my-icon{width:25rpx;height:25rpx}.sex-unspecified{font-size:19rpx;color:#b19d8b;text-align:center;line-height:1.8;padding:18rpx 0 0;min-height:42rpx}.condition-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;font-size:23rpx;line-height:1.8;padding:24rpx 0;border-bottom:2rpx solid #f1e8e0}.condition-row:last-child{border:0;padding-bottom:0}.condition-row>text:first-child{color:#92847a;flex:1}.condition-row>text:last-child{max-width:55%;text-align:right;overflow-wrap:anywhere}.health-chips{margin:24rpx 0}
