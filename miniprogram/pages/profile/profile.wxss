.nav-circle { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.edit-button { min-width: 104rpx; height: 62rpx; padding: 0 18rpx; border-radius: 31rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; color: #ff6f70; background: #fff; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.pencil-icon { width: 28rpx; height: 8rpx; border-radius: 4rpx; background: currentColor; transform: rotate(-45deg); }.pencil-icon::after { content: ''; display: block; width: 5rpx; height: 8rpx; background: #fff; transform: translateX(6rpx); }
.profile-scroll { height: calc(100vh - 118rpx - env(safe-area-inset-bottom)); }.profile-page { padding-top: 4rpx; }.profile-hero { min-height: 224rpx; padding: 20rpx; display: flex; }.avatar-wrap { position: relative; width: 180rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }.avatar-wrap > image { width: 170rpx; height: 170rpx; border: 8rpx solid #ffe1e1; border-radius: 50%; }.avatar-camera { position: absolute; right: 0; bottom: 10rpx; width: 54rpx; height: 54rpx; border: 5rpx solid #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: #ff7b7b; }.avatar-camera .camera-icon { width: 27rpx; height: 19rpx; border-width: 4rpx; }.avatar-camera .camera-icon::before { width: 8rpx; height: 8rpx; left: 5rpx; top: 1rpx; border-width: 3rpx; }.avatar-camera .camera-icon::after { width: 11rpx; height: 5rpx; left: 4rpx; top: -8rpx; }.profile-main { min-width: 0; margin-left: 24rpx; flex: 1; }.name-line { display: flex; align-items: center; gap: 13rpx; font-size: 35rpx; font-weight: 700; }.girl-tag { padding: 3rpx 10rpx; border-radius: 18rpx; color: #ee7378; background: #fff0f0; font-size: 18rpx; }.birth-line { margin-top: 11rpx; display: flex; gap: 22rpx; color: #857d78; font-size: 20rpx; }.birth-line text:first-child { padding: 3rpx 10rpx; border-radius: 14rpx; color: #ad625f; background: #fff1ee; }.measurements { margin-top: 25rpx; display: grid; grid-template-columns: repeat(3,1fr); }.measurements > view { display: grid; grid-template-columns: 34rpx 1fr; color: #89817c; font-size: 17rpx; }.measure-icon { grid-row: 1/4; width: 27rpx; height: 27rpx; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 13rpx; background: #ff8f91; }.measure-icon.height { background: #f5bd45; }.measure-icon.head { background: #51bfe3; }.measurements strong { color: #25211f; font-size: 22rpx; }.measurements small { color: #a8a19d; font-size: 16rpx; }
.profile-tip { min-height: 62rpx; margin: 14rpx 0; padding: 12rpx 20rpx; border-radius: 22rpx; display: flex; align-items: center; gap: 12rpx; color: #806451; background: #fff8e4; font-size: 19rpx; }.profile-tip .bulb { width: 18rpx; height: 22rpx; border-radius: 50%; background: #ffc12b; }.profile-tip text { flex: 1; }.profile-tip .chevron { color: #d3914a; }
.info-card { margin-top: 14rpx; padding: 20rpx 24rpx 4rpx; }.info-row { min-height: 64rpx; border-bottom: 1rpx solid #f2ebe7; display: flex; align-items: center; }.info-row:last-child { border-bottom: 0; }.row-badge { width: 30rpx; height: 30rpx; border-radius: 9rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14rpx; font-weight: 700; }.row-badge.coral { background: #ff7d80; }.row-badge.green { background: #5dc965; }.row-badge.yellow { background: #f7bd32; }.row-badge.blue { background: #47bae7; }.row-badge.purple { background: #9b6de6; }.row-badge.orange { background: #f3a145; }.row-label { margin-left: 18rpx; flex: 1; font-size: 24rpx; }.row-value { color: #77706c; font-size: 21rpx; }.row-value.good { color: #6eaa50; }.info-row .chevron { margin-left: 16rpx; color: #c5a99a; }
.love-card { min-height: 110rpx; margin-top: 16rpx; padding: 18rpx 24rpx; display: flex; overflow: hidden; color: #733732; background: linear-gradient(105deg,#fff1ed,#ffe7e3); }.love-card > view { flex: 1; display: flex; flex-direction: column; gap: 9rpx; }.love-card text:first-child { font-size: 27rpx; font-weight: 700; }.love-card text:last-child { color: #88736c; font-size: 19rpx; }.love-card image { width: 120rpx; height: 100rpx; margin: -5rpx 4rpx -18rpx; border-radius: 60rpx 60rpx 10rpx 10rpx; }
.measure-value { color: #25211f; font-size: 22rpx; font-weight: 700; }.measure-date { color: #a8a19d; font-size: 16rpx; }.profile-tip .tip-lead { flex: 0; font-weight: 700; white-space: nowrap; }.profile-tip .tip-body { flex: 1; }
