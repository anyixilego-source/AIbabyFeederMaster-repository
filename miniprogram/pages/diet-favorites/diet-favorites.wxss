@import "../../styles/diet-recipe.wxss";
.collection-list{padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));color:#332724}.nav-back{font-size:52rpx;padding:0 24rpx}.collection-list .title{display:block;font-size:34rpx;font-weight:600}.collection-list .note{display:block;font-size:25rpx;line-height:1.7;color:#8b7b70;margin-top:14rpx}.collection-list .card{margin-top:22rpx;padding:26rpx;background:#fff;border:1rpx solid #f3e2d9;border-radius:28rpx}.collection-list .collection-row{display:flex;align-items:center;gap:20rpx}.collection-list .copy{flex:1;min-width:0;overflow-wrap:anywhere}.collection-list .name{font-size:29rpx;font-weight:600}.collection-list .remove{flex:none;min-height:88rpx;display:flex;align-items:center;color:#a5663f;font-size:25rpx}.collection-list .review{display:block;background:#fff2cc;font-size:24rpx;color:#7d6235;padding:14rpx;border-radius:16rpx;margin-bottom:20rpx}.collection-list .collection-row{gap:16rpx;padding:22rpx 20rpx}.collection-list .collection-thumbnail{width:112rpx;height:112rpx;border-radius:18rpx;background:#fbf2e8;overflow:hidden;flex:none;display:flex;align-items:center;justify-content:center}.collection-list .collection-photo{width:100%;height:100%;display:block}.collection-list .thumbnail-placeholder{font-size:21rpx;color:#9b8067}.collection-list .collection-row .note{font-size:23rpx;line-height:1.5;margin-top:8rpx}.collection-list .remove{font-size:23rpx;min-width:92rpx;text-align:center}

.collection-list .collection-action-slot{width:176rpx;flex:none}.collection-list .remove{width:176rpx;justify-content:flex-end;min-height:88rpx}.collection-list .remove-confirm{display:flex;width:176rpx;animation:confirm-in .16s ease-out}.collection-list .confirm-choice{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;font-size:38rpx}.collection-list .confirm-yes{color:#b96159}.collection-list .confirm-keep{color:#8b7b70}.collection-detail-label{display:flex;justify-content:flex-end;margin-bottom:20rpx}.collection-detail{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}@keyframes confirm-in{from{opacity:0;transform:translateX(6rpx)}to{opacity:1;transform:translateX(0)}}

.collection-list .confirm-choice-icon{width:44rpx;height:44rpx;display:block}
