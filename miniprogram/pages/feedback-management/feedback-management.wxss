@import "../../styles/my-module.wxss";
.management-scroll{flex:1;min-height:0;height:0}.management-shell{padding:18rpx 33rpx calc(55rpx + env(safe-area-inset-bottom))}.ui-card{padding:34rpx;margin:0 0 25rpx;border:2rpx solid #f1e8e0;border-radius:42rpx;background:#fffefd;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045);box-sizing:border-box}.filters{background:transparent;border:0;box-shadow:none;padding:0;margin-bottom:25rpx}.ranges{display:flex;gap:12rpx}.range{flex:1;min-width:0;min-height:64rpx;font-size:20rpx;line-height:1.5;white-space:normal;background:#fffdfa;border:2rpx solid #eee3d9;border-radius:19rpx;margin:0;padding:14rpx 5rpx;color:#3d302a}.range.active{background:#fff0e6;border-color:#f3cfb7;color:#bd805c}.module-filter{display:flex;align-items:center;justify-content:space-between;gap:12rpx;background:#fff0e9;color:#bd805c;font-size:21rpx;line-height:1.7;min-height:75rpx;padding:18rpx 22rpx;border-radius:24rpx;margin:18rpx 0 0}.module-filter text{flex:none;font-size:19rpx}.muted,.status{display:block;font-size:21rpx;color:#a99683;line-height:1.8}.status{text-align:center;padding:32rpx 12rpx}.review-label,.notice{padding:22rpx;border-radius:23rpx;font-size:22rpx;line-height:1.8;color:#af7753;background:#fff4df;margin-bottom:24rpx}.row-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.list-location{min-width:0;flex:1;font-size:28rpx;font-weight:600;line-height:1.6;overflow-wrap:anywhere}.image-count{flex:none;color:#be9a6c;background:#fff4dc;border-radius:14rpx;padding:6rpx 12rpx;font-size:18rpx;line-height:1.5}.excerpt{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:23rpx;line-height:1.9;color:#92847a;margin-top:23rpx;overflow-wrap:anywhere}.list-footer{display:flex;align-items:center;justify-content:space-between;gap:20rpx;border-top:2rpx solid #f1e8e0;padding-top:24rpx;margin-top:25rpx}.time{color:#a99683;font-size:20rpx;line-height:1.7;flex:1;min-width:0}.detail-link{color:#bd9167;font-size:21rpx;line-height:1.6;flex:none}.load-more,.filter-button{font-size:23rpx;background:#fff0e9;color:#bd805c;border-radius:24rpx;padding:19rpx;line-height:1.6}.section-title{display:block;font-size:28rpx;font-weight:600;line-height:1.6}.content,.contact{font-size:25rpx;color:#746355;line-height:1.9;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:20rpx}.detail-meta,.identifier{display:block;font-size:21rpx;color:#ac9783;line-height:1.8;overflow-wrap:anywhere;margin-top:16rpx}.text-action{background:transparent;color:#bd9167;font-size:21rpx;padding:12rpx 0;margin:0;line-height:1.6;min-width:0}.pictures{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin-top:22rpx}.picture{height:150rpx;background:#fbf3e9;border-radius:20rpx;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:19rpx;color:#b29b83;text-align:center}.picture image{width:100%;height:100%}.environment{font-size:21rpx;color:#ac9783;line-height:1.8;margin-top:18rpx}.picker-mask{position:fixed;inset:0;background:#0006;z-index:1000;display:flex;align-items:flex-end}.picker-sheet{width:100%;max-height:85vh;box-sizing:border-box;background:#fffaf6;border-radius:42rpx 42rpx 0 0;padding:32rpx 33rpx calc(28rpx + env(safe-area-inset-bottom))}.trail{white-space:nowrap;font-size:21rpx;color:#b49b82;margin:18rpx 0;line-height:2}.picker-options{max-height:42vh}.module-option{display:flex;align-items:center;justify-content:flex-start;width:100%;margin:0;padding:24rpx 5rpx;border-radius:0;border-bottom:2rpx solid #f1e8e0;background:transparent;color:#3d302a;font-size:24rpx;line-height:1.6}.picker-actions{display:flex;gap:16rpx;margin-top:20rpx}.picker-actions button{flex:1;min-width:0;margin:0;white-space:normal}.filter-button.selected{background:#f9e1d0}
