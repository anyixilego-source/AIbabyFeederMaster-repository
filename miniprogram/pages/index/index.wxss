.home-scroll { height: calc(100vh - 120rpx - env(safe-area-inset-bottom)); }.home-page { padding-top: 0; }
.profile-row { min-height: 112rpx; padding: 8rpx 4rpx 20rpx; display: flex; align-items: center; }.avatar { width: 84rpx; height: 84rpx; border: 5rpx solid rgba(255,255,255,.86); border-radius: 50%; box-shadow: 0 8rpx 20rpx rgba(226,145,117,.2); }.profile-copy { margin-left: 18rpx; flex: 1; display: flex; flex-direction: column; gap: 7rpx; }.name-row { display: flex; align-items: center; gap: 12rpx; }.baby-name { font-size: 34rpx; font-weight: 700; }.gender-mark { min-width: 32rpx; height: 32rpx; padding: 0 7rpx; border-radius: 16rpx; color: #ee7378; background: #fff0f0; font-size: 18rpx; line-height: 32rpx; text-align: center; }.baby-age { color: #81736d; font-size: 24rpx; }
.notice { position: relative; width: 66rpx; height: 66rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #94684d; background: #fff; box-shadow: 0 8rpx 24rpx rgba(148,104,77,.1); }.bell { position: relative; width: 27rpx; height: 29rpx; border: 5rpx solid currentColor; border-radius: 15rpx 15rpx 8rpx 8rpx; }.bell::after { content: ''; position: absolute; left: -9rpx; right: -9rpx; bottom: -6rpx; height: 5rpx; border-radius: 4rpx; background: currentColor; }.bell-clapper { position: absolute; left: 7rpx; bottom: -13rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }.notice-dot { position: absolute; right: 5rpx; top: 4rpx; width: 14rpx; height: 14rpx; border: 3rpx solid #fff; border-radius: 50%; background: #ff6565; }
.hero { height: 192rpx; overflow: hidden; }.hero image { width: 100%; height: 100%; display: block; }
.nutrition-card { margin-top: 22rpx; padding: 24rpx 20rpx 18rpx; }.card-heading { display: flex; align-items: center; justify-content: space-between; }.heading-with-info { display: flex; align-items: center; gap: 12rpx; }.info-icon { width: 28rpx; height: 28rpx; border: 3rpx solid #a5a1a0; border-radius: 50%; color: #999; font-size: 20rpx; font-weight: 700; line-height: 24rpx; text-align: center; }.detail-link { min-height: 52rpx; padding: 0 16rpx; border-radius: 26rpx; display: flex; align-items: center; gap: 7rpx; color: #45b43d; background: #f5fff2; font-size: 22rpx; font-weight: 600; }
.nutrition-body { margin-top: 18rpx; display: flex; }.score-panel { width: 216rpx; display: flex; flex-shrink: 0; flex-direction: column; align-items: center; }.score-arc { width: 174rpx; height: 92rpx; position: relative; overflow: hidden; }.score-arc::before { content: ''; position: absolute; left: 5rpx; top: 8rpx; width: 154rpx; height: 154rpx; border: 15rpx solid #b9e6a8; border-bottom-color: transparent; border-left-color: #8fd273; border-radius: 50%; transform: rotate(-45deg); }.score-number { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: baseline; justify-content: center; color: #10aa21; }.score-number > text:first-child { font-size: 62rpx; font-weight: 800; line-height: 1; }.score-unit { margin-left: 5rpx; font-size: 20rpx; font-weight: 700; }.score-label { margin-top: 4rpx; color: #1eaa2f; font-size: 23rpx; font-weight: 700; }.score-tip { width: 210rpx; margin-top: 15rpx; padding: 10rpx 8rpx; border-radius: 20rpx; display: flex; align-items: center; gap: 8rpx; color: #93664d; background: #fff7ed; font-size: 17rpx; white-space: nowrap; }.bulb-icon { width: 16rpx; height: 20rpx; border-radius: 50% 50% 45% 45%; background: #ffc034; box-shadow: inset 0 -5rpx 0 #f1a600; }
.nutrient-panel { min-width: 0; margin-left: 12rpx; padding: 14rpx 6rpx 10rpx; border-radius: 22rpx; display: flex; flex: 1; justify-content: space-around; background: rgba(252,252,252,.75); }.nutrient-item { width: 86rpx; display: flex; flex-direction: column; align-items: center; gap: 9rpx; }.nutrient-name { height: 32rpx; color: #6f6661; font-size: 19rpx; text-align: center; white-space: nowrap; }.nutrient-ring { width: 70rpx; height: 70rpx; padding: 9rpx; border-radius: 50%; }.ring-inner { width: 100%; height: 100%; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; font-size: 19rpx; font-weight: 700; }
.advice-card { position: relative; min-height: 274rpx; margin-top: 22rpx; padding: 22rpx 20rpx 18rpx; overflow: hidden; background: linear-gradient(115deg,#fff9ef,#fffdfb); }.advice-title { position: relative; z-index: 2; display: flex; align-items: center; gap: 13rpx; }.spark-icon { position: relative; width: 20rpx; height: 20rpx; background: #ff9b2d; transform: rotate(45deg); }.spark-icon::after { content: ''; position: absolute; left: 6rpx; top: -7rpx; width: 8rpx; height: 34rpx; background: #ff9b2d; }.advice-baby { position: absolute; left: 18rpx; bottom: 0; width: 178rpx; height: 218rpx; }.advice-list { margin: -4rpx 0 0 190rpx; }.advice-row { min-height: 68rpx; margin-top: 9rpx; padding: 7rpx 12rpx; border-radius: 17rpx; display: flex; align-items: center; background: rgba(255,255,255,.88); }.food-badge { width: 48rpx; height: 48rpx; border-radius: 14rpx; display: flex; flex-shrink: 0; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 700; }.food-badge.protein { color: #e96e66; background: #fff0ed; }.food-badge.vegetable { color: #61ad46; background: #f1f9e9; }.food-badge.grain { color: #e49b22; background: #fff6df; }.advice-copy { min-width: 0; margin-left: 12rpx; flex: 1; display: flex; flex-direction: column; gap: 3rpx; }.advice-row-title { font-size: 20rpx; font-weight: 700; }.advice-desc { overflow: hidden; color: #847a74; font-size: 16rpx; text-overflow: ellipsis; white-space: nowrap; }.advice-row .chevron { margin-left: 8rpx; color: #b18a74; }
@media (max-width: 360px) { .home-page { padding-left: 24rpx; padding-right: 24rpx; }.score-panel { width: 196rpx; }.nutrient-panel { margin-left: 2rpx; }.nutrient-item { width: 80rpx; }.advice-baby { width: 158rpx; }.advice-list { margin-left: 166rpx; } }
