.home-scroll { height: calc(100vh - 100px); }.home-page { min-height: calc(100vh - 230rpx - env(safe-area-inset-bottom)); padding-top: 0; padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; box-sizing: border-box; }
.profile-row { min-height: 112rpx; padding: 8rpx 4rpx 20rpx; display: flex; align-items: center; }.avatar { width: 84rpx; height: 84rpx; border: 5rpx solid rgba(255,255,255,.86); border-radius: 50%; box-shadow: 0 8rpx 20rpx rgba(226,145,117,.2); }.profile-copy { margin-left: 18rpx; flex: 1; display: flex; flex-direction: column; gap: 7rpx; }.name-row { display: flex; align-items: center; gap: 12rpx; }.baby-name { font-size: 34rpx; font-weight: 700; }.gender-mark { min-width: 32rpx; height: 32rpx; padding: 0 7rpx; border-radius: 16rpx; color: #ee7378; background: #fff0f0; font-size: 18rpx; line-height: 32rpx; text-align: center; }.baby-age { color: #81736d; font-size: 24rpx; }
.hero { position: relative; height: 327rpx; border: 2rpx solid #ffede7; border-radius: 46rpx; overflow: hidden; flex-shrink: 0; background: #ffede5; box-shadow: none; }
.hero .hero-food { position: absolute; right: -54rpx; top: 0; width: 442rpx; height: 100%; display: block; }
.hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg,#fff0e8 3%,rgba(255,240,232,.88) 32%,transparent 62%); pointer-events: none; }
.hero-copy { position: absolute; z-index: 1; top: 44rpx; left: 38rpx; }
.hero-title { display: block; color: #7c492f; font-size: 38.5rpx; font-weight: 700; line-height: 1.3; letter-spacing: 2rpx; }
.hero-description { display: block; margin-top: 12rpx; color: #a17b64; font-size: 21rpx; line-height: 1.7; }
.hero-cta { position: absolute; z-index: 2; left: 32rpx; right: 32rpx; bottom: 28rpx; min-height: 44px; height: 87rpx; padding: 12rpx 24rpx; border: 4rpx solid rgba(255,255,255,.6); border-radius: 33rpx; display: flex; align-items: center; justify-content: center; gap: 15rpx; box-sizing: border-box; color: #fff; background: linear-gradient(110deg,#ff8a7e,#ff7577); box-shadow: 0 13rpx 33rpx rgba(255,123,118,.15); font-size: 27rpx; font-weight: 600; }
.hero-cta text { white-space: nowrap; }
.hero-camera-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; background: url("data:image/svg+xml;base64,") center / contain no-repeat; }
.nutrition-card { margin-top: 22rpx; padding: 24rpx 20rpx 18rpx; }.card-heading { display: flex; align-items: center; justify-content: space-between; }.heading-with-info { display: flex; align-items: center; gap: 12rpx; }.info-icon { width: 28rpx; height: 28rpx; border: 3rpx solid #a5a1a0; border-radius: 50%; color: #999; font-size: 20rpx; font-weight: 700; line-height: 24rpx; text-align: center; }.detail-link { min-height: 52rpx; padding: 0 16rpx; border-radius: 26rpx; display: flex; align-items: center; gap: 7rpx; color: #45b43d; background: #f5fff2; font-size: 22rpx; font-weight: 600; }
.report-summary { min-height: 112rpx; margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 22rpx; display: flex; align-items: center; gap: 18rpx; background: linear-gradient(115deg,#fff7ee,#fffdf9); box-sizing: border-box; }.report-summary-icon { width: 96rpx; height: 104rpx; border-radius: 31rpx; display: flex; flex-shrink: 0; align-items: center; justify-content: center; background: linear-gradient(150deg,#ff9b89,#ff7b80); }.report-summary-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 8rpx; }.report-summary-title { color: #3a302c; font-size: 25rpx; font-weight: 700; }.report-summary-desc { color: #92847a; font-size: 23rpx; line-height: 1.7; overflow-wrap: break-word; }.report-summary > .chevron { color: #b48e78; }
.advice-card { position: relative; margin-top: 22rpx; padding: 22rpx 20rpx 18rpx; overflow: hidden; display: flex; flex-direction: column; box-sizing: border-box; background: linear-gradient(115deg,#fff9ef,#fffdfb); }.advice-title { position: relative; z-index: 2; display: flex; align-items: center; gap: 13rpx; }.spark-icon { position: relative; width: 20rpx; height: 20rpx; background: #ff9b2d; transform: rotate(45deg); }.spark-icon::after { content: ''; position: absolute; left: 6rpx; top: -7rpx; width: 8rpx; height: 34rpx; background: #ff9b2d; }.advice-content { margin-top: 10rpx; display: flex; align-items: center; gap: 18rpx; }.advice-baby { width: 190rpx; height: 260rpx; border-radius: 94rpx 94rpx 24rpx 24rpx; flex-shrink: 0; }.advice-list { min-width: 0; margin: 0; flex: 1; }.advice-row { min-height: 76rpx; margin-top: 10rpx; padding: 7rpx 10rpx; border-radius: 17rpx; display: flex; align-items: center; background: rgba(255,255,255,.88); }.food-badge { width: 48rpx; height: 48rpx; border-radius: 14rpx; display: flex; flex-shrink: 0; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 700; }.food-badge.protein { color: #e96e66; background: #fff0ed; }.food-badge.vegetable { color: #61ad46; background: #f1f9e9; }.food-badge.grain { color: #e49b22; background: #fff6df; }.advice-copy { min-width: 0; margin-left: 10rpx; flex: 1; display: flex; flex-direction: column; gap: 3rpx; }.advice-row-title { font-size: 20rpx; font-weight: 700; }.advice-desc { overflow: hidden; color: #847a74; font-size: 16rpx; text-overflow: ellipsis; white-space: nowrap; }.advice-row .chevron { margin-left: 6rpx; color: #b18a74; }
@media (max-width: 360px) { .home-page { padding-left: 24rpx; padding-right: 24rpx; }.advice-content { gap: 12rpx; }.advice-baby { width: 168rpx; height: 240rpx; }.advice-row { padding-left: 7rpx; padding-right: 7rpx; } }
.home-menu-card{margin-top:25rpx;padding:35rpx;border:2rpx solid #f2eae3;border-radius:42rpx;background:#fffdfb;box-shadow:0 8rpx 38rpx rgba(80,48,22,.035)}
.home-menu-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:25rpx}.home-menu-title{font-size:31rpx;font-weight:600;color:#3d302a;line-height:1.4;min-width:0}
.home-menu-preview{display:flex;align-items:center;gap:23rpx;min-width:0}.home-menu-photo{width:129rpx;height:129rpx;border-radius:31rpx;display:block;flex-shrink:0;background:#fff0e8}.home-menu-copy{min-width:0;flex:1}.home-menu-name{display:block;color:#3d302a;font-size:27rpx;font-weight:600;line-height:1.5;overflow-wrap:break-word;word-break:break-all;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.home-menu-meta{display:block;margin:11rpx 0;color:#92847a;font-size:23rpx;line-height:1.7}.home-menu-tags{display:flex;gap:13rpx;flex-wrap:wrap;min-width:0}.home-menu-tag{display:block;max-width:100%;padding:6rpx 13rpx;border-radius:13rpx;background:#f0f6e8;color:#809e61;font-size:20rpx;line-height:1.4;overflow-wrap:break-word;word-break:break-all}.home-menu-time{background:#fff3dd;color:#c69a50;white-space:nowrap}.home-menu-chevron{color:#c6b1a1;flex-shrink:0;width:11rpx;height:11rpx}.home-menu-divider{height:2rpx;background:#f1e8e0;margin:29rpx 0}.home-menu-week{display:flex;align-items:center;justify-content:center;width:100%;min-height:93rpx;padding:19rpx 31rpx;border-radius:33rpx;background:#fff0e8;color:#b98264;font-size:29rpx;font-weight:600;line-height:1.4;box-sizing:border-box}.home-menu-week[disabled]{opacity:.65;background:#fff0e8;color:#b98264}.home-menu-message{display:block;color:#92847a;font-size:24rpx;line-height:1.7;overflow-wrap:break-word}.home-menu-progress{display:block;margin-top:10rpx;color:#92847a;font-size:20rpx;line-height:1.5}

.home-page > view{flex-shrink:0}

.report-chart-icon { width: 52rpx; height: 52rpx; background: url("data:image/svg+xml;base64,") center / contain no-repeat; }

.advice-list .advice-row{min-height:78rpx;margin-top:0;padding:13rpx 0;border-radius:0;background:transparent;border-bottom:2rpx solid #f3eadd;gap:12rpx;box-sizing:border-box}.advice-list .advice-copy{margin-left:0;gap:6rpx}.advice-list .advice-row-title{font-size:23rpx;font-weight:400;line-height:1.7;color:#3d302a;overflow-wrap:break-word}.advice-list .advice-desc{font-size:20rpx;line-height:1.6;white-space:normal;overflow:visible;overflow-wrap:break-word}.advice-list .advice-row .chevron{margin-left:0;flex-shrink:0;width:11rpx;height:11rpx;color:#c6b1a1}

.home-menu-card .home-menu-week{width:100%;margin:0;height:93rpx;min-height:44px}

.home-menu-date{flex-shrink:0;font-size:22rpx;font-weight:400;line-height:1.4;white-space:nowrap;color:#ad7b39;background:#fff1d9;border-radius:28rpx;padding:10rpx 16rpx}.advice-list .advice-row-title{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
