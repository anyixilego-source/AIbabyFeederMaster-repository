<navigation-bar title="家庭与照护" back="{{false}}" color="#3d302a" background="transparent"><view slot="left" class="my-nav" bindtap="goBack"><view/></view></navigation-bar>
<scroll-view class="my-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="my-shell family-shell">
 <view wx:if="{{loading}}" class="my-state">正在读取家庭资料…</view><view wx:if="{{errorMessage}}" class="my-error">{{errorMessage}}<button wx:if="{{canSwitch && !subjectId}}" class="my-secondary" bindtap="switchBaby">选择宝宝</button><button wx:else class="my-secondary" bindtap="load">重新读取</button></view>
 <block wx:if="{{subjectId && !errorMessage}}">
 <view class="my-card family-current"><view class="my-heading"><text class="my-title">当前宝宝</text><button wx:if="{{canSwitch}}" class="family-link" bindtap="switchBaby" disabled="{{busy}}">切换 ›</button></view><view class="family-baby"><image src="/assets/baby-avatar-v2.jpg" mode="aspectFill"/><view><text class="family-name">{{babyName}}</text><text class="my-sub">{{ageText}} · {{roleLabel}}</text></view></view></view>
 <view class="my-card"><view class="my-heading"><text class="my-title">照护成员</text><button wx:if="{{canManage}}" class="family-link" bindtap="openInvite" disabled="{{busy}}">邀请</button></view>
 <view wx:for="{{members}}" wx:key="accountId" class="my-row" data-id="{{item.accountId}}" bindtap="openMember"><view class="my-icon-box {{item.role==='OWNER'?'green':''}}"><view class="family-people"/></view><text class="my-label">{{item.displayName}}</text><text class="my-value">{{item.roleLabel}}</text><text wx:if="{{item.isSelf || (canManage && item.role!=='OWNER')}}" class="my-chevron">›</text></view>
 <view wx:for="{{invitations}}" wx:key="invitationId" class="family-invitation"><text>{{item.applicantName || item.displayName}}</text><text class="my-small">{{item.applicationStatus==='PENDING'?'申请加入，等待批准':'邀请已准备，等待申请'}}</text><view class="family-actions"><button wx:if="{{item.applicationStatus==='PENDING'}}" data-id="{{item.invitationId}}" data-action="approve" bindtap="invitationAction" disabled="{{busy}}">批准</button><button wx:if="{{item.applicationStatus==='PENDING'}}" data-id="{{item.invitationId}}" data-action="reject" bindtap="invitationAction" disabled="{{busy}}">拒绝</button><button wx:else data-id="{{item.invitationId}}" data-action="revoke" bindtap="invitationAction" disabled="{{busy}}">撤销邀请</button></view></view>
 <button wx:if="{{canLeave}}" class="family-leave" bindtap="leave" disabled="{{busy}}">退出此宝宝的照护</button></view>
 <view class="my-card"><text class="my-title">我的登录会话</text><view wx:for="{{sessions}}" wx:key="sessionId" wx:if="{{item.current || sessionPanel}}" class="my-row" data-id="{{item.sessionId}}" bindtap="revokeSession"><view class="my-icon-box {{item.current?'green':'yellow'}}"><view class="my-icon {{item.current?'shield':'lock'}}"/></view><view class="family-session"><text>{{item.current?'当前会话':item.deviceLabel || '其他会话'}}</text><text class="my-small">{{item.timeText}}</text></view><text class="my-value">{{item.current?'使用中':'退出'}}</text><text class="my-chevron">›</text></view><view class="my-row" bindtap="toggleSessions"><view class="my-icon-box yellow"><view class="my-icon lock"/></view><text class="my-label">其他会话</text><text class="my-value">{{sessionPanel?'收起':'查看'}}</text><text class="my-chevron">›</text></view></view>
 <view class="my-disclosure"><view class="my-disclosure-toggle" bindtap="toggleInfo"><text>家庭说明</text><text>{{showInfo?'−':'+'}}</text></view><view wx:if="{{showInfo}}" class="my-disclosure-body"><text class="my-sub">管理员管理宝宝资料和成员；可记录成员可修改、删除大家共同创建的餐食和奶量；仅查看成员不能写记录。旧版本修改会提示重新核对。</text><text class="my-sub">共享宝宝档案、家庭回避食材、餐食、奶量及报告。当前宝宝的菜单由管理员统一维护，其他成员只读；AI同意、收藏、点赞、次数和反馈仍为个人范围。退出或移除不删除历史。</text><text class="my-sub">本宝宝有权成员可看已同步的餐食照片。新照片经本人同意才同步，默认保留30天；旧图不自动补传，到期以默认配图展示。已保存至他人设备的图片无法远程擦除。</text><view class="family-photo-setting" bindtap="togglePhoto"><text>同步我新记录的餐食照片</text><switch checked="{{photoConsent}}" disabled color="#d49c70"/></view><button wx:if="{{photoConsent}}" class="my-secondary" bindtap="retryPhotos" loading="{{photoBusy}}">重试待同步照片</button><text class="my-small">更改同步选择只影响后续上传。本人会话不等同物理设备，不会退出其他家庭成员的微信。</text></view></view>
 </block>
</view></scroll-view>
<view wx:if="{{invitePanel || memberPanel}}" class="family-mask" bindtap="{{invitePanel?'closeInvite':'closeMember'}}"><view class="family-panel" catchtap="noop"><view class="my-heading"><text class="my-title">{{invitePanel?'邀请照护者':selfNamePanel?'我的称呼':'成员权限'}}</text><button class="family-link" bindtap="{{invitePanel?'closeInvite':'closeMember'}}">关闭</button></view>
 <block wx:if="{{invitePanel}}"><input class="my-input" maxlength="40" placeholder="给家人的称呼，如爸爸、外婆" value="{{inviteName}}" disabled="{{busy || shareReady}}" bindinput="setInviteName"/><view class="my-choices"><button class="my-choice {{inviteRole==='CAREGIVER'?'active':''}}" data-role="CAREGIVER" bindtap="setInviteRole" disabled="{{busy || shareReady}}">可记录</button><button class="my-choice {{inviteRole==='VIEWER'?'active':''}}" data-role="VIEWER" bindtap="setInviteRole" disabled="{{busy || shareReady}}">仅查看</button></view><text class="my-sub">邀请7天有效，仅一人可申请；你批准后才可访问宝宝资料。</text><button wx:if="{{!shareReady}}" class="my-primary" bindtap="createInvite" loading="{{busy}}" disabled="{{busy}}">准备邀请</button><block wx:else><text class="my-small">有效至{{inviteExpires}}。关闭后可在邀请列表撤销。</text><button class="my-primary" open-type="share">分享给家人</button></block></block>
 <block wx:elif="{{selfNamePanel}}"><input class="my-input" maxlength="40" placeholder="填写自己的称呼，如妈妈" value="{{memberName}}" bindinput="setMemberName"/><button class="my-primary" bindtap="saveSelfName" loading="{{busy}}" disabled="{{busy}}">保存称呼</button></block><block wx:else><input class="my-input" maxlength="40" value="{{memberName}}" bindinput="setMemberName"/><view class="my-choices"><button class="my-choice {{memberRole==='CAREGIVER'?'active':''}}" data-role="CAREGIVER" bindtap="setMemberRole">可记录</button><button class="my-choice {{memberRole==='VIEWER'?'active':''}}" data-role="VIEWER" bindtap="setMemberRole">仅查看</button></view><button class="my-primary" bindtap="saveMember" loading="{{busy}}" disabled="{{busy}}">保存权限</button><button class="family-leave" bindtap="removeMember" disabled="{{busy}}">移除照护权限</button></block>
</view></view>
