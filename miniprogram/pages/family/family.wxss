@import "../../styles/my-module.wxss";
.family-shell{padding-top:32rpx}.family-shell .my-card{padding:36rpx;margin-bottom:26rpx}.family-shell .my-title{font-size:32rpx}.family-shell .my-heading{min-height:50rpx}.family-current{min-height:178rpx}.family-baby{display:flex;align-items:center;gap:24rpx;padding:28rpx 0 6rpx}.family-baby>image{width:94rpx;height:94rpx;border:7rpx solid white;border-radius:50%;flex:none;box-shadow:0 10rpx 30rpx #cc986119}.family-name{display:block;font-size:36rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.family-link{margin:0;padding:6rpx 0 6rpx 20rpx;min-height:70rpx;min-width:70rpx;line-height:58rpx;background:transparent;color:#c79469;font-size:24rpx;flex:none;border-radius:0}.family-link::after{border:0}.family-session{flex:1;min-width:0;font-size:26rpx}.family-session .my-small{display:block;font-size:19rpx}.family-people{width:34rpx;height:34rpx;background-size:contain;background-repeat:no-repeat}.family-invitation{padding:22rpx 0;border-top:2rpx solid #f1e8e0;font-size:25rpx}.family-invitation>.my-small{display:block;margin-top:8rpx}.family-actions{display:flex;gap:18rpx;margin-top:12rpx}.family-actions button{font-size:23rpx;background:#fff0e6;color:#b9825d;border-radius:16rpx;margin:0;padding:4rpx 24rpx;line-height:64rpx}.family-actions button::after{border:0}.family-leave{background:transparent;color:#b9877e;font-size:23rpx;margin:16rpx 0 0;line-height:75rpx}.family-leave::after{border:0}.family-mask{position:fixed;inset:0;background:#3d302a60;z-index:300;display:flex;align-items:flex-end}.family-panel{box-sizing:border-box;background:#fffaf6;width:100%;border-radius:36rpx 36rpx 0 0;padding:26rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));max-height:85vh;overflow-y:auto}.family-panel .my-input{margin-top:24rpx}.family-panel .my-choices{margin-top:24rpx}.family-panel .my-choice{flex:1;width:0}.family-panel .my-primary{margin-top:28rpx;max-width:none;width:100%}.family-panel .my-sub{margin:24rpx 0}.family-photo-setting{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:22rpx;padding:20rpx 0}.family-photo-setting switch{transform:scale(.8);pointer-events:none;flex:none}.family-shell .my-sub{line-height:1.8}

.family-people{background-image:url("data:image/svg+xml;base64,")}

.family-shell .my-heading .family-link,.family-panel .my-heading .family-link{width:auto;max-width:none;margin-left:auto;padding-right:0;min-width:60rpx;text-align:right}.family-session .my-small{white-space:normal;overflow-wrap:anywhere}
