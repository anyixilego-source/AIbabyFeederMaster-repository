@import "../../styles/my-module.wxss";
.family-dish{display:flex;align-items:center;gap:22rpx;margin-top:22rpx}.family-dish+.family-dish{padding-top:24rpx;border-top:2rpx solid #f1e8e0}.family-image{width:129rpx;height:129rpx;border-radius:30rpx;flex:none;background:#fff0e7}.family-copy{flex:1;min-width:0}.family-name{display:block;font-size:27rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.family-copy .my-small{margin-top:17rpx}.family-draft{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:25rpx;line-height:1.7;color:#92847a;margin-top:25rpx}.family-draft>text:first-child{flex:1;min-width:0;overflow-wrap:anywhere}.family-draft .my-chip{background:#fff4dc;color:#c89b55;flex:none}.draft-empty{margin-top:22rpx}.source-list{margin:22rpx 0}.source-recipe{border-bottom:2rpx solid #f1e8e0;padding:16rpx 0}
