.nav-circle { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; box-shadow: 0 8rpx 24rpx rgba(113,78,60,.08); }.menu-scroll { height: 100vh; }.menu-page { padding-top: 6rpx; }.menu-hero { min-height: 142rpx; padding: 26rpx 28rpx; display: flex; align-items: center; background: linear-gradient(110deg,#fff2eb,#fffaf4); }.menu-hero > view:first-child { flex: 1; display: flex; flex-direction: column; gap: 10rpx; }.menu-hero > view:first-child text:first-child { font-size: 31rpx; font-weight: 700; }.menu-hero > view:first-child text:last-child { color: #81736d; font-size: 22rpx; }.candidate-count { width: 90rpx; height: 90rpx; border-radius: 50%; display: flex; align-items: baseline; justify-content: center; padding-top: 20rpx; color: #fff; background: #ff7375; font-size: 35rpx; font-weight: 700; }.candidate-count text { margin-left: 3rpx; font-size: 18rpx; }.boundary-card { margin: 16rpx 0 24rpx; padding: 18rpx 22rpx; border-radius: 20rpx; display: flex; flex-direction: column; gap: 6rpx; color: #7a6351; background: #fff4dc; font-size: 21rpx; line-height: 1.5; }.section-heading { margin: 26rpx 4rpx 14rpx; display: flex; align-items: center; justify-content: space-between; }.section-heading > text:last-child { color: #918681; font-size: 20rpx; }.candidate-card { min-height: 116rpx; margin-bottom: 12rpx; padding: 20rpx 22rpx; display: flex; align-items: center; }.candidate-badge { width: 56rpx; height: 56rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #69bd55; font-weight: 700; }.candidate-copy { min-width: 0; margin-left: 18rpx; flex: 1; display: flex; flex-direction: column; gap: 8rpx; }.candidate-copy text:first-child { font-size: 27rpx; font-weight: 700; }.candidate-copy text:last-child { color: #8a817d; font-size: 20rpx; }.recipe-card { margin-bottom: 12rpx; padding: 22rpx 24rpx; }.recipe-top { display: flex; align-items: center; justify-content: space-between; }.recipe-top > text:first-child { font-size: 27rpx; font-weight: 700; }.recipe-status { padding: 5rpx 13rpx; border-radius: 99rpx; color: #d08a1d; background: #fff1d5; font-size: 19rpx; }.recipe-status.published { color: #55a945; background: #eef8e8; }.recipe-card > text { display: block; margin-top: 10rpx; color: #81736d; font-size: 21rpx; }.recipe-meta { margin-top: 15rpx; display: flex; gap: 24rpx; color: #a09792; font-size: 19rpx; }.empty-card { padding: 34rpx 26rpx; display: flex; flex-direction: column; gap: 10rpx; text-align: center; }.empty-card text:first-child { font-size: 26rpx; font-weight: 700; }.empty-card text:last-child { color: #8a817d; font-size: 21rpx; line-height: 1.5; }.empty-card.compact { padding: 26rpx; }.avoidance-row { min-height: 82rpx; margin-bottom: 10rpx; padding: 18rpx 22rpx; display: flex; align-items: center; justify-content: space-between; }.avoidance-row text:first-child { font-weight: 700; }.avoidance-row text:last-child { color: #8a817d; font-size: 20rpx; }.state-panel .secondary-button { width: 260rpx; margin-top: 24rpx; }
