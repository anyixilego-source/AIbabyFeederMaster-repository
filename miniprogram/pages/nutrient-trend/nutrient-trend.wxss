@import "../../styles/report-page-header.wxss";
page{background:linear-gradient(160deg,#fff8f2 0,#fffcf9 58%,#fffaf6 100%);color:#3d302a}.page-shell{padding:18rpx 33rpx 0;box-sizing:border-box;min-height:100vh}.trend-nav-title{font-size:34rpx;font-weight:600;white-space:nowrap}.trend-nav-back{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:50%;background:#fff;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045)}.trend-nav-back>view{width:20rpx;height:20rpx;border-left:4rpx solid #3d302a;border-bottom:4rpx solid #3d302a;transform:rotate(45deg);margin-left:7rpx}.detail-mode-row{min-height:84rpx;gap:18rpx;margin-bottom:22rpx}.trend-date{font-size:23rpx;color:#92847a;line-height:1.6;flex:1;min-width:0}.review{padding:15rpx;background:#fff0cc;color:#82600f;font-size:23rpx;border-radius:15rpx;margin-bottom:18rpx}
.card{margin:0 0 25rpx;padding:34rpx;border:2rpx solid #f2eae3;border-radius:42rpx;background:#fffefd;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045);box-sizing:border-box}.heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:31rpx;font-weight:600;line-height:1.5}.heading>text:first-child{min-width:0;overflow-wrap:anywhere}.unit-label{font-size:21rpx;font-weight:400;color:#92847a;flex:none}.scope-note{display:block;font-size:19rpx;color:#92847a;line-height:1.7;margin-top:21rpx;overflow-wrap:anywhere}.sub{display:block;font-size:22rpx;color:#92847a;line-height:1.75;margin:12rpx 0;overflow-wrap:anywhere}.error{background:#fff0ec;color:#be7b6d;font-size:23rpx;line-height:1.7}.button{margin-top:22rpx;background:#fff0df;color:#ac754d;font-size:25rpx;border-radius:22rpx}.button::after{border:0}.loading-card{color:#92847a;text-align:center;padding:36rpx;font-size:23rpx}
.tabs{display:flex;gap:12rpx;margin:0 0 19rpx}.tab{flex:1;min-width:0;text-align:center;font-size:20rpx;white-space:nowrap;border:2rpx solid #f0e6de;border-radius:20rpx;padding:17rpx 3rpx;line-height:1.5;box-sizing:border-box;background:#fffcf9}.tab.active{background:#fff0e6;border-color:#f5d3bc;color:#b77d55}.nutrient-options{width:100%;margin-bottom:21rpx;white-space:nowrap}.nutrient-options-row{display:inline-flex;gap:12rpx;padding:3rpx 0}.nutrient-option{display:inline-flex;align-items:center;min-height:54rpx;padding:0 22rpx;border-radius:40rpx;color:#92847a;background:#f6f2ec;font-size:21rpx;box-sizing:border-box}.nutrient-option.active{background:#f7e1cc;color:#ad7448}
.chart{display:flex;height:329rpx;margin:50rpx 0 0}.axis{position:relative;width:69rpx;flex:none;overflow:visible;font-size:18rpx;color:#ae9a86}.axis-label{position:absolute;right:28rpx;transform:translateY(50%);white-space:nowrap;line-height:1.3}.axis-label.reference-value{color:#bb9166}.axis-label.alternate{right:86rpx}.axis.wide-axis{width:130rpx}.plot{position:relative;flex:1;min-width:0;border-bottom:2rpx solid #e7dcd1}.grid-line{position:absolute;left:0;right:0;border-top:2rpx solid #eee5dd;pointer-events:none}.axis-tick{position:absolute;left:-22rpx;width:13rpx;top:-1rpx;border-top:2rpx solid #baaa99}.columns{display:flex;height:100%;gap:8rpx;padding:0 12rpx}.column{flex:1;min-width:0;height:100%;position:relative;display:flex;align-items:flex-end;justify-content:center}.bar{width:75%;min-height:0;border-radius:12rpx 12rpx 0 0;background:linear-gradient(#a8c986,#d7e5ba)}.bar.latest{background:linear-gradient(#ffb69c,#ffdbba)}.bar.partial{background:repeating-linear-gradient(135deg,#aecb90,#aecb90 7rpx,#e7efd9 7rpx,#e7efd9 14rpx)}.bar.partial.latest{background:repeating-linear-gradient(135deg,#ffbb9f,#ffbb9f 7rpx,#ffdfc9 7rpx,#ffdfc9 14rpx)}.bar.uncertain,.bar.uncertain.latest{background:repeating-linear-gradient(135deg,#bbb6ae,#bbb6ae 7rpx,#eae5de 7rpx,#eae5de 14rpx)}.bar-value{position:absolute;bottom:12rpx;font-size:23rpx;color:#b4a18c;white-space:nowrap;font-variant-numeric:tabular-nums}.ref-line{position:absolute;left:-22rpx;right:0;border-top:2rpx dashed #c29b72;pointer-events:none}.ref-label{position:absolute;right:0;bottom:8rpx;max-width:100%;font-size:17rpx;color:#bb9166;line-height:1.5;text-align:right;background:#fffefd;overflow-wrap:anywhere}.range-reference-labels{margin-top:18rpx;display:flex;flex-wrap:wrap;gap:10rpx 20rpx;color:#bb9166;font-size:18rpx;line-height:1.6}.dates{display:flex;margin-left:69rpx;gap:8rpx;padding:0 12rpx}.dates.wide-dates{margin-left:130rpx}.date-label{flex:1;min-width:0;text-align:center;font-size:17rpx;color:#b09b88;padding:16rpx 0 10rpx;line-height:1.5}
.comparison-note{display:flex;align-items:center;gap:15rpx;background:#fff6e2;color:#b9915d;border-radius:27rpx;padding:20rpx 23rpx;font-size:19rpx;line-height:1.7;margin-top:0}.comparison-note>text{flex:1;min-width:0;overflow-wrap:anywhere}.calendar-icon{width:28rpx;height:28rpx;flex:none;background:url("data:image/svg+xml;base64,") center/contain no-repeat}.reference-source{display:block;font-size:18rpx;color:#b19c88;line-height:1.7;margin-top:16rpx;overflow-wrap:anywhere}.legend-note{display:block;font-size:19rpx;color:#9f8973;line-height:1.7;margin-top:10rpx}
.day-link{display:flex;align-items:center;gap:12rpx;flex:none;min-height:64rpx;font-size:21rpx;font-weight:400;color:#bb8d56}.day-link>text{font-size:31rpx}.day-value-row{display:flex;justify-content:space-between;align-items:baseline;gap:20rpx;margin-top:23rpx}.day-value-label{font-size:23rpx;line-height:1.6;color:#92847a}.day-value{display:flex;align-items:baseline;gap:4rpx;font:600 51rpx/1.2 Arial,sans-serif;min-width:0;overflow-wrap:anywhere;color:#514139}.day-value>text:first-child{min-width:0;overflow-wrap:anywhere}.day-unit{font-size:20rpx;font-weight:400;flex:none}.day-value.unavailable{font-size:31rpx;font-weight:400;color:#ae9a86}
.report-disclosure{padding:0 4rpx}.disclosure-heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx;min-height:91rpx;border-bottom:2rpx solid #f1e8e0;color:#bb8d56;font-size:23rpx;line-height:1.6}.disclosure-body{padding:16rpx 0 20rpx}.chart-legend{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx 16rpx;margin-top:22rpx;font-size:20rpx;color:#92847a;line-height:1.6}.legend-item{display:flex;align-items:center;gap:12rpx;min-width:0}.legend-swatch{width:38rpx;height:24rpx;border-radius:4rpx;flex:none}.legend-symbol{width:38rpx;text-align:center;flex:none;font-size:24rpx}.legend-line{width:38rpx;flex:none;border-top:2rpx dashed #c29b72}.exclusions-toggle{font-size:22rpx;color:#bb8d56;line-height:1.7;padding:24rpx 0 14rpx}.exclusion-row{padding:20rpx 0;border-bottom:2rpx solid #f1e8e0;font-size:21rpx;color:#92847a;line-height:1.7;overflow-wrap:anywhere}.row-title{display:block;color:#795f4f;margin-bottom:6rpx}.bottom-space{height:90rpx}

.date-label.selected{color:#bb8d56;font-weight:600}

.bar.information{background:#c5ae93;}

.bar{position:relative;overflow:hidden}.bar-ai-piece{position:absolute;top:0;left:0;width:100%;background:#b49ad9}.ai-day-source{display:flex;flex-direction:column;gap:10rpx;color:#7350a1;font-size:24rpx;margin-top:20rpx}.ai-source-legend{display:flex;gap:24rpx;font-size:23rpx;color:#8d7e6a;margin:15rpx 0}.ai-source-legend text:last-child{color:#7350a1}
