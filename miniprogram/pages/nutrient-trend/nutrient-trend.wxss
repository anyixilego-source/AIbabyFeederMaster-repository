@import "../../styles/report-page-header.wxss";
@import "../../styles/report-controls.wxss";
page{background:#fff9f4;color:#332724}.page-shell{padding:24rpx 28rpx 180rpx}.card{background:#fff;border:1rpx solid #efe3da;border-radius:26rpx;margin:20rpx 0;padding:28rpx;box-shadow:0 7rpx 25rpx #795b3610}.heading{font-size:32rpx;font-weight:700;display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx}.sub,.scope-note{display:block;color:#8a7d73;font-size:24rpx;line-height:1.6;margin:12rpx 0}.headline{display:block;font-size:38rpx;font-weight:700;line-height:1.35;margin:10rpx 0}.eyebrow{font-size:23rpx;color:#b17956}.row{padding:22rpx 0;border-bottom:1rpx solid #f4ede7;font-size:27rpx;line-height:1.6}.row:last-child{border-bottom:0}.row-title{font-weight:600;display:block}.link{color:#c57952;font-size:25rpx}.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8rpx}.day{padding:14rpx 2rpx;text-align:center;border-radius:12rpx;background:#faf4ed;font-size:23rpx}.dot{display:block;color:#db9a75;font-size:22rpx}.tabs{display:flex;gap:8rpx;flex-wrap:wrap;margin:16rpx 0}.tab{font-size:23rpx;border-radius:22rpx;background:#f7f0e8;padding:10rpx 20rpx}.tab.active{background:#dd9973;color:white}.button{font-size:25rpx;background:#fbf2e9;color:#a5663f;border-radius:18rpx;margin:15rpx 0}.error{background:#fff1ed;color:#9c5344}.review{font-size:23rpx;background:#fff0cc;color:#82600f;border-radius:14rpx;padding:14rpx 20rpx;margin-bottom:18rpx}.updated{font-size:21rpx;color:#a3978d;text-align:center;margin:25rpx 0}.metric{font-size:58rpx;font-weight:700;color:#a87955}.knowledge-title{font-weight:600;display:block;margin-bottom:6rpx}.source{display:block;font-size:22rpx;color:#b2967f;margin-top:10rpx}.nav-back{font-size:60rpx}.chart{display:flex;margin:25rpx 0 0;height:370rpx}.axis{width:74rpx;display:flex;flex-direction:column;justify-content:space-between;color:#948678;font-size:22rpx;padding-bottom:0}.plot{position:relative;flex:1;border-left:1rpx solid #dfd1c4;border-bottom:1rpx solid #dfd1c4}.columns{display:flex;height:100%;gap:8rpx;padding:0 8rpx}.column{flex:1;height:100%;position:relative;display:flex;align-items:flex-end;justify-content:center}.bar{width:75%;background:#dba57e;border-radius:6rpx 6rpx 0 0;min-height:0}.bar.partial{background:repeating-linear-gradient(135deg,#daa57b,#daa57b 7rpx,#f8dfca 7rpx,#f8dfca 14rpx)}.bar.uncertain{background:repeating-linear-gradient(135deg,#b5b3b1,#b5b3b1 7rpx,#e9e7e5 7rpx,#e9e7e5 14rpx)}.bar-value{position:absolute;font-size:20rpx;color:#665247;white-space:nowrap}.ref-line{position:absolute;left:0;right:0;border-top:2rpx dashed #98ac97;pointer-events:none}.dates{display:flex;margin-left:74rpx;gap:8rpx;padding:0 8rpx}.date-label{flex:1;text-align:center;font-size:21rpx;color:#88786c;padding:16rpx 0}.legend{font-size:22rpx;color:#88786c;line-height:1.7;margin-top:18rpx}.line-label{font-size:23rpx;color:#648265;display:block}.metadata{word-break:break-all;font-size:21rpx;color:#99867a;line-height:1.8}
.chart-legend{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx 16rpx;margin-top:20rpx;font-size:22rpx;color:#88786c;line-height:1.5}.legend-item{display:flex;align-items:center;gap:12rpx;min-width:0}.chart-legend .legend-swatch{width:38rpx;height:24rpx;border-radius:4rpx;flex-shrink:0}.legend-symbol{width:38rpx;text-align:center;flex-shrink:0;font-size:25rpx;color:#665247}.legend-line{width:38rpx;flex-shrink:0;border-top:2rpx dashed #98ac97}.legend-note{display:block;font-size:22rpx;color:#88786c;line-height:1.6;margin-top:14rpx}
.axis{position:relative;width:92rpx;flex:none;display:block;overflow:visible;font-size:21rpx}.axis-label{position:absolute;right:14rpx;transform:translateY(50%);white-space:nowrap;line-height:1.3}.axis-label.reference-value{color:#648265;font-weight:600}.axis-label.alternate{right:76rpx}.axis.wide-axis{width:158rpx}.axis-tick{position:absolute;left:-8rpx;width:8rpx;border-top:1rpx solid #c8b7a6;pointer-events:none}.dates{margin-left:92rpx}.dates.wide-dates{margin-left:158rpx}.nutrient-options{width:100%;margin:0 0 18rpx;white-space:nowrap}.nutrient-options-row{display:inline-flex;gap:12rpx;padding:4rpx 0}.nutrient-option{display:inline-flex;align-items:center;min-height:58rpx;padding:0 22rpx;box-sizing:border-box;border:1rpx solid #efdfd2;border-radius:18rpx;color:#997354;background:#fff;font-size:24rpx}.nutrient-option.active{color:#a2663e;background:#fff0dd;border-color:#e6ba90}.tabs{flex-wrap:nowrap}.tab{flex:1;text-align:center;padding:12rpx 8rpx;white-space:nowrap;font-size:22rpx}.bar-value{font-variant-numeric:tabular-nums}.plot{min-width:0}

.trend-nav-title{font-size:17px;font-weight:700;white-space:nowrap;line-height:1.4}
