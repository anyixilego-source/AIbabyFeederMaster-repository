<navigation-bar back="{{false}}" color="#3d302a" background="transparent"><view slot="left" class="trend-nav-back" bindtap="goBack"><view></view></view><text id="trend-nav-title" slot="center" class="trend-nav-title">单营养素趋势</text></navigation-bar>
<view class="page-shell">
 <view wx:if="{{reviewLabel}}" class="review">{{reviewLabel}}</view>
 <view class="detail-mode-row"><text class="trend-date">{{rangeLabel}}</text><period-mode-switch id="period-mode" appearance="prototype" active="TREND" disabled="{{loading || !dayReportId}}" bindchange="changePeriodMode"/></view>
 <view wx:if="{{loading}}" class="loading-card">正在整理逐日记录…</view>
 <view wx:if="{{errorMessage}}" class="card error">{{errorMessage}}<button class="button" bindtap="retry">重试</button></view>
 <block wx:elif="{{!loading}}">
  <view class="tabs"><view wx:for="{{categories}}" wx:key="key" id="nutrient-category-{{item.key}}" class="tab {{(showNutrientOptions?optionCategory:category)===item.key?'active':''}}" data-key="{{item.key}}" bindtap="selectCategory">{{item.name}}</view></view>
  <scroll-view wx:if="{{showNutrientOptions}}" id="nutrient-options" class="nutrient-options" scroll-x enhanced show-scrollbar="{{false}}"><view class="nutrient-options-row"><view wx:for="{{visibleOptions}}" wx:key="code" id="nutrient-choice-{{item.code}}" class="nutrient-option {{nutrientCode===item.code?'active':''}}" data-code="{{item.code}}" bindtap="selectNutrient">{{item.name}}</view></view></scroll-view>
  <view id="trend-chart-card" class="card chart-card">
   <view class="heading"><text id="selected-nutrient-title">{{name}}</text><text class="unit-label">单位 {{unitText}}</text></view>
   <view wx:if="{{hasAiValues}}" class="ai-source-legend"><text>资料计算</text><text>浅紫部分：AI估算</text></view><text class="scope-note">{{nutrientCode==='FAT_TOTAL' && unitText==='%'?'仅显示资料足够的记录供能比，不代表全天膳食结构。点击柱查看当天。':'仅显示记录中的可计算量，不代表全天摄入。点击柱查看当天数值。'}}</text>
   <view wx:if="{{lines.length > 1}}" class="range-reference-labels"><text wx:for="{{lines}}" wx:key="label">{{item.label}} {{item.valueText}} {{unitText}}</text></view>
   <view id="trend-chart" class="chart">
    <view id="chart-axis" class="axis {{wideAxis?'wide-axis':''}}"><text wx:for="{{axisLabels}}" wx:key="key" class="axis-label {{item.reference?'reference-value':''}} {{item.alternate?'alternate':''}}" style="bottom:{{item.bottom}}%">{{item.text}}</text></view>
    <view class="plot">
     <view wx:for="{{axisTicks}}" wx:key="key" class="grid-line" style="bottom:{{item.bottom}}%"><view class="axis-tick"></view></view>
     <view class="columns"><view wx:for="{{bars}}" wx:key="date" class="column" data-date="{{item.date}}" bindtap="selectDay"><text wx:if="{{item.value === null || item.valueText === '0'}}" class="bar-value">{{item.valueText}}</text><view class="bar {{item.tone}} {{item.date===selectedDate?'latest':''}}" style="height:{{item.height}}%"><view wx:if="{{item.hasAiValue}}" class="bar-ai-piece" style="height:{{item.aiPercent}}%"></view></view></view></view>
     <view wx:for="{{lines}}" wx:key="label" class="ref-line" style="bottom:{{item.bottom}}%"><text wx:if="{{lines.length === 1}}" class="ref-label">{{item.valueText}} {{unitText}} {{item.label}}</text></view>
    </view>
   </view>
   <view class="dates {{wideAxis?'wide-dates':''}}"><text wx:for="{{bars}}" wx:key="date" class="date-label {{item.date===selectedDate?'selected':''}}" data-date="{{item.date}}" bindtap="selectDay">{{item.label}}</text></view>
   <view class="comparison-note"><view class="calendar-icon"></view><text>{{comparisonSummary}}</text></view>
   <text id="trend-reference-source" class="reference-source">{{hasReference?'参考值来源：':''}}{{referenceText}}</text>
   <text wx:if="{{referenceRange}}" class="legend-note">{{rangeNote}}</text>
   <text wx:if="{{crossVersion}}" class="legend-note">逐日参考发生变化，已隐藏统一参考线。</text>
  </view>
  <view wx:if="{{dayPreview}}" id="trend-day-preview" class="card day-card">
   <view class="heading"><text>{{dayPreview.date}}</text><view wx:if="{{dayReportId}}" id="trend-open-single" class="day-link" bindtap="switchToDay">查看单日 <text>›</text></view></view>
   <view class="day-value-row"><text class="day-value-label">{{nutrientCode==='FAT_TOTAL' && unitText==='%'?'记录供能比':dayPreview.partial?'已知部分记录量':'已记录量'}}</text><view class="day-value {{!dayPreview.hasValue?'unavailable':''}}"><text>{{dayPreview.valueText}}</text><text wx:if="{{dayPreview.hasValue}}" class="day-unit">{{dayPreview.unitText||unitText}}</text></view></view>
  <view wx:if="{{dayPreview.hasAiValue}}" class="ai-day-source"><text>AI估算 {{dayPreview.aiAmountText}}</text><text wx:if="{{dayPreview.aiShareText}}">AI占本项参考合计 {{dayPreview.aiShareText}}</text></view><text wx:if="{{dayPreview.sourceAmountText}}" class="sub">{{dayPreview.sourceAmountText}}</text></view>
  <view class="report-disclosure"><view id="trend-report-toggle" class="disclosure-heading" bindtap="toggleReportNotes"><text>报告说明</text><text>{{showReportNotes?'−':'+'}}</text></view>
   <view wx:if="{{showReportNotes}}" id="trend-report-body" class="disclosure-body">
    <text class="sub">{{description}}</text><text wx:if="{{!informationalMode}}" class="sub">{{comparableDays}}天可比较 · {{excludedDays}}天排除（合计7天）</text><text wx:if="{{comparableDays}}" class="sub">其中低于参考值{{lowDays}}天，达到或超过参考值{{nonLowDays}}天。部分已知达到仅作限定解释。</text>
    <view id="chart-legend" class="chart-legend"><view class="legend-item"><view class="legend-swatch bar {{informationalMode?'information':'known'}}"></view><text>{{informationalMode?'可计算记录（仅供了解）':'可比较记录'}}</text></view><view class="legend-item"><view class="legend-swatch bar partial"></view><text>部分已知</text></view><view wx:if="{{!informationalMode}}" class="legend-item"><view class="legend-swatch bar uncertain"></view><text>资料有限（已知量）</text></view><view class="legend-item"><text class="legend-symbol">—</text><text>无可计算数值</text></view><view class="legend-item"><text class="legend-symbol">0</text><text>真实0值</text></view><view wx:if="{{lines.length}}" class="legend-item"><view class="legend-line"></view><text>一般参考线</text></view></view>
    <view id="trend-exclusions-toggle" class="exclusions-toggle" bindtap="toggleExclusions">{{showExclusions?'收起':'查看'}}排除日期与原因</view><view wx:if="{{showExclusions}}" wx:for="{{exclusions}}" wx:key="date" class="exclusion-row" data-report-id="{{item.reportId}}" bindtap="openDay"><text class="row-title">{{item.date}} ›</text><text>{{item.text}}</text></view>
   </view>
  </view>
 </block><view class="bottom-space"></view>
</view>
