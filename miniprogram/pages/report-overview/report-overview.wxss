@import "../../templates/nutrient-special-reference.wxss";
@import "../../styles/record-empty.wxss";
@import "../../styles/report-page-header.wxss";
@import "../../styles/report-controls.wxss";
page{background:linear-gradient(160deg,#fff8f2 0,#fffcf9 58%,#fffaf6 100%);color:#3d302a}
.page-shell{padding:18rpx 33rpx 190rpx;box-sizing:border-box}
.weekly-nav-back{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:50%;background:#fff;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045)}.weekly-nav-back>view{width:20rpx;height:20rpx;border-left:4rpx solid #3d302a;border-bottom:4rpx solid #3d302a;transform:rotate(45deg);margin-left:7rpx}.weekly-nav-title{font-size:34rpx;font-weight:600;white-space:nowrap}
.report-identity{gap:20rpx;margin-bottom:30rpx;padding:8rpx 4rpx;min-height:110rpx}.report-baby-avatar{width:80rpx;height:80rpx;border-width:6rpx}.report-baby-name{font-size:34rpx;font-weight:600;color:#3d302a}.report-baby-age{font-size:21rpx;color:#92847a;line-height:1.5}
.card{background:#fffefd;border:2rpx solid #f2eae3;border-radius:42rpx;margin:0 0 25rpx;padding:34rpx;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045);box-sizing:border-box}
.heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:25rpx;font-size:31rpx;line-height:1.4;font-weight:600}.sub,.scope-note{display:block;font-size:23rpx;line-height:1.75;color:#92847a;margin:12rpx 0;overflow-wrap:anywhere}.link{display:inline-flex;align-items:center;min-height:64rpx;font-size:21rpx;font-weight:400;color:#bb8d56}.trend-link{white-space:nowrap;flex:none;margin-left:8rpx;min-height:84rpx}.intro{display:block;font-size:23rpx;line-height:1.85;color:#978477;margin:-4rpx 0 32rpx}
.period-records-dates{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:24rpx;padding-bottom:19rpx;border-bottom:2rpx solid #f1e8e0}.period-records-dates .eyebrow{flex:1;min-width:0;line-height:1.5;color:#92847a;font-size:20rpx}.period-date-control{display:flex;align-items:center;justify-content:flex-end;min-height:64rpx;flex:none}.period-date-control .link{font-size:20rpx;white-space:nowrap}
/* This block preserves the user's existing count / seven date buttons / hint. */
.record-days-preserved{margin-left:-12rpx;margin-right:-12rpx;color:#332724}
.record-days-preserved .sub{display:block;color:#8a7d73;font-size:24rpx;line-height:1.6;margin:12rpx 0}.metric{font-size:58rpx;font-weight:700;color:#a87955}.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8rpx}.day{padding:14rpx 2rpx;text-align:center;border-radius:12rpx;background:#faf4ed;font-size:23rpx}.dot{display:block;color:#db9a75;font-size:22rpx}
.icon-heading{display:flex;align-items:center;gap:13rpx;min-width:0;flex:1}.weekly-bottle-icon,.weekly-bulb-icon{width:35rpx;height:35rpx;flex:none;background-position:center;background-repeat:no-repeat;background-size:contain}.weekly-bottle-icon{background-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjYmM5ODc3IiBzdHJva2Utd2lkdGg9IjEuNyIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNOSAyaDZ2NEg5eiBNOCA2aDhsMiA1djEwSDZWMTF6IE02IDEzaDUgTTYgMTdoNSIvPjwvc3ZnPg==")}.weekly-bulb-icon{background-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjYmM5ODc3IiBzdHJva2Utd2lkdGg9IjEuNyIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNOCAxNmE3IDcgMCAxIDEgOCAwbC0xIDNIOXogTTkgMjJoNiBNMTIgNHYyIi8+PC9zdmc+")}
.weekly-milk .heading{margin-bottom:13rpx}.weekly-milk-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx}.weekly-milk-metric{min-width:0;text-align:center}.weekly-milk-value{display:flex;align-items:baseline;justify-content:center;flex-wrap:wrap;gap:5rpx;font:600 46rpx/1.3 Arial,sans-serif;overflow-wrap:anywhere}.weekly-unit{font-size:20rpx;font-weight:400;white-space:nowrap}.weekly-milk-label{display:block;margin-top:12rpx;color:#92847a;font-size:21rpx;line-height:1.6}
.weekly-nutrient-entry{padding:27rpx 0;border-top:2rpx solid #f1e8e0}.weekly-nutrient-head{display:flex;align-items:center;gap:20rpx;min-height:62rpx}.weekly-nutrient-icon{width:62rpx;height:62rpx;flex:none}.weekly-nutrient-name{flex:1;min-width:0;font-size:27rpx;line-height:1.5;font-weight:600;overflow-wrap:anywhere}.weekly-chevron{flex:none;color:#c2ac98;font-size:36rpx;line-height:1}.weekly-nutrient-description{display:block;margin-top:17rpx;color:#92847a;font-size:20rpx;line-height:1.7;overflow-wrap:anywhere}.weekly-nutrient-progress{margin-top:19rpx}.weekly-progress-track{height:13rpx;border-radius:13rpx;overflow:hidden;background:#f4f0e9}.weekly-progress-fill{height:100%;border-radius:13rpx;background:#d4c9bc}.weekly-progress-fill.yellow{background:linear-gradient(90deg,#ffe3a6,#efbc65)}.weekly-progress-fill.green{background:linear-gradient(90deg,#bfd89b,#8ebf6f)}.weekly-progress-fill.red{background:linear-gradient(90deg,#f2aaa4,#e67b78)}.weekly-progress-caption{display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx;margin-top:11rpx;font-size:19rpx;line-height:1.6;color:#b0a18f}.weekly-progress-caption>text:last-child{flex:none;color:#978576}
.observation-controls{display:flex;gap:16rpx;margin-top:8rpx}.button{font-size:23rpx;line-height:1.6;color:#b69d89;background:transparent}.page-shell .text-control{min-height:84rpx;padding:12rpx 3rpx;font-size:23rpx;font-weight:400;line-height:1.6;background:transparent;color:#b69d89;border:0;white-space:normal}.text-control::after{border:0}.observation-controls .button{flex:1;min-width:0;margin:0}.mode-back{flex:none;margin:0}.mode-back-bottom{width:100%;margin:8rpx 0 0}.tabs{display:flex;flex-wrap:wrap;gap:10rpx;margin:12rpx 0}.tab{display:flex;align-items:center;min-height:84rpx;box-sizing:border-box;padding:12rpx 9rpx;font-size:23rpx;line-height:1.6;color:#b69d89;border-bottom:2rpx solid transparent}.tab.active{font-weight:600;color:#946e51;border-bottom-color:#d3ab77}
.weekly-knowledge{background:linear-gradient(130deg,#fff8e9,#fffdf6)}.knowledge-age{flex:none;max-width:38%;font-size:21rpx;font-weight:400;color:#92847a;line-height:1.5;text-align:right}.weekly-limitations{padding-top:24rpx;padding-bottom:24rpx}.weekly-limitations .heading{font-size:25rpx;margin-bottom:0;line-height:1.6}.weekly-limitations .link{min-height:84rpx;flex:none}.action-row{padding:20rpx 0;font-size:24rpx;line-height:1.7;border-bottom:2rpx solid #f1e8e0}.action-row:last-child{border:0}
.version-footer{padding:0 4rpx}.disclosure-heading{display:flex;align-items:center;justify-content:space-between;min-height:84rpx;border-bottom:2rpx solid #f1e8e0;color:#bb8d56;font-size:23rpx;line-height:1.6}.updated{display:block;font-size:20rpx;color:#a3978d;margin:18rpx 0}.metadata{overflow-wrap:anywhere}.review{font-size:23rpx;background:#fff0cc;color:#82600f;border-radius:14rpx;padding:14rpx 20rpx;margin-bottom:18rpx}.error{background:#fff1ed;color:#9c5344;font-size:23rpx;line-height:1.7}.error .button{background:#fff0e9}.error .link{display:block}
