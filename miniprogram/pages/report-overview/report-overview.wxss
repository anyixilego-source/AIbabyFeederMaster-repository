page { background: #fffaf7; color: #171722; }
.page-scroll { height: calc(100vh - 44px - env(safe-area-inset-top)); }
.page-shell { min-height: 100%; padding: 12rpx 28rpx 0; box-sizing: border-box; background: linear-gradient(180deg,#fffaf7 0%,#fff 62%); }
.trend-tab::after, .top-button::after { border: 0; }
.attention-card, .trend-card, .food-card, .error-card, .loading-card { position: relative; margin-top: 18rpx; padding: 28rpx; overflow: hidden; border: 1rpx solid #f1e8e3; border-radius: 30rpx; background: rgba(255,255,255,.97); box-shadow: 0 12rpx 30rpx rgba(90,65,51,.05); }
.error-card { color: #b3454a; background: #fff2f2; }
.loading-card { color: #858a99; text-align: center; }
.attention-card { min-height: 190rpx; box-sizing: border-box; background: linear-gradient(110deg,#fffaf5,#fff5e9); }
.attention-title { display: flex; align-items: center; gap: 18rpx; font-size: 34rpx; font-weight: 900; }
.attention-icon { width: 58rpx; height: 58rpx; border-radius: 29rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#ffad39,#ff7a18); }
.reminder-list { width: 100%; margin-top: 18rpx; display: flex; flex-direction: column; gap: 10rpx; }
.reminder-item { display: flex; align-items: flex-start; gap: 13rpx; color: #626879; font-size: 21rpx; line-height: 1.45; }
.reminder-item text { flex: 1; }
.reminder-dot { flex: 0 0 auto; width: 14rpx; height: 14rpx; margin-top: 9rpx; border-radius: 7rpx; background: #ff9f2f; }
.section-heading { display: flex; justify-content: space-between; align-items: center; font-size: 34rpx; font-weight: 900; }
.view-all { color: #73798a; font-size: 23rpx; font-weight: 500; }
.trend-tabs-scroll { margin-top: 24rpx; white-space: nowrap; }
.trend-tabs { min-width: max-content; display: flex; padding: 4rpx; border-radius: 31rpx; background: #f6f6f7; }
.trend-tab { flex: 0 0 112rpx; margin: 0; padding: 0 5rpx; height: 58rpx; line-height: 58rpx; border-radius: 29rpx; color: #697083; background: transparent; font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.trend-tab.active { color: #fff; background: linear-gradient(135deg,#3cb8f2,#3296ef); }
.chart-title { margin-top: 18rpx; color: #6f7585; font-size: 21rpx; }
.chart-area { height: 380rpx; margin-top: 12rpx; position: relative; border-bottom: 1rpx solid #dfe4e9; background-image: linear-gradient(to top, rgba(224,229,234,.7) 1rpx, transparent 1rpx); background-size: 100% 25%; }
.reference-line { position: absolute; left: 0; right: 0; z-index: 3; border-top: 2rpx dashed #ff7e26; }
.reference-line text { position: absolute; right: 0; bottom: 8rpx; padding-left: 9rpx; color: #ff7420; background: rgba(255,255,255,.92); font-size: 20rpx; }
.no-reference { position: absolute; right: 0; top: 8rpx; color: #9297a3; font-size: 20rpx; }
.bars { position: absolute; left: 0; right: 0; top: 38rpx; bottom: 0; display: flex; align-items: flex-end; justify-content: space-around; }
.bar-column { height: 100%; width: 12%; position: relative; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; }
.bar { width: 46rpx; min-height: 0; border-radius: 10rpx 10rpx 0 0; background: linear-gradient(180deg,#a7ddf8,#d5effc); }
.bar.current { background: linear-gradient(180deg,#2ca8f2,#188ee6); }
.bar.empty { height: 2rpx !important; background: #dfe4e8; }
.bar-value { position: absolute; margin-bottom: 44rpx; color: #1d2330; font-size: 18rpx; font-weight: 700; }
.bar-value.missing { color: #a1a6b0; }
.bar-label { height: 42rpx; padding-top: 9rpx; color: #596073; font-size: 19rpx; }
.trend-note { margin-top: 26rpx; padding: 18rpx; display: flex; gap: 15rpx; align-items: center; color: #1d64ad; background: #eaf7ff; border-radius: 20rpx; font-size: 21rpx; line-height: 1.5; }
.trend-note > text { flex: 1; }
.sprite-icon { position: relative; flex: 0 0 auto; width: 66rpx; height: 60rpx; overflow: hidden; }
.sprite-sheet { position: absolute; width: 400%; height: 300%; }
.sprite-bulb { left: -300%; top: 0; }
.food-card { margin-bottom: 30rpx; }
.food-grid { margin-top: 24rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 22rpx 16rpx; }
.food-item { display: flex; flex-direction: column; align-items: center; }
.food-picture { width: 100%; height: 126rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; color: #3e79a1; background: #edf8ff; font-size: 45rpx; font-weight: 900; }
.food-picture.green { color: #28895c; background: #eaf8ef; }
.food-picture.orange { color: #c77b22; background: #fff3df; }
.food-picture.purple { color: #7560b3; background: #f2edff; }
.food-picture.cyan { color: #218ea1; background: #e7f8fb; }
.food-picture.yellow { color: #b38b1d; background: #fff9d9; }
.food-name { margin-top: 9rpx; font-size: 24rpx; font-weight: 800; text-align: center; }
.food-amount { margin-top: 3rpx; color: #6f7585; font-size: 21rpx; }
.food-empty { padding: 60rpx 0 30rpx; color: #8b909d; text-align: center; font-size: 24rpx; }
.top-button { width: 330rpx; height: 72rpx; margin: 30rpx auto 0; line-height: 72rpx; border-radius: 36rpx; color: #fff; background: linear-gradient(135deg,#ff7179,#ff5762); font-size: 28rpx; font-weight: 800; }
.bottom-space { height: 30rpx; }
