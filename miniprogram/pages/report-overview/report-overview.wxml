<import src="../../templates/nutrient-card.wxml"/>
<navigation-bar title="近7日饮食记录解读" back="{{false}}" color="#332724" background="transparent"><view slot="left" class="nav-back" bindtap="goBack">‹</view></navigation-bar>
<view class="page-shell"><view wx:if="{{reviewLabel}}" class="review">{{reviewLabel}} · 非真实营养验收</view><view bindtap="openCalendar"><view class="heading">{{babyName}}<text class="link">截至 {{endDate}} ▾</text></view></view><text class="scope-note">只解读已保存并确认的记录，未记录食物不计入；不代表全天营养状况。</text>
<view wx:if="{{loading}}" class="scope-note">{{hasResult?'正在更新，暂展示原修订':'正在整理近7日记录…'}}</view><view wx:if="{{errorMessage}}" class="card error">{{errorMessage}}<button class="button" bindtap="refresh">重试</button><text class="link" bindtap="viewRecords">查看记录</text></view>
<block wx:if="{{hasResult}}"><view class="card"><text class="eyebrow">{{startDate}} — {{endDate}}</text><text id="nutrition-records-title" class="headline">营养记录</text><text wx:if="{{title && title !== '这些记录值得留意'}}" class="sub">{{title}}</text><text class="metric">{{recordedDays}}<text class="sub" style="display:inline"> / 7 天有确认记录</text></text><text class="sub">每项分别统计可比较日；记录天数不代表全天记全。</text><view class="grid"><view wx:for="{{dates}}" wx:key="date" class="day" data-report-id="{{item.reportId}}" bindtap="openDay">{{item.label}}<text class="dot">{{item.recorded?'●':'○'}}</text></view></view><text class="sub">点选日期查看当天记录与解读。</text><view wx:if="{{milkLine}}" class="period-milk"><view class="period-milk-heading"><text>近7日奶量</text><text class="link trend-link" bindtap="openMilkTrend">查看趋势 ›</text></view><view class="period-milk-metrics"><view><text class="sub">已知量合计</text><text class="period-milk-number">{{milkTotal}}<text wx:if="{{milkKnownDays}}" class="period-milk-unit"> 毫升</text></text></view><view><text class="sub">日均已知量</text><text class="period-milk-number">{{milkAverage}}<text wx:if="{{milkKnownDays}}" class="period-milk-unit"> 毫升</text></text></view></view><text class="sub">{{milkKnownDays?'日均按'+milkKnownDays+'天有量记录计算':'暂无可计算日均的已知奶量'}}{{milkUnknownCount?'，另有'+milkUnknownCount+'次未记录奶量':''}}。</text></view></view>
<view id="observations-card" class="card observation-card"><block wx:if="{{showAll}}"><view class="heading">全部13项营养素<button id="back-to-observations" class="button mode-back" bindtap="returnToObservations">返回营养解读</button></view><view class="tabs"><view wx:for="{{categories}}" wx:key="key" class="tab {{category===item.key?'active':''}}" data-key="{{item.key}}" bindtap="selectCategory">{{item.name}}</view></view><view class="nutrient-entry" wx:for="{{nutrients}}" wx:key="nutrientCode" data-code="{{item.nutrientCode}}" bindtap="openTrend"><template is="nutrient-card" data="{{item}}"/></view><button id="back-to-observations-bottom" class="button mode-back-bottom" bindtap="returnToObservations">返回营养解读</button></block><block wx:else><view id="observations-title" class="heading">营养记录解读</view><text class="sub">仅纳入至少有1天能与适用参考比较的营养素；统计低于及达到／超过参考值的天数。</text><view class="nutrient-entry" wx:for="{{observationCards}}" wx:key="id" data-code="{{item.nutrientCode}}" bindtap="openTrend"><template is="nutrient-card" data="{{item}}"/></view><text wx:if="{{!observations.length}}" class="sub">暂无可展示的营养记录解读，可查看全部营养素的记录状态。</text><view class="observation-controls"><button wx:if="{{observations.length>3}}" id="toggle-observations" class="button" bindtap="toggleObservations">{{showObservations?'收起':'全部解读'}}</button><button id="show-all-nutrients" class="button" bindtap="openAllNutrients">全部13项营养素</button></view></block></view>
<view wx:if="{{actions.length}}" class="card"><view class="heading">接下来可以做</view><view wx:for="{{actions}}" wx:key="id" class="row" bindtap="startMeal">{{item.text}} ›</view></view>
<diet-recommendation id="diet-recommendation" subject-id="{{subjectId}}" report-date="{{endDate}}"/>
<view wx:if="{{knowledge.length}}" id="knowledge-card" class="card" bindtap="toggleKnowledge" aria-role="button" aria-label="{{knowledge.length>1 ? (showKnowledgeSources ? '收起适龄提示' : showKnowledge ? '查看知识来源' : '展开适龄提示') : (showKnowledgeSources ? '收起知识来源' : '查看知识来源')}}"><view class="heading">适龄饮食提示</view><text class="sub">按所选结束日 {{knowledgeAgeDate}} 的月龄展示。</text><view wx:for="{{visibleKnowledge}}" wx:key="id" class="row"><text class="knowledge-title">{{item.title}}</text>{{item.text}}<text wx:if="{{showKnowledgeSources}}" wx:for="{{item.evidence}}" wx:for-item="source" wx:key="id" class="source">中国居民膳食指南（2022） · {{source.bookPages}}页</text></view></view>
<view wx:if="{{recordedDays && limitationCount}}" id="nutrient-limitations" class="card" bindtap="advanceLimitations" aria-role="button" aria-label="切换营养素说明详情"><view class="heading">{{limitationCount}}项营养素有说明或限制<text id="toggle-nutrient-limitations" class="link" catchtap="toggleLimitations">{{showLimitations?'收起':'查看'}}</text></view><text wx:if="{{showLimitations}}" wx:for="{{limitations}}" wx:key="nutrientCode" class="sub">{{item.text}}{{showLimitationReasons ? ' ' + item.reasonText : ''}}</text></view>
<text class="updated">更新于 {{generatedAt}} · <text bindtap="refresh">更新记录</text></text><view class="sub" bindtap="toggleVersion">报告说明 {{showVersion?'收起':'查看'}}</view><view wx:if="{{showVersion}}" class="metadata">仅对照窗口内已确认记录，不代表全天营养充足或医学判断。<text wx:if="{{knowledgeScope}}" class="sub report-knowledge-scope">{{knowledgeScope}}</text></view></block></view><app-tabbar id="main-tabbar" active="report" showCamera="{{true}}"></app-tabbar>
<date-calendar id="date-selector" visible="{{showCalendar}}" selected="{{endDate}}" max-date="{{today}}" title="选择近7日截至日期" bindchange="changeDate" bindclose="closeCalendar"/>
