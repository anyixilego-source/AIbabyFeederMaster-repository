<import src="../../templates/record-empty.wxml"/>
<wxs module="weeklyVisual">
function dateLabel(d) { d=d||''; if(d.length!==10 || d.charAt(4)!=='-' || d.charAt(7)!=='-') return d; return (+d.slice(5,7))+'月'+(+d.slice(8,10))+'日'; }
function color(item) { if (!item.showProgress) return 'neutral'; var p=item.progressPercent; return p < 30 ? 'red' : p < 70 ? 'yellow' : 'green'; }
function description(item) { if(item.showProgress) return item.comparableDays+'个可比较日中，'+item.nonLowDays+'日记录量未低于参考值。'; return item.statusText || ''; }
module.exports={color:color,dateLabel:dateLabel,description:description};
</wxs>
<template name="weekly-nutrient">
 <view class="weekly-nutrient-head"><image class="weekly-nutrient-icon" src="{{item.iconPath}}" mode="aspectFit"/><text class="weekly-nutrient-name">{{item.name}}</text><text class="weekly-chevron">›</text></view>
 <text wx:if="{{weeklyVisual.description(item)}}" class="weekly-nutrient-description">{{weeklyVisual.description(item)}}</text>
 <view wx:if="{{item.showProgress}}" class="weekly-nutrient-progress"><view class="weekly-progress-track"><view class="weekly-progress-fill {{weeklyVisual.color(item)}}" style="width:{{item.progressPercent}}%"></view></view><view class="weekly-progress-caption"><text>未低于参考值的天数</text><text>{{item.nonLowDays}} / {{item.comparableDays}}日</text></view></view>
 <text wx:if="{{item.sourceText}}" class="weekly-nutrient-description">主要来源：{{item.sourceText}}</text><text wx:if="{{item.dataNote}}" class="weekly-nutrient-description">{{item.dataNote}}</text>
</template>
<navigation-bar back="{{false}}" color="#3d302a" background="transparent"><view slot="left" class="weekly-nav-back" bindtap="goBack"><view></view></view><text slot="center" class="weekly-nav-title">近7日饮食报告</text></navigation-bar>
<view class="page-shell">
 <view wx:if="{{reviewLabel}}" class="review">{{reviewLabel}} · 非真实营养验收</view>
 <view id="report-baby-header" class="report-identity"><image class="report-baby-avatar" src="/assets/baby-avatar-v2.jpg" mode="aspectFill"/><view class="report-baby-copy"><text class="report-baby-name">{{babyName}}</text><text class="report-baby-age">{{ageText}}</text></view><view class="report-switch-slot"><period-mode-switch id="report-period-mode" appearance="prototype" active="TREND" day-label="每日" trend-label="近7日" disabled="{{loading}}" bindchange="changePeriodMode"/></view></view>
 <view wx:if="{{loading}}" class="scope-note">{{hasResult?'正在更新，暂展示原修订':'正在整理近7日记录…'}}</view><view wx:if="{{errorMessage}}" class="card error">{{errorMessage}}<button class="button" bindtap="refresh">重试</button><text class="link" bindtap="viewRecords">查看记录</text></view>
 <block wx:if="{{hasResult}}">
 <view id="nutrition-records-card" class="card"><view class="heading"><text id="nutrition-records-title">营养记录</text></view><view class="period-records-dates"><text class="eyebrow">{{weeklyVisual.dateLabel(startDate)}} — {{weeklyVisual.dateLabel(endDate)}}</text><view id="period-end-date" class="period-date-control" bindtap="openCalendar" role="button" aria-label="选择报告截至日期"><text class="link">截至{{weeklyVisual.dateLabel(endDate)}} ▾</text></view></view><text wx:if="{{title && title !== '这些记录值得留意'}}" class="sub">{{title}}</text><view id="record-days-preserved" class="record-days-preserved"><text class="metric">{{recordedDays}}<text class="sub" style="display:inline"> / 7 天有确认记录</text></text><view class="grid"><view wx:for="{{dates}}" wx:key="date" class="day" data-report-id="{{item.reportId}}" bindtap="openDay">{{item.label}}<text class="dot">{{item.recorded?'●':'○'}}</text></view></view><text class="sub">点选日期查看当天记录与解读。</text></view></view>
 <view wx:if="{{!loading && !errorMessage && emptyRecordSnapshot && !recordedDays && !milkLine}}" class="weekly-empty-guide"><template is="record-empty"/></view>
 <block wx:else>
 <view wx:if="{{milkLine}}" id="weekly-milk-card" class="card weekly-milk"><view class="heading"><view class="icon-heading"><view class="weekly-bottle-icon"></view><text>近7日奶量</text></view><text class="link trend-link" bindtap="openMilkTrend">查看趋势 ›</text></view><view class="weekly-milk-metrics"><view class="weekly-milk-metric"><view class="weekly-milk-value"><text>{{milkTotal}}</text><text wx:if="{{milkKnownDays}}" class="weekly-unit">ml</text></view><text class="weekly-milk-label">已知奶量总计</text></view><view class="weekly-milk-metric"><view class="weekly-milk-value"><text>{{milkAverage}}</text><text wx:if="{{milkKnownDays}}" class="weekly-unit">ml / 日</text></view><text class="weekly-milk-label">{{milkKnownDays?'按'+milkKnownDays+'日平均':'暂无有量日'}}</text></view></view></view>
 <view id="observations-card" class="card observation-card"><block wx:if="{{showAll}}"><view class="heading"><text>全部13项营养素</text><button id="back-to-observations" class="button text-control mode-back" bindtap="returnToObservations">返回记录解读</button></view><view class="tabs"><view wx:for="{{categories}}" wx:key="key" class="tab {{category===item.key?'active':''}}" data-key="{{item.key}}" bindtap="selectCategory">{{item.name}}</view></view><view class="weekly-nutrient-entry" wx:for="{{nutrients}}" wx:key="nutrientCode" data-code="{{item.nutrientCode}}" bindtap="openTrend" aria-role="button" aria-label="{{item.name}}趋势"><template is="weekly-nutrient" data="{{item,weeklyVisual}}"/></view><button id="back-to-observations-bottom" class="button text-control mode-back-bottom" bindtap="returnToObservations">返回记录解读</button></block><block wx:else><view id="observations-title" class="heading">记录解读</view><text wx:if="{{interpretationText}}" id="weekly-interpretation-summary" class="intro">{{interpretationText}}</text><view class="weekly-nutrient-entry" wx:for="{{observationCards}}" wx:key="id" data-code="{{item.nutrientCode}}" bindtap="openTrend" aria-role="button" aria-label="{{item.name}}趋势"><template is="weekly-nutrient" data="{{item,weeklyVisual}}"/></view><text wx:if="{{!observations.length}}" class="sub">暂无可展示的记录解读，可查看全部营养素的记录状态。</text><view class="observation-controls"><button wx:if="{{observations.length>3}}" id="toggle-observations" class="button text-control" bindtap="toggleObservations">{{showObservations?'收起':'全部解读'}}</button><button id="show-all-nutrients" class="button text-control" bindtap="openAllNutrients">全部13项营养素</button></view></block></view>
 <view wx:if="{{actions.length}}" class="card"><view class="heading">接下来可以做</view><view wx:for="{{actions}}" wx:key="id" class="action-row" bindtap="startMeal">{{item.text}} ›</view></view>
 <diet-recommendation id="diet-recommendation" subject-id="{{subjectId}}" report-date="{{endDate}}"/>
 <view wx:if="{{knowledge.length}}" id="knowledge-card" class="card weekly-knowledge"><view class="heading"><view class="icon-heading"><view class="weekly-bulb-icon"></view><text>适龄饮食提示</text></view><text wx:if="{{knowledgeAgeText}}" id="knowledge-age" class="knowledge-age">适龄：{{knowledgeAgeText}}</text></view><knowledge-carousel id="knowledge-carousel" appearance="daily" items="{{knowledge}}"/></view>
 <view wx:if="{{recordedDays && limitationCount}}" id="nutrient-limitations" class="card weekly-limitations" bindtap="advanceLimitations" aria-role="button" aria-label="切换营养素说明详情"><view class="heading"><text>{{limitationCount}}项营养素有说明或限制</text><text id="toggle-nutrient-limitations" class="link" catchtap="toggleLimitations">{{showLimitations?'收起':'查看'}}</text></view><text wx:if="{{showLimitations}}" wx:for="{{limitations}}" wx:key="nutrientCode" class="sub">{{item.text}}{{showLimitationReasons ? ' ' + item.reasonText : ''}}</text></view>
 </block>
 <view class="version-footer"><view id="weekly-report-disclosure" class="disclosure-heading" bindtap="toggleVersion"><text>报告说明</text><text>{{showVersion?'−':'+'}}</text></view><view wx:if="{{showVersion}}" class="metadata"><text class="updated">更新于 {{generatedAt}} · <text bindtap="refresh">更新记录</text></text><text class="sub">仅纳入至少有1天能与适用参考比较的营养素；统计低于及达到／超过参考值的天数。</text><text class="sub">“均达标”仅用于5项重点营养素在7个完整可比较记录日的参考比较，不代表全天营养充足或整体饮食均衡。</text><text class="sub">仅对照窗口内已确认记录，不代表全天营养充足或医学判断。</text><text id="period-record-scope" class="sub">只解读已保存并确认的记录，未记录食物不计入；不代表全天营养状况。</text><text id="period-comparison-scope" class="sub">每项分别统计可比较日；记录天数不代表全天记全。条形比例按未低于参考值日／可比较日展示；低于30%红色、30%至不足70%黄色、70%及以上绿色，仅作页面分段。</text><text wx:if="{{milkLine}}" class="sub">{{milkKnownDays?'奶量平均按'+milkKnownDays+'天有量记录计算':'暂无有量日，无法计算奶量日均'}}{{milkUnknownCount?'，另有'+milkUnknownCount+'次未记录奶量':''}}。未知体积不作为0毫升，奶量尚未计入营养计算。</text><text wx:if="{{knowledgeScope}}" class="sub report-knowledge-scope">{{knowledgeScope}}</text></view></view>
 </block>
</view><app-tabbar id="main-tabbar" active="report" showCamera="{{true}}"></app-tabbar>
<date-calendar id="date-selector" visible="{{showCalendar}}" selected="{{endDate}}" max-date="{{today}}" title="选择近7日截至日期" bindchange="changeDate" bindclose="closeCalendar"/>
