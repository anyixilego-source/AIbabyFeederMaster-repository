<template name="nutrient-card"><view class="nutrient-row"><view class="nutrient-badge neutral"><image class="report-icon" src="{{item.iconPath}}" mode="aspectFit"/></view><view class="nutrient-main"><view class="nutrient-line"><text class="nutrient-name">{{item.name}}</text><view wx:if="{{item.amountText && !item.hideAmount}}" class="nutrient-amount"><text class="amount-value">{{item.amountText}}</text><text wx:if="{{item.numericValue !== null && item.numericValue !== undefined && item.unitText}}" class="amount-unit">{{item.unitText}}</text></view></view><text class="source-text interpretation-text">{{item.statusText}}</text><view wx:if="{{item.showProgress}}" class="nutrient-progress"><view class="nutrient-progress-track"><view class="nutrient-progress-fill {{item.progressTone}}" style="width:{{item.progressPercent}}%"></view></view><text>{{item.progressLabel}}</text></view><text wx:if="{{item.sourceText}}" class="source-text">主要来源：{{item.sourceText}}</text><text wx:if="{{item.dataNote}}" class="data-note">{{item.dataNote}}</text></view><text class="row-chevron">›</text></view></template>
