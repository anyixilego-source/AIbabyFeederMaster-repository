<template name="nutrient-special-reference"><view wx:if="{{special}}" class="special-reference {{compact?'compact':''}}">
 <block wx:if="{{special.kind==='FAT_ENERGY_SHARE'}}"><text wx:if="{{compact && special.available}}" class="special-compact-ratio">记录供能比 {{special.ratioText}}%</text><text wx:elif="{{special.summaryText}}" class="special-note">{{special.summaryText}}</text><text wx:elif="{{!special.available}}" class="special-note">{{special.reasonText}}</text>
 <view wx:if="{{!compact && special.available}}" class="special-ruler"><view class="special-track"><view wx:if="{{special.hasRange}}" class="special-band" style="left:{{special.rangeStartPercent}}%;width:{{special.rangeWidthPercent}}%"></view><view wx:else class="special-point" style="left:{{special.pointPercent}}%"></view><view class="special-marker" style="left:{{special.markerPercent}}%"><text class="special-marker-label {{special.markerPercent>85?'at-end':special.markerPercent<15?'at-start':''}}">记录供能比</text></view></view><view class="special-axis"><text>0%</text><text>{{special.scaleMaxText}}%</text></view></view>
 </block>
 <view wx:if="{{(!compact && special.available) || special.kind==='SODIUM_INFORMATION'}}"><view wx:for="{{special.rows}}" wx:key="type" class="special-reference-row"><text>{{item.label}}</text><text>{{item.valueText}}</text></view></view><text wx:if="{{!compact && (special.available || special.kind==='SODIUM_INFORMATION')}}" class="special-note">{{special.scopeText}}</text>
</view></template>
