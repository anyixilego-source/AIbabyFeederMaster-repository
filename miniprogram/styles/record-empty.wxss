.record-empty-card{box-sizing:border-box;margin:0 0 25rpx;padding:92rpx 52rpx 98rpx;border:2rpx solid #f1e8e0;border-radius:42rpx;background:#fffefd;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045);text-align:center;color:#3d302a}.record-empty-picture{position:relative;display:block;width:240rpx;height:250rpx;max-width:100%;margin:0 auto 38rpx;border-radius:50%;overflow:hidden}.record-empty-picture-content{position:absolute;left:0;top:calc(50% + 10px);transform:translateY(-50%);display:block;width:100%}.record-empty-title{display:block;font-size:33rpx;line-height:1.5;font-weight:600;margin-bottom:20rpx}.record-empty-copy{display:block;white-space:pre-line;font-size:23rpx;line-height:1.8;color:#a48f7c}.record-empty-card button.record-empty-photo{box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:18rpx;width:100%;min-height:92rpx;margin:44rpx 0 0;padding:20rpx 16rpx;border:0;border-radius:33rpx;background:linear-gradient(110deg,#ff8a7e,#ff7577);box-shadow:0 12rpx 36rpx rgba(255,123,118,.12);color:#fff;font-size:29rpx;font-weight:600;line-height:1.5}.record-empty-card button.record-empty-manual{display:flex;align-items:center;justify-content:center;width:100%;min-height:76rpx;margin:12rpx 0 0;padding:13rpx 0;border:0;background:transparent;color:#b49a82;font-size:23rpx;font-weight:400;line-height:1.5}.record-empty-photo::after,.record-empty-manual::after{border:0}.record-empty-camera{position:relative;flex:none;width:30rpx;height:24rpx;border:3rpx solid currentColor;border-radius:4rpx;box-sizing:border-box}.record-empty-camera::before{content:'';position:absolute;top:4rpx;left:7rpx;width:10rpx;height:10rpx;border:3rpx solid currentColor;border-radius:50%;box-sizing:border-box}.record-empty-camera::after{content:'';position:absolute;left:6rpx;top:-8rpx;width:12rpx;height:6rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:3rpx 3rpx 0 0;box-sizing:border-box}
