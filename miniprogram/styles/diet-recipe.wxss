/* Approved recipe board 22. Scoped to recipe details, including saved recipe details. */
.recipe-shell{padding:24rpx 33rpx 60rpx;padding-bottom:calc(40rpx + env(safe-area-inset-bottom));color:#3d302a}.recipe-shell .recipe-heading{align-items:center;gap:18rpx;margin:5rpx 0 30rpx}.recipe-shell .recipe-plan-title{font-size:27rpx;font-weight:600;line-height:1.5}.recipe-shell .recipe-range{font-size:21rpx;color:#92847a;line-height:1.6;margin-top:8rpx}
.recipe-shell .recipe-hero{margin:0 0 25rpx;height:auto;min-height:430rpx;border:0;border-radius:44rpx;background:#fff0e8;overflow:hidden}.recipe-shell .recipe-hero .hero-photo{width:62%;height:100%;right:0;top:0}.recipe-shell .hero-shade{right:auto;width:44.2%;background:linear-gradient(90deg,#fff5e8 0%,#fff5e8 85.97285%,rgba(255,245,232,0) 100%);pointer-events:none}.recipe-shell .hero-copy{width:42%;min-height:430rpx;padding:46rpx 10rpx 23rpx 34rpx;overflow:visible;pointer-events:none}.recipe-shell .hero-name{font-size:40rpx;font-weight:600;line-height:1.4;max-width:4.8em;color:#3d302a;overflow-wrap:anywhere}.recipe-shell .hero-intro{display:block;-webkit-line-clamp:unset;overflow:visible;font-size:21rpx;line-height:1.8;color:#a39382;margin:27rpx 0 30rpx;overflow-wrap:anywhere}.recipe-shell .hero-meta{display:flex;align-items:center;gap:8rpx;font-size:19rpx;line-height:1.5;color:#b69063;background:#fffaf2;border-radius:14rpx;padding:6rpx 12rpx;margin-top:8rpx;max-width:100%;box-sizing:border-box}.recipe-shell .hero-meta .recipe-ui-icon{width:28rpx;height:28rpx}.recipe-shell .hero-meta text{min-width:0;overflow-wrap:anywhere}
.recipe-shell .recipe-hero .hero-placeholder{width:56%;border-radius:0;z-index:3;background:rgba(255,240,232,.96);padding:24rpx 16rpx}.recipe-shell .hero-placeholder-title{font-size:23rpx;color:#a39382}.recipe-shell .hero-placeholder .note{font-size:21rpx;color:#a39382;line-height:1.7}.recipe-shell .hero-placeholder button{font-size:21rpx;border-radius:22rpx;background:#fff7ef;color:#b88b64}.recipe-shell .hero-expand{top:16rpx;right:16rpx;width:56rpx;height:56rpx;border-radius:20rpx;background:rgba(255,255,255,.7)}.recipe-shell .hero-expand-icon{width:32rpx;height:32rpx}.recipe-shell .hero-image-actions{right:6rpx;bottom:8rpx;gap:0}.recipe-shell .hero-image-action{width:80rpx;min-width:80rpx;min-height:76rpx;padding:7rpx}.recipe-shell .hero-like-action{min-height:84rpx;gap:4rpx}.recipe-shell .hero-collection-icon{width:49rpx;height:35rpx}.recipe-shell .hero-like-icon{width:40rpx;height:40rpx}.recipe-shell .hero-like-count{font-size:20rpx;line-height:24rpx;color:#a8917b}.recipe-shell .hero-like-count.is-liked{color:#e96d4b}
.recipe-shell .recipe-card{margin:25rpx 0;padding:34rpx;border:2rpx solid #f2eae3;border-radius:42rpx;background:#fffefd;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045);box-sizing:border-box}.recipe-shell .recipe-section-heading{gap:14rpx;margin-bottom:22rpx;align-items:center}.recipe-shell .recipe-section-title{font-size:31rpx;line-height:1.5;font-weight:600;color:#3d302a}.recipe-shell .recipe-serving{font-size:21rpx;line-height:1.6;color:#b1a08d;max-width:34%;overflow-wrap:anywhere}.recipe-shell .recipe-section-heading .recipe-ui-icon{width:32rpx;height:32rpx}.recipe-shell .icon-basket{background-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjYmM5ODc3IiBzdHJva2Utd2lkdGg9IjEuNyIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNMjAgM0MzIDEgMiAxMiA3IDE3czE1LTEgMTMtMTR6IE00IDIyIDE3IDciLz48L3N2Zz4=")}.recipe-shell .icon-chef{background-image:url("data:image/svg+xml;base64,")}
.recipe-shell .recipe-ingredient{font-size:25rpx;line-height:1.7;padding:17rpx 0;gap:24rpx;border-bottom:2rpx solid #f1e8e0;align-items:flex-start}.recipe-shell .recipe-ingredient:last-child{border:0;padding-bottom:0}.recipe-shell .recipe-ingredient-name{color:#66584b;overflow-wrap:anywhere}.recipe-shell .recipe-ingredient-amount{font-size:25rpx;color:#b09b83;max-width:48%;overflow-wrap:anywhere}.recipe-shell .recipe-step{font-size:23rpx;line-height:1.8;color:#92847a;gap:8rpx;margin-top:17rpx}.recipe-shell .recipe-step-number{flex:none}.recipe-shell .recipe-step-copy{overflow-wrap:anywhere}.recipe-shell .recipe-supplement{font-size:21rpx;line-height:1.8;color:#b4a391;margin-top:29rpx;overflow-wrap:anywhere}
.recipe-shell .recipe-return{min-height:92rpx;box-sizing:border-box;border-radius:33rpx;background:#fff0e9;color:#bd805c;margin-top:25rpx;padding:20rpx 22rpx;gap:21rpx;font-size:29rpx;font-weight:600;line-height:1.5}.recipe-shell .recipe-return-arrow{font-size:34rpx;font-weight:400}.recipe-shell .recipe-function-info{padding:0 4rpx;margin-top:15rpx}.recipe-shell .recipe-function-info-toggle{justify-content:space-between;min-height:91rpx;gap:16rpx;border-bottom:2rpx solid #f1e8e0;color:#bb956b;font-size:23rpx;line-height:1.6}.recipe-shell .recipe-function-info .risk{font-size:21rpx;color:#92847a;line-height:1.75;margin-top:18rpx;overflow-wrap:anywhere}

/* Only the photo is interactive; recipe copy blocks taps from reaching the image below. */
.recipe-shell .hero-copy{pointer-events:auto}
