ckground:#fff;box-shadow:0 10rpx 46rpx rgba(136,91,57,.045)}.my-nav>view{width:20rpx;height:20rpx;border-left:4rpx solid #3d302a;border-bottom:4rpx solid #3d302a;transform:rotate(45deg);margin-left:7rpx}.my-primary,.my-secondary{width:100%;min-height:92rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border-radius:33rpx;margin:25rpx 0;padding:20rpx 22rpx;font-size:29rpx;font-weight:600;line-height:1.5;white-space:normal}.my-primary{background:linear-gradient(110deg,#ff8a7e,#ff7577);color:white;box-shadow:0 12rpx 36rpx rgba(255,123,118,.12)}.my-secondary{background:#fff0e9;color:#bd805c}.my-primary::after,.my-secondary::after,button::after{border:0}.my-primary[disabled],.my-secondary[disabled]{opacity:.55}.my-state{font-size:23rpx;line-height:1.8;text-align:center;color:#92847a;padding:30rpx 15rpx}.my-error{background:#fff0e9;color:#b5665d;border-radius:25rpx;padding:22rpx;margin-bottom:25rpx;font-size:23rpx;line-height:1.8;overflow-wrap:anywhere}.my-disclosure{margin:20rpx 0 0;padding:0 4rpx}.my-disclosure-toggle{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:91rpx;border-bottom:2rpx solid #f1e8e0;font-size:23rpx;line-height:1.6;color:#bc956b}.my-disclosure-body{padding:20rpx 0}.my-disclosure-body>text{display:block;margin-bottom:16rpx}.my-field{margin-top:25rpx}.my-field-label{display:block;font-size:23rpx;color:#7b6a5b;font-weight:600;line-height:1.6;margin-bottom:14rpx}.my-input,.my-picker{display:block;width:100%;min-height:86rpx;box-sizing:border-box;padding:22rpx 24rpx;border:2rpx solid #eee0d4;border-radius:23rpx;background:#fffdfa;font-size:25rpx;color:#3d302a;line-height:1.6}.my-input{height:86rpx}.my-field .my-sub{font-size:21rpx}.my-choices{display:flex;gap:16rpx}.my-choice{flex:1;min-width:0;min-height:78rpx;margin:0;padding:16rpx 8rpx;background:#faf4ee;border:2rpx solid #eee0d4;border-radius:23rpx;color:#3d302a;font-size:25rpx;line-height:1.5}.my-choice.active{background:#ffede3;border